app PILOT154449 (
    name: Demonstration - HR
    logo {
        type: text
        text: Demonstration - HR
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        scheme: @reader-rights
    }
    security {
        allowBotAccess: true
        runtimeApiUsage: modifyThisApp
    }
    globalization {
        documentDirection: leftToRight
    }
    progressiveWebApp {
        installable: true
        enablePushNotifications: true
        pushNotificationsCredentials: @App_154449_Push_Notifications_Credentials
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 21.2
    }
    advanced {
        modernizeApp: true
    }

    substitution APP_NAME (
        value {
            staticValue: Demonstration - HR
        }
    )

    appSetting ACCESS_CONTROL_SCOPE (
        value {
            staticValue: ACL_ONLY
            onUpgradeKeepValue: true
        }
        validation {
            validValues: ACL_ONLY, ALL_USERS
        }
        config {
            buildOption: @feature-access-control
        }
        comments {
            comments: The default access level given to authenticated users who are not in the access control list
        }
    )

    appSetting FEEDBACK_ATTACHMENTS_YN (
        value {
            staticValue: Y
            onUpgradeKeepValue: true
        }
        validation {
            validValues: Y, N
        }
        config {
            buildOption: @feature-feedback
        }
    )

)

