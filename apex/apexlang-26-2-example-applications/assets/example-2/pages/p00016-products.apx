page 16 (
    name: Products
    alias: PRODUCTS
    title: Products
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    security {
        authorizationScheme: @administration-rights
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region product-information (
        name: Product Information
        type: interactiveReport
        source {
            location: localDatabase
            tableName: OEHR_PRODUCT_INFORMATION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        link {
            linkColumn: customTarget
            target: {
                page: 17
                items: {
                    P17_PRODUCT_ID: \#PRODUCT_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 6202180122418443083
        }

        column CATALOG_URL (
            type: plainText
            heading {
                heading: Catalog URL
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column CATEGORY_ID (
            type: plainText
            heading {
                heading: Category ID
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column LIST_PRICE (
            type: plainText
            heading {
                heading: List Price
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column MIN_PRICE (
            type: plainText
            heading {
                heading: Min Price
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column PRODUCT_DESCRIPTION (
            type: plainText
            heading {
                heading: Product Description
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PRODUCT_ID (
            type: hidden
            heading {
                heading: Product ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PRODUCT_NAME (
            type: plainText
            heading {
                heading: Product Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PRODUCT_STATUS (
            type: plainText
            heading {
                heading: Product Status
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column SUPPLIER_ID (
            type: plainText
            heading {
                heading: Supplier ID
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column WARRANTY_PERIOD (
            type: plainText
            heading {
                heading: Warranty Period
            }
            layout {
                sequence: 6
            }
            source {
                dataType: other
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: F
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column WEIGHT_CLASS (
            type: plainText
            heading {
                heading: Weight Class
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990D0
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Products
        }

        savedReport 62022561 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATALOG_URL (
                sequence: 8
            )

            displayColumn LIST_PRICE (
                sequence: 6
            )

            displayColumn MIN_PRICE (
                sequence: 7
            )

            displayColumn PRODUCT_DESCRIPTION (
                sequence: 2
            )

            displayColumn PRODUCT_NAME (
                sequence: 1
            )

            displayColumn PRODUCT_STATUS (
                sequence: 5
            )

            displayColumn WARRANTY_PERIOD (
                sequence: 4
            )

            displayColumn WEIGHT_CLASS (
                sequence: 3
            )

            sort (
                column: PRODUCT_NAME
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @product-information
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                clearCache: 17
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @product-information
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @product-information
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

