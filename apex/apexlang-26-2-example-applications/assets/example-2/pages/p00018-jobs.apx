page 18 (
    name: Jobs
    alias: JOBS
    title: Jobs
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            ui-dialog--stretch
            t-Dialog--noPadding
        ]
    }
    dialog {
        resizable: false
    }
    security {
        authorizationScheme: @administration-rights
    }
    help {
        helpText:
            ```html
            <p>To find data enter a search term into the search dialog, or click on the column headings to limit the records returned.</p>
            
            <p>You can perform numerous functions by clicking the <strong>Actions</strong> button. This includes selecting the columns that are displayed / hidden and their display sequence, plus numerous data and format functions.  You can also define additional views of the data using the chart, group by, and pivot options.</p>
            
            <p>If you want to save your customizations select report, or click download to unload the data. Enter you email address and time frame under subscription to be sent the data on a regular basis.<p>
            
            <p>For additional information click Help at the bottom of the Actions menu.</p> 
            
            <p>Click the <strong>Reset</strong> button to reset the interactive report back to the default settings.</p>
            ```
    }

    region jobs (
        name: Jobs
        type: interactiveReport
        source {
            location: localDatabase
            tableName: OEHR_JOBS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        link {
            linkColumn: customTarget
            target: {
                page: 19
                items: {
                    P19_JOB_ID: \#JOB_ID#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 6202196051371443514
        }

        column JOB_ID (
            type: hidden
            heading {
                heading: Job ID
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column JOB_TITLE (
            type: plainText
            heading {
                heading: Job Title
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column MAX_SALARY (
            type: plainText
            heading {
                heading: Max Salary
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column MIN_SALARY (
            type: plainText
            heading {
                heading: Min Salary
                alignment: end
            }
            layout {
                sequence: 3
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G999G999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Jobs
        }

        savedReport 62022730 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JOB_ID (
                sequence: 1
            )

            displayColumn JOB_TITLE (
                sequence: 2
            )

            displayColumn MAX_SALARY (
                sequence: 4
            )

            displayColumn MIN_SALARY (
                sequence: 3
            )

            sort (
                column: JOB_ID
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @jobs
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 19
                clearCache: 19
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @jobs
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @jobs
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

