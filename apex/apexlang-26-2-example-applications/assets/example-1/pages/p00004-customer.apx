page 4 (
    name: Customer
    alias: CUSTOMER
    title: Customer
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    security {
        authorizationScheme: @contribution-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region customer (
        name: Customer
        type: form
        source {
            location: localDatabase
            tableName: OEHR_CUSTOMERS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P4_ACCOUNT_MGR_ID (
        type: selectList
        label {
            label: Account Mgr
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @oehr-employees-first-name
        }
        layout {
            sequence: 140
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @customer
            column: ACCOUNT_MGR_ID
            dataType: number
        }
    )

    pageItem P4_CITY (
        type: textField
        label {
            label: City
            alignment: right
        }
        layout {
            sequence: 60
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @customer
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P4_COUNTRY_ID (
        type: textField
        label {
            label: Country ID
            alignment: right
        }
        layout {
            sequence: 80
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 2
        }
        source {
            formRegion: @customer
            column: COUNTRY_ID
            dataType: varchar2
        }
    )

    pageItem P4_CREDIT_LIMIT (
        type: numberField
        label {
            label: Credit Limit
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 120
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @customer
            column: CREDIT_LIMIT
            dataType: number
        }
    )

    pageItem P4_CUSTOMER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @customer
            slot: regionBody
        }
        source {
            formRegion: @customer
            column: CUSTOMER_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_CUST_EMAIL (
        type: textField
        label {
            label: Cust Email
            alignment: right
        }
        layout {
            sequence: 130
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @customer
            column: CUST_EMAIL
            dataType: varchar2
        }
    )

    pageItem P4_CUST_FIRST_NAME (
        type: textField
        label {
            label: Cust First Name
            alignment: right
        }
        layout {
            sequence: 20
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @customer
            column: CUST_FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P4_CUST_LAST_NAME (
        type: textField
        label {
            label: Cust Last Name
            alignment: right
        }
        layout {
            sequence: 30
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @customer
            column: CUST_LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P4_NLS_LANGUAGE (
        type: textField
        label {
            label: Nls Language
            alignment: right
        }
        layout {
            sequence: 100
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 3
        }
        source {
            formRegion: @customer
            column: NLS_LANGUAGE
            dataType: varchar2
        }
    )

    pageItem P4_NLS_TERRITORY (
        type: textField
        label {
            label: Nls Territory
            alignment: right
        }
        layout {
            sequence: 110
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @customer
            column: NLS_TERRITORY
            dataType: varchar2
        }
    )

    pageItem P4_PHONE_NUMBER (
        type: textField
        label {
            label: Phone Number
            alignment: right
        }
        layout {
            sequence: 90
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 25
        }
        source {
            formRegion: @customer
            column: PHONE_NUMBER
            dataType: varchar2
        }
    )

    pageItem P4_POSTAL_CODE (
        type: textField
        label {
            label: Postal Code
            alignment: right
        }
        layout {
            sequence: 50
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @customer
            column: POSTAL_CODE
            dataType: varchar2
        }
    )

    pageItem P4_STATE_PROVINCE (
        type: textField
        label {
            label: State Province
            alignment: right
        }
        layout {
            sequence: 70
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @customer
            column: STATE_PROVINCE
            dataType: varchar2
        }
    )

    pageItem P4_STREET_ADDRESS (
        type: textField
        label {
            label: Street Address
            alignment: right
        }
        layout {
            sequence: 40
            region: @customer
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 40
        }
        source {
            formRegion: @customer
            column: STREET_ADDRESS
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_CUSTOMER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_CUSTOMER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_CUSTOMER_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 35748562124212374308
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-customer (
        name: Initialize form Customer
        type: formInitialization
        formRegion: @customer
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35748561348309374308
        }
    )

    process process-form-customer (
        name: Process form Customer
        type: formAutoRowProcessing
        formRegion: @customer
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 35748561770999374308
        }
    )

)

