        "FORM_DRAWER_DEFAULT_END_REQUIRED_001",
        "INTERACTIVE_REPORT_COLUMN_COVERAGE_001",
        "DECLARATIVE_BUTTON_TARGET_REQUIRED"
      ],
      "reference_paths": [
        "templates/page-examples/interactive-report-page/interactive-report-page.example.md",
