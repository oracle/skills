    {
      "id": "carousel-static-content",
      "name": "Carousel or static content",
      "intent_keywords": ["carousel", "static content", "empty state", "cards", "content band"],
      "selection_require_any": ["carousel", "static content", "empty state", "content band"],
      "required_inputs": ["content_items", "region_purpose", "navigation_or_action_targets"],
