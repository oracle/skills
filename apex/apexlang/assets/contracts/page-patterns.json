        "references/domains/page-components/regions/dashboard/workflow-dashboard.md"
      ]
    },
    {
      "id": "master-detail",
      "name": "Master detail",
      "intent_keywords": ["master detail", "parent child", "detail region", "selected row"],
      "required_inputs": ["master_source", "detail_source", "join_key", "selection_behavior"],
      "generated_components": ["master_results_region", "detail_results_or_form_region", "selection_dynamic_action"],
      "validation_rules": ["MASTER_DETAIL_DYNAMIC_ACTION_REQUIRED_001", "GENERATION_PLAN_REQUIRED_001"],
