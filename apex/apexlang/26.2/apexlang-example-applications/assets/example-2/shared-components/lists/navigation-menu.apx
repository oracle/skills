list navigation-menu (
    name: Navigation Menu

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-user-wrench
        }
        layout {
            sequence: 10000
        }
        link {
            target: {
                page: 10000
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry customers (
        label: Customers
        icon {
            imageIconCssClasses: fa-table-search
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry employees (
        label: Employees
        icon {
            imageIconCssClasses: fa-table-search
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 8
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry order-search (
        label: Order Search
        icon {
            imageIconCssClasses: fa-cards
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry orders (
        label: Orders
        icon {
            imageIconCssClasses: fa-layout-header-sidebar-left
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry orders-calendar (
        label: Orders Calendar
        icon {
            imageIconCssClasses: fa-calendar-o
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 7
            }
        }
    )

)

