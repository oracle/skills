{
  "schemaVersion": 1,
  "purpose": "Renderer-facing construction packs for common page workflows. Each pack declares inputs, emitted components, validation gates, and follow-on references.",
  "selection_order": ["visual-summary-cards", "report-modal-form", "dashboard", "master-detail", "smart-filter-search", "faceted-search", "carousel-static-content", "lov-backed-form"],
  "packs": [
    {
      "id": "visual-summary-cards",
      "pattern_id": "visual-summary-cards",
      "inputs": {
        "required": ["app_path", "page_id", "cards_source", "source_mode", "title_mapping"],
        "optional": ["subtitle_mapping", "body_mapping", "secondary_body_mapping", "primary_key_mapping", "icon_mapping", "media_mapping", "badge_mapping", "conditional_style_mapping", "card_target", "refresh_trigger", "page_items_to_submit", "fixed_grid_columns", "authorization_scheme", "rest_web_credential", "rest_allowed_url_prefixes"]
      },
      "components": ["page:visualSummary", "region:cards", "action:cardNavigationWhenRequested", "dynamicAction:cardsRefreshWhenRequested"],
      "renderer_rules": ["emit_cards_source_mapping_first", "select_exact_sql_or_rest_source_shape", "prefer_native_icon_media_badge_and_action_blocks", "emit_component_appearance_layout_grid", "omit_only_fixed_grid_columns_for_ut_responsive_auto_layout", "project_only_allowlisted_conditional_css_tokens", "emit_exact_refresh_dynamic_action_when_requested", "apply_page_region_action_and_rest_security", "exclude_filter_and_search_orchestration", "validate_generated_apx"],
      "validation_rules": ["CARDS_VISUAL_SUMMARY_PATTERN_REQUIRED_001", "CARDS_SOURCE_MAPPING_REQUIRED_001", "CARDS_INTERACTION_BOUNDARY_REQUIRED_001", "CARDS_SECURITY_REQUIRED_001", "CARDS_CONDITIONAL_STYLE_ALLOWLIST_REQUIRED_001", "DEFAULT_GUIDANCE_LAYER_REQUIRED_001"]
    },
    {
      "id": "report-modal-form",
      "pattern_id": "report-modal-form",
      "inputs": {
        "required": ["app_path", "report_page_id", "form_page_id", "source_table_or_query", "primary_key", "report_columns", "form_items"],
        "optional": ["authorization_scheme", "breadcrumb_parent", "create_button_label", "edit_action_label"]
      },
      "components": ["page:report", "region:interactiveReport", "button:create", "page:modalForm", "process:formAutomaticRowProcessing"],
      "renderer_rules": ["emit_ir_first", "query_property_mapper_for_non_exact_shapes", "validate_generated_apx"],
      "validation_rules": ["INTERACTIVE_REPORT_COLUMN_COVERAGE_001", "FORM_DRAWER_DEFAULT_END_REQUIRED_001"]
    },
    {
      "id": "dashboard",
      "pattern_id": "dashboard",
      "inputs": {
        "required": ["app_path", "page_id", "metrics", "chart_series"],
        "optional": ["supporting_report_source", "time_filter_item", "drill_targets"]
      },
      "components": ["page:dashboard", "templateComponent:metricCard", "region:chart", "region:reportOrCards"],
      "renderer_rules": ["emit_ir_first", "prefer_metric_card_template_components", "validate_generated_apx"],
      "validation_rules": ["DASHBOARD_KPI_METRIC_CARD_REQUIRED_001", "DEFAULT_GUIDANCE_LAYER_REQUIRED_001"]
    },
    {
      "id": "master-detail",
      "pattern_id": "master-detail",
      "inputs": {
        "required": ["app_path", "page_id", "master_source", "detail_source", "join_key"],
        "optional": ["modal_detail_target", "map_layer_target", "refresh_behavior"]
      },
      "components": ["region:masterResults", "region:detailResults", "dynamicAction:selectionRefresh"],
      "renderer_rules": ["emit_ir_first", "explicit_refresh_for_child_context", "validate_generated_apx"],
      "validation_rules": ["MASTER_DETAIL_DYNAMIC_ACTION_REQUIRED_001", "MAP_LAYER_CONTEXT_BIND_REQUIRED_001"]
    },
    {
      "id": "smart-filter-search",
      "pattern_id": "smart-filter-search",
      "inputs": {
        "required": ["app_path", "page_id", "results_source", "base_region_static_id", "searchable_attributes", "match_semantics", "min_chars", "max_len", "tokenization_policy", "settings_contract", "security_scope", "performance_readiness", "generation_plan"],
        "optional": ["results_region_alias", "results_region_type", "authorization_scheme"]
      },
      "contract": {
        "base_region": {
          "count": 1,
          "static_id_required": true,
          "allowed_source_modes": ["secured_view", "canonical_sql"],
          "apex_version": "24.2",
          "allowed_region_types": ["classicReport", "cards", "map", "calendar"],
          "canonical_sql_snapshot_required": true,
          "object_evidence_must_match_source": true,
          "secured_view_evidence": ["object", "source", "object_type:view", "secured:true"],
          "allow_sql_auto_modification": false
        },
        "search": {
          "searchable_attributes_allowlist_required": true,
          "match_semantics": ["contains", "starts", "exact"],
          "match_semantics_count": 1,
          "match_semantic_definitions": {
            "contains": "normalized_token_within_value",
            "starts": "normalized_value_starts_with_token",
            "exact": "normalized_value_equals_token"
          },
          "min_chars_required": true,
          "min_chars": {"type": "positive_integer", "minimum": 1},
          "max_len_required": true,
          "max_len": {"type": "positive_integer", "minimum": 1, "greater_than_or_equal_to": "min_chars"},
          "tokenization_policy_required": true,
          "tokenization_policy": {
            "required_decisions": ["trimming", "repeated_whitespace", "punctuation_boundaries", "case_normalization", "accent_normalization", "duplicate_tokens", "token_order"],
            "consistency_scope": ["search", "suggestions", "refinements"]
          },
          "compiler_evidence_required": true,
          "unsupported_behavior_outcome": "stop_missing_inputs",
          "allow_base_sql_rewrite": false
        },
        "settings": {
          "compiler_evidence_required": true,
          "required_properties": ["maxSuggestionChips", "moreFiltersSuggestionChip", "compactNosThreshold", "showTotalRowCount"],
          "maxSuggestionChips": 100,
          "moreFiltersSuggestionChip": true,
          "compactNosThreshold": 10000,
          "showTotalRowCount": "explicit_boolean",
          "totalRowCountLabel": {
            "when": {"showTotalRowCount": true},
            "value": "Results"
          },
          "unsupported_property_outcome": "stop_missing_inputs"
        },
        "security": {
          "suggestions_use_base_dataset": true,
          "authorization_and_condition_match_base": true
        },
        "performance": {
          "required_evidence": ["index_strategy", "statistics_status", "expected_cardinality"]
        },
        "generation_plan": {
          "required_sections": ["base_source", "search", "settings_contract", "security_scope", "performance_readiness", "runtime_acceptance"],
          "compiler_evidence": ["match_semantics", "min_chars", "max_len", "tokenization_policy"]
        }
      },
      "components": ["region:smartFilters", "filter:search", "region:filteredResults"],
      "renderer_rules": ["emit_smart_filters_before_results", "target_exactly_one_base_region", "require_proven_base_source_contract", "query_compiler_truth_for_settings", "stop_on_unrepresentable_search_behavior", "enforce_compiler_supported_ticket_settings", "require_performance_readiness_evidence", "validate_generated_apx"],
      "validation_rules": ["SMART_FILTER_TOPOLOGY_REQUIRED_001", "SMART_FILTER_RESULTS_REGION_REQUIRED_001", "SMART_FILTER_RESULTS_REGION_ORDER_REQUIRED_001", "SMART_FILTER_BASE_SOURCE_CONTRACT_REQUIRED_001", "SMART_FILTER_SEARCH_SOURCE_REQUIRED_001", "SMART_FILTER_SEARCHABLE_COLUMNS_BASE_PROJECTION_REQUIRED_001", "SMART_FILTER_SECURITY_SCOPE_MATCH_REQUIRED_001", "SMART_FILTER_REFINEMENT_SOURCE_SCOPE_REQUIRED_001", "SMART_FILTER_SEARCH_BEHAVIOR_CONTRACT_REQUIRED_001", "SMART_FILTER_SETTINGS_VALUE_REQUIRED_001", "SMART_FILTER_PERFORMANCE_READINESS_REQUIRED_001", "SMART_FILTER_ACCESSIBILITY_GUIDANCE_REQUIRED_001", "SMART_FILTER_RUNTIME_ACCEPTANCE_REQUIRED_001"]
    },
    {
      "id": "faceted-search",
      "pattern_id": "faceted-search",
      "inputs": {
        "required": ["app_path", "page_id", "results_source", "facet_columns"],
        "optional": ["results_region_alias", "default_filters", "saved_report"]
      },
      "components": ["region:facetedSearch", "region:results", "facet:items"],
      "renderer_rules": ["emit_ir_first", "target_results_region_only", "validate_generated_apx"],
      "validation_rules": ["FACET_SOURCE_DATA_TYPE_REQUIRED_001"]
    },
    {
      "id": "carousel-static-content",
      "pattern_id": "carousel-static-content",
      "inputs": {
        "required": ["app_path", "page_id", "content_items"],
        "optional": ["action_targets", "template_variant", "empty_state"]
      },
      "components": ["region:staticContent", "templateComponent:contentRowOrCards"],
      "renderer_rules": ["emit_ir_first", "avoid_unsupported_custom_html", "validate_generated_apx"],
      "validation_rules": ["GENERATION_PLAN_REQUIRED_001"]
    },
    {
      "id": "lov-backed-form",
      "pattern_id": "lov-backed-form",
      "inputs": {
        "required": ["app_path", "page_id", "form_source", "lov_source", "display_column", "return_column", "target_item"],
        "optional": ["display_null", "cascading_parent_item", "authorization_scheme"]
      },
      "components": ["sharedComponent:lov", "item:selectListOrPopupLov", "process:formAutomaticRowProcessing"],
      "renderer_rules": ["emit_ir_first", "verify_lov_columns", "query_property_mapper_for_item_variant", "validate_generated_apx"],
      "validation_rules": ["COMPILER_TRUTH_EVIDENCE_REQUIRED_001"]
    }
  ]
}
