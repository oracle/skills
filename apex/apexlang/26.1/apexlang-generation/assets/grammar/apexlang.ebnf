<template-option-group-help-property> ::= "helpText" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<template-option-group-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <template-option-group-advanced-property-line> } <indent> "}" <line-end>
