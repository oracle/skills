(* axis *)
(* direct properties use default group: identification *)
<axis> ::= "axis" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <axis-body-line> } <indent> ")" <line-end>
<axis-body-line> ::= <axis-direct-property-line>
  | <axis-group-block>
<axis-direct-property-line> ::= <indent> <axis-direct-property> <line-end>
<axis-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "showAxis" ":" <ws> <boolean> (* required; type: YES NO *)
  | "title" ":" <ws> <string-like-value> (* type: TEXT *)
<axis-group-block> ::= <axis-time-scale>
  | <axis-zoom-scale>
  | <axis-title>
  | <axis-value>
  | <axis-appearance>
  | <axis-major-ticks>
  | <axis-minor-ticks>
  | <axis-tick-label>
  | <axis-dual-yaxes>
  | <axis-advanced>
<axis-time-scale> ::= <indent> "timeScale" <ws> "{" <line-end> { <axis-time-scale-property-line> } <indent> "}" <line-end>
<axis-time-scale-property-line> ::= <indent> <axis-time-scale-property> <line-end>
<axis-time-scale-property> ::= "scale" ":" <ws> ( "seconds" | "minutes" | "hours" | "days" | "weeks" | "months" | "quarters" | "years" ) (* required; applies when name in (major, minor); type: SELECT LIST *)
<axis-zoom-scale> ::= <indent> "zoomScale" <ws> "{" <line-end> { <axis-zoom-scale-property-line> } <indent> "}" <line-end>
<axis-zoom-scale-property-line> ::= <indent> <axis-zoom-scale-property> <line-end>
<axis-zoom-scale-property> ::= "seconds" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "minutes" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "hours" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "days" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "weeks" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "months" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "quarters" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
  | "years" ":" <ws> <boolean> (* required; applies when name in (major, minor); type: YES NO *)
<axis-title> ::= <indent> "title" <ws> "{" <line-end> { <axis-title-property-line> } <indent> "}" <line-end>
<axis-title-property-line> ::= <indent> <axis-title-property> <line-end>
<axis-title-property> ::= "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* type: SELECT LIST *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* type: SELECT LIST *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* type: SELECT LIST *)
  | "fontColor" ":" <ws> <string-like-value> (* type: COLOR *)
<axis-value> ::= <indent> "value" <ws> "{" <line-end> { <axis-value-property-line> } <indent> "}" <line-end>
<axis-value-property-line> ::= <indent> <axis-value-property> <line-end>
<axis-value-property> ::= "min" ":" <ws> <number> (* type: NUMBER *)
  | "max" ":" <ws> <number> (* type: NUMBER *)
  | "format" ":" <ws> ( "dateShort" | "dateMedium" | "dateLong" | "dateFull" | "timeShort" | "timeMedium" | "timeLong" | "timeFull" | "datetimeShort" | "datetimeMedium" | "datetimeLong" | "datetimeFull" | "decimal" | "currency" | "percent" ) (* type: SELECT LIST *)
  | "decimalPlaces" ":" <ws> <number> (* type: INTEGER *)
  | "currency" ":" <ws> <string-like-value> (* type: TEXT *)
  | "pattern" ":" <ws> <string-like-value> (* type: TEXT *)
  | "formatScaling" ":" <ws> ( "none" | "auto" | "thousand" | "million" | "billion" | "trillion" | "quadrillion" ) (* required; type: SELECT LIST *)
  | "baselineScaling" ":" <ws> ( "min" | "zero" ) (* required; type: SELECT LIST *)
  | "scale" ":" <ws> ( "linear" | "log" ) (* required; type: SELECT LIST *)
  | "step" ":" <ws> <number> (* type: NUMBER *)
<axis-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <axis-appearance-property-line> } <indent> "}" <line-end>
<axis-appearance-property-line> ::= <indent> <axis-appearance-property> <line-end>
<axis-appearance-property> ::= "position" ":" <ws> ( "auto" | "start" | "end" | "top" | "bottom" ) (* required; applies when name not in (x, major, minor); type: SELECT LIST *)
<axis-major-ticks> ::= <indent> "majorTicks" <ws> "{" <line-end> { <axis-major-ticks-property-line> } <indent> "}" <line-end>
<axis-major-ticks-property-line> ::= <indent> <axis-major-ticks-property> <line-end>
<axis-major-ticks-property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; type: SELECT LIST *)
  | "minStep" ":" <ws> <number> (* type: NUMBER *)
<axis-minor-ticks> ::= <indent> "minorTicks" <ws> "{" <line-end> { <axis-minor-ticks-property-line> } <indent> "}" <line-end>
<axis-minor-ticks-property-line> ::= <indent> <axis-minor-ticks-property> <line-end>
<axis-minor-ticks-property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; type: SELECT LIST *)
  | "step" ":" <ws> <number> (* type: NUMBER *)
<axis-tick-label> ::= <indent> "tickLabel" <ws> "{" <line-end> { <axis-tick-label-property-line> } <indent> "}" <line-end>
<axis-tick-label-property-line> ::= <indent> <axis-tick-label-property> <line-end>
<axis-tick-label-property> ::= "show" ":" <ws> <boolean> (* required; type: YES NO *)
  | "rotation" ":" <ws> <boolean> (* required; applies when show = on and name = x; type: YES NO *)
  | "position" ":" <ws> ( "outside" | "inside" ) (* required; applies when show = on and name = x; type: SELECT LIST *)
  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* type: SELECT LIST *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* type: SELECT LIST *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* type: SELECT LIST *)
  | "fontColor" ":" <ws> <string-like-value> (* type: COLOR *)
<axis-dual-yaxes> ::= <indent> "dualYAxes" <ws> "{" <line-end> { <axis-dual-yaxes-property-line> } <indent> "}" <line-end>
<axis-dual-yaxes-property-line> ::= <indent> <axis-dual-yaxes-property> <line-end>
<axis-dual-yaxes-property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; type: SELECT LIST *)
  | "splitterPosition" ":" <ws> <number> (* applies when show != off; type: NUMBER *)
<axis-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <axis-advanced-property-line> } <indent> "}" <line-end>
<axis-advanced-property-line> ::= <indent> <axis-advanced-property> <line-end>
<axis-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* type: STATIC ID *)

(* column *)
(* direct properties use default group: identification *)
<column-b> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-b-body-line> } <indent> ")" <line-end>
<column-b-body-line> ::= <column-b-direct-property-line>
  | <column-b-group-block>
  | <column-b-child-component>
<column-b-direct-property-line> ::= <indent> <column-b-direct-property> <line-end>
<column-b-direct-property> ::= "columnName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<column-b-group-block> ::= <column-b-row-selection>
  | <column-b-heading>
  | <column-b-single-row-view>
  | <column-b-lov>
  | <column-b-layout>
  | <column-b-accessibility>
  | <column-b-settings>
  | <column-b-appearance>
  | <column-b-blob-attributes>
  | <column-b-link>
  | <column-b-column-formatting>
  | <column-b-source>
  | <column-b-column-filter>
  | <column-b-advanced>
  | <column-b-gen-ai>
  | <column-b-enable-users-to>
  | <column-b-server-side-condition>
  | <column-b-security>
  | <column-b-help>
  | <column-b-config>
  | <column-b-comments>
<column-b-row-selection> ::= <indent> "rowSelection" <ws> "{" <line-end> { <column-b-row-selection-property-line> } <indent> "}" <line-end>
<column-b-row-selection-property-line> ::= <indent> <column-b-row-selection-property> <line-end>
<column-b-row-selection-property> ::= "enableMultiSelect" ":" <ws> <boolean> (* required; applies when type = NATIVE_ROW_SELECTOR; type: YES NO *)
  | "showSelectAll" ":" <ws> <boolean> (* required; applies when enableMultiSelect = Y; type: YES NO *)
  | "hideControl" ":" <ws> <boolean> (* required; applies when type = NATIVE_ROW_SELECTOR; type: YES NO *)
  | "currentSelectionPageItem" ":" <ws> <string-like-value> (* applies when type = NATIVE_ROW_SELECTOR; type: ITEM *)
<column-b-heading> ::= <indent> "heading" <ws> "{" <line-end> { <column-b-heading-property-line> } <indent> "}" <line-end>
<column-b-heading-property-line> ::= <indent> <column-b-heading-property> <line-end>
<column-b-heading-property> ::= "heading" ":" <ws> <string-like-value> (* required; applies when type != NATIVE_ROW_SELECTOR; type: TEXT *)
  | "alternativeLabel" ":" <ws> <string-like-value> (* applies when type != NATIVE_ROW_SELECTOR; type: TEXT *)
  | "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: PILL BUTTONS *)
<column-b-single-row-view> ::= <indent> "singleRowView" <ws> "{" <line-end> { <column-b-single-row-view-property-line> } <indent> "}" <line-end>
<column-b-single-row-view-property-line> ::= <indent> <column-b-single-row-view-property> <line-end>
<column-b-single-row-view-property> ::= "useColumnHeading" ":" <ws> <boolean> (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: YES NO *)
  | "label" ":" <ws> <string-like-value> (* required; applies when useColumnHeading = N; type: TEXT *)
<column-b-lov> ::= <indent> "lov" <ws> "{" <line-end> { <column-b-lov-property-line> } <indent> "}" <line-end>
<column-b-lov-property-line> ::= <indent> <column-b-lov-property> <line-end>
<column-b-lov-property> ::= "lov" ":" <ws> <reference> (* required; applies when type = NATIVE_PLAIN_LOV; type: COMPONENT *)
<column-b-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-b-layout-property-line> } <indent> "}" <line-end>
<column-b-layout-property-line> ::= <indent> <column-b-layout-property> <line-end>
<column-b-layout-property> ::= "sequence" ":" <ws> <number> (* required; applies when type != NATIVE_ROW_SELECTOR; type: NUMBER *)
  | "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: PILL BUTTONS *)
  | "group" ":" <ws> <reference> (* applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: COMPONENT *)
<column-b-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <column-b-accessibility-property-line> } <indent> "}" <line-end>
<column-b-accessibility-property-line> ::= <indent> <column-b-accessibility-property> <line-end>
<column-b-accessibility-property> ::= "valueIdentifiesRow" ":" <ws> <boolean> (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_PCT_GRAPH, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR); type: YES NO *)
  | "imageDescription" ":" <ws> <string-like-value> (* applies when type = NATIVE_IMAGE; type: TEXT *)
<column-b-settings> ::= <indent> "settings" <ws> "{" <line-end> { <column-b-settings-property-line> } <indent> "}" <line-end>
<column-b-settings-property-line> ::= <indent> <column-b-settings-property> <line-end>
<column-b-settings-property> ::= "format" ":" <ws> ( "html" | "markdown" ) (* required; applies when type = NATIVE_RICH_TEXT; type: SELECT LIST *)
<column-b-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-b-appearance-property-line> } <indent> "}" <line-end>
<column-b-appearance-property-line> ::= <indent> <column-b-appearance-property> <line-end>
<column-b-appearance-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type != NATIVE_HIDDEN_COLUMN; type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type in (NATIVE_PLAIN, NATIVE_LINK, NATIVE_STRIP_HTML); type: COMBOBOX *)
  | "backgroundColor" ":" <ws> <string-like-value> (* applies when type = NATIVE_PCT_GRAPH; type: COLOR *)
  | "foregroundColor" ":" <ws> <string-like-value> (* applies when type = NATIVE_PCT_GRAPH; type: COLOR *)
  | "barWidth" ":" <ws> <number> (* applies when type = NATIVE_PCT_GRAPH; type: INTEGER *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; applies when type = NATIVE_DOWNLOAD; type: SELECT LIST *)
  | "downloadText" ":" <ws> <string-like-value> (* applies when type = NATIVE_DOWNLOAD; type: TEXT *)
<column-b-blob-attributes> ::= <indent> "blobAttributes" <ws> "{" <line-end> { <column-b-blob-attributes-property-line> } <indent> "}" <line-end>
<column-b-blob-attributes-property-line> ::= <indent> <column-b-blob-attributes-property> <line-end>
<column-b-blob-attributes-property> ::= "tableOwner" ":" <ws> <string-like-value> (* applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: TABLE *)
  | "blobColumn" ":" <ws> <string-like-value> (* required; applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn1" ":" <ws> <string-like-value> (* required; applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn2" ":" <ws> <string-like-value> (* applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "mimeTypeColumn" ":" <ws> <string-like-value> (* applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "filenameColumn" ":" <ws> <string-like-value> (* applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "lastUpdatedColumn" ":" <ws> <string-like-value> (* applies when type in (NATIVE_IMAGE, NATIVE_DOWNLOAD); type: COLUMN *)
  | "charSetColumn" ":" <ws> <string-like-value> (* applies when type = NATIVE_DOWNLOAD; type: COLUMN *)
<column-b-link> ::= <indent> "link" <ws> "{" <line-end> { <column-b-link-property-line> } <indent> "}" <line-end>
<column-b-link-property-line> ::= <indent> <column-b-link-property> <line-end>
<column-b-link-property> ::= "target" ":" <ws> <value> (* applies when type in (NATIVE_PCT_GRAPH, NATIVE_PLAIN_LOV); type: LINK *)
  | "target" ":" <ws> <value> (* required; applies when type = NATIVE_LINK; type: LINK *)
  | "linkText" ":" <ws> <string-like-value> (* required; applies when target is set or target is set; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when target is set or target is set; type: TEXT *)
<column-b-column-formatting> ::= <indent> "columnFormatting" <ws> "{" <line-end> { <column-b-column-formatting-property-line> } <indent> "}" <line-end>
<column-b-column-formatting-property-line> ::= <indent> <column-b-column-formatting-property> <line-end>
<column-b-column-formatting-property> ::= "htmlExpression" ":" <ws> <multiline-string> (* applies when type in (NATIVE_PLAIN, NATIVE_PLAIN_LOV); type: HTML *)
<column-b-source> ::= <indent> "source" <ws> "{" <line-end> { <column-b-source-property-line> } <indent> "}" <line-end>
<column-b-source-property-line> ::= <indent> <column-b-source-property> <line-end>
<column-b-source-property> ::= "primaryKey" ":" <ws> <boolean> (* required; applies when type != NATIVE_ROW_SELECTOR; type: YES NO *)
  | "dataType" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "availableOnClient" ":" <ws> <boolean> (* required; applies when primaryKey = N and dataType not in (BLOB, CLOB, BFILE, SDO_GEOMETRY); type: YES NO *)
  | "valueProtected" ":" <ws> <boolean> (* required; applies when availableOnClient = Y; type: YES NO *)
  | "timezoneAware" ":" <ws> <string-like-value> (* required; applies when dataType = DATE; type: TEXT *)
<column-b-column-filter> ::= <indent> "columnFilter" <ws> "{" <line-end> { <column-b-column-filter-property-line> } <indent> "}" <line-end>
<column-b-column-filter-property-line> ::= <indent> <column-b-column-filter-property> <line-end>
<column-b-column-filter-property> ::= "type" ":" <ws> ( "none" | "defaultBasedOnColumnType" | "definedLovExactMatch" | "definedLovWordContains" | "namedLovExactMatch" | "namedLovWordContains" ) (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_PLAIN_LOV, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: SELECT LIST *)
  | "namedLov" ":" <ws> <reference> (* required; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (S, C); type: SQL *)
  | "dateRanges" ":" <ws> ( "all" | "past" | "future" ) (* required; applies when dataType = DATE and type = D; type: SELECT LIST *)
  | "type" ":" <ws> ( "none" | "defaultBasedOnColumnType" | "definedLovExactMatch" | "definedLovWordContains" | "namedLovExactMatch" | "namedLovWordContains" ) (* required; applies when type = NATIVE_PLAIN_LOV; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (S, C); type: SQL *)
<column-b-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-b-advanced-property-line> } <indent> "}" <line-end>
<column-b-advanced-property-line> ::= <indent> <column-b-advanced-property> <line-end>
<column-b-advanced-property> ::= "htmlDomId" ":" <ws> <string-like-value> (* applies when type != NATIVE_ROW_SELECTOR; type: TEXT *)
  | "endUserAlias" ":" <ws> <string-like-value> (* type: TEXT *)
<column-b-gen-ai> ::= <indent> "genAI" <ws> "{" <line-end> { <column-b-gen-ai-property-line> } <indent> "}" <line-end>
<column-b-gen-ai-property-line> ::= <indent> <column-b-gen-ai-property> <line-end>
<column-b-gen-ai-property> ::= "columnContext" ":" <ws> <multiline-string> (* applies when naturalLanguageSupport = Y; type: TEXT EDITOR *)
  | "referenceDataType" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" ) (* applies when naturalLanguageSupport = Y; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when referenceDataType = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when referenceDataType = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when referenceDataType = STATIC; type: STATIC LOV *)
<column-b-enable-users-to> ::= <indent> "enableUsersTo" <ws> "{" <line-end> { <column-b-enable-users-to-property-line> } <indent> "}" <line-end>
<column-b-enable-users-to-property-line> ::= <indent> <column-b-enable-users-to-property> <line-end>
<column-b-enable-users-to-property> ::= "hide" ":" <ws> <boolean> (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: YES NO *)
  | "sort" ":" <ws> <boolean> (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR); type: YES NO *)
  | "filter" ":" <ws> <boolean> (* required; applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: YES NO *)
  | "highlight" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "controlBreak" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "aggregate" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "compute" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "chart" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "groupBy" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
  | "pivot" ":" <ws> <boolean> (* required; applies when type NOT_STARTS_WITH_ANY NATIVE_HIDDEN_COLUMN, NATIVE_RICH_TEXT, NATIVE_ROW_SELECTOR, TMPL_; type: YES NO *)
<column-b-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-b-server-side-condition-property-line> } <indent> "}" <line-end>
<column-b-server-side-condition-property-line> ::= <indent> <column-b-server-side-condition-property> <line-end>
<column-b-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-b-security> ::= <indent> "security" <ws> "{" <line-end> { <column-b-security-property-line> } <indent> "}" <line-end>
<column-b-security-property-line> ::= <indent> <column-b-security-property> <line-end>
<column-b-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type in (NATIVE_PLAIN, NATIVE_LINK, NATIVE_HIDDEN_COLUMN); type: YES NO *)
<column-b-help> ::= <indent> "help" <ws> "{" <line-end> { <column-b-help-property-line> } <indent> "}" <line-end>
<column-b-help-property-line> ::= <indent> <column-b-help-property> <line-end>
<column-b-help-property> ::= "helpText" ":" <ws> <multiline-string> (* applies when type not in (NATIVE_HIDDEN_COLUMN, NATIVE_ROW_SELECTOR); type: HTML *)
<column-b-config> ::= <indent> "config" <ws> "{" <line-end> { <column-b-config-property-line> } <indent> "}" <line-end>
<column-b-config-property-line> ::= <indent> <column-b-config-property> <line-end>
<column-b-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-b-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-b-comments-property-line> } <indent> "}" <line-end>
<column-b-comments-property-line> ::= <indent> <column-b-comments-property> <line-end>
<column-b-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<column-b-child-component> ::= <action-f>

(* action *)
(* direct properties use default group: identification *)
<action-f> ::= "action" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-f-body-line> } <indent> ")" <line-end>
<action-f-body-line> ::= <action-f-direct-property-line>
  | <action-f-group-block>
  | <action-f-child-component>
<action-f-direct-property-line> ::= <indent> <action-f-direct-property> <line-end>
<action-f-direct-property> ::= "position" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "template" ":" <ws> <string-like-value> (* required; applies when position supports TEMPLATE; type: SELECT LIST *)
  | "label" ":" <ws> <string-like-value> (* required; applies when template supports LABEL or position supports TMPL_LABEL; type: TEXT *)
<action-f-group-block> ::= <action-f-layout>
  | <action-f-behavior>
  | <action-f-appearance>
  | <action-f-advanced>
  | <action-f-server-side-condition>
  | <action-f-security>
  | <action-f-config>
  | <action-f-comments>
<action-f-layout> ::= <indent> "layout" <ws> "{" <line-end> { <action-f-layout-property-line> } <indent> "}" <line-end>
<action-f-layout-property-line> ::= <indent> <action-f-layout-property> <line-end>
<action-f-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<action-f-behavior> ::= <indent> "behavior" <ws> "{" <line-end> { <action-f-behavior-property-line> } <indent> "}" <line-end>
<action-f-behavior-property-line> ::= <indent> <action-f-behavior-property> <line-end>
<action-f-behavior-property> ::= "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; applies when template supports LINK_URL or position supports LINK, TMPL_LINK_URL; type: SELECT LIST *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_PAGE; type: LINK_IN_APP *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_APP; type: LINK_IN_DIFF_APP *)
  | "targetUrl" ":" <ws> <string-like-value> (* required; applies when type = REDIRECT_URL; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when type in (REDIRECT_PAGE, REDIRECT_APP, REDIRECT_URL) and property matches; type: TEXT *)
<action-f-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <action-f-appearance-property-line> } <indent> "}" <line-end>
<action-f-appearance-property-line> ::= <indent> <action-f-appearance-property> <line-end>
<action-f-appearance-property> ::= "displayType" ":" <ws> ( "text" | "icon" | "textWithIcon" ) (* required; applies when template supports ICON_CLASSES or position supports TMPL_ICON_CLASSES; type: SELECT LIST *)
  | "icon" ":" <ws> <string-like-value> (* required; applies when displayType in (ICON, TEXT_WITH_ICON); type: ICON *)
  | "hot" ":" <ws> <boolean> (* required; applies when template supports IS_HOT or position supports TMPL_IS_HOT; type: YES NO *)
  | "showAsDisabled" ":" <ws> <boolean> (* required; applies when template supports IS_DISABLED or position supports TMPL_IS_DISABLED; type: YES NO *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when template supports CSS_CLASSES or position supports TMPL_CSS_CLASSES; type: COMBOBOX *)
