  | <group-by-sort>
  | <highlight-a>
  | <pivot-aggregate>
  | <pivot-column>
  | <pivot-row-column>
  | <pivot-sort>
  | <sort-a>
  | <saved-report-b>
  | <aggregate-b>
  | <control-break-b>
