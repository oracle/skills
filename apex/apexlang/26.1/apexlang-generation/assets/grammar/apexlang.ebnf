<rest-enabled-sql-database-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<rest-enabled-sql-database-group-block> ::= <rest-enabled-sql-database-endpoint-url>
  | <rest-enabled-sql-database-authentication>
  | <rest-enabled-sql-database-database>
  | <rest-enabled-sql-database-database-session>
  | <rest-enabled-sql-database-session>
  | <rest-enabled-sql-database-dynamic-config>
  | <rest-enabled-sql-database-advanced>
  | <rest-enabled-sql-database-comments>
<rest-enabled-sql-database-endpoint-url> ::= <indent> "endpointUrl" <ws> "{" <line-end> { <rest-enabled-sql-database-endpoint-url-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-endpoint-url-property-line> ::= <indent> <rest-enabled-sql-database-endpoint-url-property> <line-end>
<rest-enabled-sql-database-endpoint-url-property> ::= "url" ":" <ws> <string-like-value> (* required; type: TEXT *)
<rest-enabled-sql-database-authentication> ::= <indent> "authentication" <ws> "{" <line-end> { <rest-enabled-sql-database-authentication-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-authentication-property-line> ::= <indent> <rest-enabled-sql-database-authentication-property> <line-end>
<rest-enabled-sql-database-authentication-property> ::= "credentials" ":" <ws> <reference> (* required; type: COMPONENT *)
<rest-enabled-sql-database-database> ::= <indent> "database" <ws> "{" <line-end> { <rest-enabled-sql-database-database-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-database-property-line> ::= <indent> <rest-enabled-sql-database-database-property> <line-end>
<rest-enabled-sql-database-database-property> ::= "databaseType" ":" <ws> ( "oracle" | "mysql" ) (* type: SELECT LIST *)
  | "databaseInfo" ":" <ws> <multiline-string> (* applies when databaseType is set; type: TEXT EDITOR *)
<rest-enabled-sql-database-database-session> ::= <indent> "databaseSession" <ws> "{" <line-end> { <rest-enabled-sql-database-database-session-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-database-session-property-line> ::= <indent> <rest-enabled-sql-database-database-session-property> <line-end>
<rest-enabled-sql-database-database-session-property> ::= "initPlsqlCode" ":" <ws> <multiline-string> (* type: PLSQL *)
  | "cleanupPlsqlCode" ":" <ws> <multiline-string> (* type: PLSQL *)
<rest-enabled-sql-database-session> ::= <indent> "session" <ws> "{" <line-end> { <rest-enabled-sql-database-session-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-session-property-line> ::= <indent> <rest-enabled-sql-database-session-property> <line-end>
<rest-enabled-sql-database-session-property> ::= "defaultSchema" ":" <ws> <string-like-value> (* applies when databaseType = MYSQL; type: TEXT *)
  | "mysqlSqlModes" ":" <ws> <string-like-value> (* applies when databaseType = MYSQL; type: TEXT *)
<rest-enabled-sql-database-dynamic-config> ::= <indent> "dynamicConfig" <ws> "{" <line-end> { <rest-enabled-sql-database-dynamic-config-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-dynamic-config-property-line> ::= <indent> <rest-enabled-sql-database-dynamic-config-property> <line-end>
<rest-enabled-sql-database-dynamic-config-property> ::= "plsqlCode" ":" <ws> <multiline-string> (* type: PLSQL *)
  | "procedureName" ":" <ws> <string-like-value> (* type: TEXT *)
<rest-enabled-sql-database-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <rest-enabled-sql-database-advanced-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-advanced-property-line> ::= <indent> <rest-enabled-sql-database-advanced-property> <line-end>
<rest-enabled-sql-database-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "promptOnInstall" ":" <ws> <boolean> (* required; type: YES NO *)
  | "httpsHostName" ":" <ws> <string-like-value> (* type: TEXT *)
  | "ordsVersion" ":" <ws> <string-like-value> (* type: TEXT *)
  | "serverTimeZone" ":" <ws> <string-like-value> (* type: TEXT *)
<rest-enabled-sql-database-comments> ::= <indent> "comments" <ws> "{" <line-end> { <rest-enabled-sql-database-comments-property-line> } <indent> "}" <line-end>
<rest-enabled-sql-database-comments-property-line> ::= <indent> <rest-enabled-sql-database-comments-property> <line-end>
<rest-enabled-sql-database-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* vectorProvider *)
(* direct properties use default group: identification *)
<vector-provider> ::= "vectorProvider" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <vector-provider-body-line> } <indent> ")" <line-end>
<vector-provider-body-line> ::= <vector-provider-direct-property-line>
  | <vector-provider-group-block>
<vector-provider-direct-property-line> ::= <indent> <vector-provider-direct-property> <line-end>
<vector-provider-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> ( "databaseOnnxModel" | "genAIService" | "customPlsql" ) (* required; type: SELECT LIST *)
<vector-provider-group-block> ::= <vector-provider-local-embedding>
  | <vector-provider-gen-aiservice>
  | <vector-provider-endpoint-url>
  | <vector-provider-authentication>
  | <vector-provider-additional-data>
  | <vector-provider-advanced>
  | <vector-provider-comments>
<vector-provider-local-embedding> ::= <indent> "localEmbedding" <ws> "{" <line-end> { <vector-provider-local-embedding-property-line> } <indent> "}" <line-end>
<vector-provider-local-embedding-property-line> ::= <indent> <vector-provider-local-embedding-property> <line-end>
<vector-provider-local-embedding-property> ::= "owner" ":" <ws> <string-like-value> (* applies when type = ONNX; type: OWNER *)
  | "modelName" ":" <ws> <string-like-value> (* required; applies when type = ONNX; type: TEXT *)
  | "function" ":" <ws> <string-like-value> (* required; applies when type = PLSQL; type: TEXT *)
<vector-provider-gen-aiservice> ::= <indent> "genAIService" <ws> "{" <line-end> { <vector-provider-gen-aiservice-property-line> } <indent> "}" <line-end>
<vector-provider-gen-aiservice-property-line> ::= <indent> <vector-provider-gen-aiservice-property> <line-end>
<vector-provider-gen-aiservice-property> ::= "provider" ":" <ws> ( "ociGenAI" | "openai" | "cohere" | "googleGemini" | "genericOpenaiApiCompatible" ) (* required; applies when type = GENAI_PROVIDER; type: SELECT LIST *)
  | "modelName" ":" <ws> <string-like-value> (* required; applies when type = GENAI_PROVIDER; type: TEXT *)
<vector-provider-endpoint-url> ::= <indent> "endpointUrl" <ws> "{" <line-end> { <vector-provider-endpoint-url-property-line> } <indent> "}" <line-end>
<vector-provider-endpoint-url-property-line> ::= <indent> <vector-provider-endpoint-url-property> <line-end>
<vector-provider-endpoint-url-property> ::= "url" ":" <ws> <string-like-value> (* required; applies when type = GENAI_PROVIDER; type: TEXT *)
<vector-provider-authentication> ::= <indent> "authentication" <ws> "{" <line-end> { <vector-provider-authentication-property-line> } <indent> "}" <line-end>
<vector-provider-authentication-property-line> ::= <indent> <vector-provider-authentication-property> <line-end>
<vector-provider-authentication-property> ::= "credentials" ":" <ws> <reference> (* required; applies when type = GENAI_PROVIDER; type: COMPONENT *)
<vector-provider-additional-data> ::= <indent> "additionalData" <ws> "{" <line-end> { <vector-provider-additional-data-property-line> } <indent> "}" <line-end>
<vector-provider-additional-data-property-line> ::= <indent> <vector-provider-additional-data-property> <line-end>
<vector-provider-additional-data-property> ::= "httpHeaders" ":" <ws> <multiline-string> (* applies when type = GENAI_PROVIDER; type: TEXT EDITOR *)
  | "attributes" ":" <ws> <multiline-string> (* applies when type = GENAI_PROVIDER and provider = OCI_GENAI; type: TEXT EDITOR *)
<vector-provider-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <vector-provider-advanced-property-line> } <indent> "}" <line-end>
<vector-provider-advanced-property-line> ::= <indent> <vector-provider-advanced-property> <line-end>
<vector-provider-advanced-property> ::= "maxTokens" ":" <ws> <number> (* type: INTEGER *)
  | "serverTimeout" ":" <ws> <number> (* type: INTEGER *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<vector-provider-comments> ::= <indent> "comments" <ws> "{" <line-end> { <vector-provider-comments-property-line> } <indent> "}" <line-end>
<vector-provider-comments-property-line> ::= <indent> <vector-provider-comments-property> <line-end>
<vector-provider-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* webCredential *)
(* direct properties use default group: identification *)
<web-credential> ::= "webCredential" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <web-credential-body-line> } <indent> ")" <line-end>
<web-credential-body-line> ::= <web-credential-direct-property-line>
  | <web-credential-group-block>
<web-credential-direct-property-line> ::= <indent> <web-credential-direct-property> <line-end>
<web-credential-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> ( "basicAuthentication" | "oauth2ClientCredentialsFlow" | "oci" | "httpHeader" | "urlQueryString" | "keyPair" | "certificatePrivateKeyPair" | "oauth2PasswordFlow" | "signedUserAssertion" | "userAssertionSigningCertificate" ) (* required; type: SELECT LIST *)
<web-credential-group-block> ::= <web-credential-authentication>
  | <web-credential-advanced>
  | <web-credential-comments>
<web-credential-authentication> ::= <indent> "authentication" <ws> "{" <line-end> { <web-credential-authentication-property-line> } <indent> "}" <line-end>
<web-credential-authentication-property-line> ::= <indent> <web-credential-authentication-property> <line-end>
<web-credential-authentication-property> ::= "databaseCredentialName" ":" <ws> <string-like-value> (* type: TEXT *)
  | "instanceLevelDatabaseCredential" ":" <ws> <boolean> (* required; applies when databaseCredentialName is set; type: YES NO *)
  | "oauthScope" ":" <ws> <string-like-value> (* type: TEXT *)
  | "clientIdOrUsername" ":" <ws> <string-like-value> (* type: TEXT *)
  | "ociUserId" ":" <ws> <string-like-value> (* applies when type = OCI; type: TEXT *)
  | "ociTenancyId" ":" <ws> <string-like-value> (* applies when type = OCI; type: TEXT *)
  | "ociPublicKeyFingerprint" ":" <ws> <string-like-value> (* applies when type = OCI; type: TEXT *)
  | "certificate" ":" <ws> <multiline-string> (* applies when type in (CERTIFICATE_PAIR, SIGNED_USER_ASSERTION_CERTIFICATE); type: TEXT EDITOR *)
  | "publicKey" ":" <ws> <multiline-string> (* applies when type = KEY_PAIR; type: TEXT EDITOR *)
  | "audienceList" ":" <ws> <string-like-value> (* applies when type = SIGNED_USER_ASSERTION_CERTIFICATE; type: TEXT *)
  | "certificateAlias" ":" <ws> <string-like-value> (* applies when type = SIGNED_USER_ASSERTION_CERTIFICATE; type: TEXT *)
  | "credentialName" ":" <ws> <string-like-value> (* applies when type in (HTTP_HEADER, HTTP_QUERY_STRING); type: TEXT *)
<web-credential-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <web-credential-advanced-property-line> } <indent> "}" <line-end>
<web-credential-advanced-property-line> ::= <indent> <web-credential-advanced-property> <line-end>
<web-credential-advanced-property> ::= "validForUrls" ":" <ws> <multiline-string> (* applies when type not in (KEY_PAIR, SIGNED_USER_ASSERTION_CERTIFICATE) and databaseCredentialName is not set; type: TEXT EDITOR *)
  | "signingCredential" ":" <ws> <reference> (* required; applies when type = SIGNED_USER_ASSERTION; type: COMPONENT *)
  | "usernameExpression" ":" <ws> <multiline-string> (* applies when type = SIGNED_USER_ASSERTION *)
  | "namedScopes" ":" <ws> <multiline-string> (* type: JSON *)
  | "authenticationCredential" ":" <ws> <reference> (* required; type: COMPONENT *)
  | "tokenAuthenticationMethod" ":" <ws> ( "clientIdAndClientSecretInBody" | "basicAuthentication" | "basicAuthenticationAndClientIdInBody" | "clientIdInBody" ) (* required; type: SELECT LIST *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "promptOnInstall" ":" <ws> <boolean> (* required; applies when databaseCredentialName is not set; type: YES NO *)
<web-credential-comments> ::= <indent> "comments" <ws> "{" <line-end> { <web-credential-comments-property-line> } <indent> "}" <line-end>
<web-credential-comments-property-line> ::= <indent> <web-credential-comments-property> <line-end>
<web-credential-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
