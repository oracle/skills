<search-config-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<search-config-child-component> ::= <parameter-h>

(* parameter *)
(* direct properties use default group: identification *)
<parameter-h> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-h-body-line> } <indent> ")" <line-end>
<parameter-h-body-line> ::= <parameter-h-direct-property-line>
  | <parameter-h-group-block>
<parameter-h-direct-property-line> ::= <indent> <parameter-h-direct-property> <line-end>
<parameter-h-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-h-group-block> ::= <parameter-h-value>
<parameter-h-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-h-value-property-line> } <indent> "}" <line-end>
<parameter-h-value-property-line> ::= <indent> <parameter-h-value-property> <line-end>
<parameter-h-value-property> ::= "type" ":" <ws> ( "staticValue" | "restSourceDefault" | "item" | "sqlQuery" | "expression" | "functionBody" | "collectionClob" | "preference" | "null" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = COLLECTION; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, DATE_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ_PARAMETER and type in (STATIC, ITEM, PREFERENCE); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)

(* shortcut *)
(* direct properties use default group: identification *)
<shortcut> ::= "shortcut" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <shortcut-body-line> } <indent> ")" <line-end>
<shortcut-body-line> ::= <shortcut-direct-property-line>
  | <shortcut-group-block>
<shortcut-direct-property-line> ::= <indent> <shortcut-direct-property> <line-end>
<shortcut-direct-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<shortcut-group-block> ::= <shortcut-source>
  | <shortcut-error>
  | <shortcut-config>
  | <shortcut-subscription>
  | <shortcut-comments>
<shortcut-source> ::= <indent> "source" <ws> "{" <line-end> { <shortcut-source-property-line> } <indent> "}" <line-end>
<shortcut-source-property-line> ::= <indent> <shortcut-source-property> <line-end>
<shortcut-source-property> ::= "type" ":" <ws> ( "functionBody" | "htmlText" | "htmlEscapeSpecialChars" | "image" | "jsEscapeSingleQuotes" | "message" | "jsMessageEscapeSingleQuotes" ) (* required; type: SELECT LIST *)
  | "htmlCode" ":" <ws> <multiline-string> (* required; applies when type in (HTML_TEXT, HTML_TEXT_ESCAPE_SC); type: HTML *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "text" ":" <ws> <multiline-string> (* required; applies when type = TEXT_ESCAPE_JS; type: TEXT EDITOR *)
  | "messageName" ":" <ws> <string-like-value> (* required; applies when type in (MESSAGE, MESSAGE_ESCAPE_JS); type: TEXT *)
  | "imageUrl" ":" <ws> <string-like-value> (* required; applies when type = IMAGE; type: TEXT *)
<shortcut-error> ::= <indent> "error" <ws> "{" <line-end> { <shortcut-error-property-line> } <indent> "}" <line-end>
<shortcut-error-property-line> ::= <indent> <shortcut-error-property> <line-end>
<shortcut-error-property> ::= "errorMessage" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<shortcut-config> ::= <indent> "config" <ws> "{" <line-end> { <shortcut-config-property-line> } <indent> "}" <line-end>
<shortcut-config-property-line> ::= <indent> <shortcut-config-property> <line-end>
<shortcut-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<shortcut-subscription> ::= <indent> "subscription" <ws> "{" <line-end> { <shortcut-subscription-property-line> } <indent> "}" <line-end>
<shortcut-subscription-property-line> ::= <indent> <shortcut-subscription-property> <line-end>
<shortcut-subscription-property> ::= "master" ":" <ws> <string-like-value> (* type: SUBSCRIPTION *)
<shortcut-comments> ::= <indent> "comments" <ws> "{" <line-end> { <shortcut-comments-property-line> } <indent> "}" <line-end>
<shortcut-comments-property-line> ::= <indent> <shortcut-comments-property> <line-end>
<shortcut-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

