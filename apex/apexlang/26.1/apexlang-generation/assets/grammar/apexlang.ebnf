<region-accessibility-property> ::= "useLandmark" ":" <ws> <boolean> (* required; applies when template supports REGION_LANDMARK_ATTRIBUTES; type: YES NO *)
  | "landmarkType" ":" <ws> ( "banner" | "complementary" | "contentInfo" | "form" | "main" | "navigation" | "region" | "search" ) (* applies when useLandmark = Y; type: SELECT LIST *)
  | "landmarkLabel" ":" <ws> <string-like-value> (* applies when useLandmark = Y; type: TEXT *)
<region-image> ::= <indent> "image" <ws> "{" <line-end> { <region-image-property-line> } <indent> "}" <line-end>
<region-image-property-line> ::= <indent> <region-image-property> <line-end>
<region-image-property> ::= "fileUrl" ":" <ws> <string-like-value> (* required; applies when template supports REGION_IMAGE, REGION_IMAGE_URL; type: TEXT *)
  | "accessibleDescription" ":" <ws> <string-like-value> (* applies when template supports REGION_IMAGE_ALT_TEXT and fileUrl is set; type: TEXT *)
  | "customAttributes" ":" <ws> <string-like-value> (* applies when template supports REGION_IMAGE_ATTRIBUTES and fileUrl is set; type: TEXT *)
<region-master-detail> ::= <indent> "masterDetail" <ws> "{" <line-end> { <region-master-detail-property-line> } <indent> "}" <line-end>
<region-master-detail-property-line> ::= <indent> <region-master-detail-property> <line-end>
<region-master-detail-property> ::= "masterRegion" ":" <ws> <reference> (* applies when type = NATIVE_IG; type: COMPONENT *)
<region-header-and-footer> ::= <indent> "headerAndFooter" <ws> "{" <line-end> { <region-header-and-footer-property-line> } <indent> "}" <line-end>
<region-header-and-footer-property-line> ::= <indent> <region-header-and-footer-property> <line-end>
<region-header-and-footer-property> ::= "headerText" ":" <ws> <multiline-string> (* applies when type supports REGION_TEMPLATE; type: HTML *)
  | "footerText" ":" <ws> <multiline-string> (* applies when type supports REGION_TEMPLATE; type: HTML *)
<region-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <region-server-side-condition-property-line> } <indent> "}" <line-end>
<region-server-side-condition-property-line> ::= <indent> <region-server-side-condition-property> <line-end>
<region-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<region-read-only> ::= <indent> "readOnly" <ws> "{" <line-end> { <region-read-only-property-line> } <indent> "}" <line-end>
<region-read-only-property-line> ::= <indent> <region-read-only-property> <line-end>
<region-read-only-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<region-security> ::= <indent> "security" <ws> "{" <line-end> { <region-security-property-line> } <indent> "}" <line-end>
<region-security-property-line> ::= <indent> <region-security-property> <line-end>
<region-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<region-server-cache> ::= <indent> "serverCache" <ws> "{" <line-end> { <region-server-cache-property-line> } <indent> "}" <line-end>
<region-server-cache-property-line> ::= <indent> <region-server-cache-property> <line-end>
<region-server-cache-property> ::= "caching" ":" <ws> ( "false" | "true" | "cacheByUser" | "cacheBySession" ) (* required; applies when type starts with NATIVE_JQM_LIST_VIEW, NATIVE_JQM_REFLOW, NATIVE_JQM_COLUMN_TOGGLE, NATIVE_LIST, NATIVE_URL, NATIVE_IR, NATIVE_SQL_REPORT, NATIVE_TABFORM, NATIVE_PLSQL, NATIVE_JSTREE, NATIVE_CALENDAR, NATIVE_SVG_CHART, NATIVE_SIMPLE_CHART, NATIVE_TREE, NATIVE_STATIC_SEARCH, NATIVE_DYNAMIC_CONTENT, PLUGIN_; type: SELECT LIST *)
  | "cacheTimeout" ":" <ws> ( "10Seconds" | "1Minute" | "10Minutes" | "30Minutes" | "1Hour" | "2Hours" | "3Hours" | "4Hours" | "6Hours" | "12Hours" | "1Day" | "2Days" | "3Days" | "4Days" | "1Week" | "2Weeks" | "4Weeks" | "10Weeks" | "1Year" ) (* required; applies when caching != NOCACHE; type: SELECT LIST *)
  | "dependsOnItems" ":" <ws> <array-of-string-like-value> (* applies when caching != NOCACHE; type: ITEM *)
  | "type" ":" <ws> <string-like-value> (* applies when caching != NOCACHE; type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<region-customization> ::= <indent> "customization" <ws> "{" <line-end> { <region-customization-property-line> } <indent> "}" <line-end>
<region-customization-property-line> ::= <indent> <region-customization-property> <line-end>
<region-customization-property> ::= "customizable" ":" <ws> ( "false" | "shownByDefault" | "notShownByDefault" ) (* required; type: SELECT LIST *)
  | "name" ":" <ws> <string-like-value> (* type: TEXT *)
<region-config> ::= <indent> "config" <ws> "{" <line-end> { <region-config-property-line> } <indent> "}" <line-end>
<region-config-property-line> ::= <indent> <region-config-property> <line-end>
<region-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<region-comments> ::= <indent> "comments" <ws> "{" <line-end> { <region-comments-property-line> } <indent> "}" <line-end>
<region-comments-property-line> ::= <indent> <region-comments-property> <line-end>
<region-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<region-row-selection> ::= <indent> "rowSelection" <ws> "{" <line-end> { <region-row-selection-property-line> } <indent> "}" <line-end>
<region-row-selection-property-line> ::= <indent> <region-row-selection-property> <line-end>
<region-row-selection-property> ::= "type" ":" <ws> ( "focusOnly" | "singleSelection" | "multipleSelection" ) (* applies when type supports ROW_SELECTION and display = REPORT; type: SELECT LIST *)
  | "currentSelectionPageItem" ":" <ws> <string-like-value> (* applies when type in (SINGLE, MULTIPLE); type: ITEM *)
  | "selectAllPageItem" ":" <ws> <string-like-value> (* applies when type = MULTIPLE; type: ITEM *)
<region-entity-title> ::= <indent> "entityTitle" <ws> "{" <line-end> { <region-entity-title-property-line> } <indent> "}" <line-end>
<region-entity-title-property-line> ::= <indent> <region-entity-title-property> <line-end>
<region-entity-title-property> ::= "singular" ":" <ws> <string-like-value> (* applies when display = REPORT; type: TEXT *)
  | "plural" ":" <ws> <string-like-value> (* applies when display = REPORT; type: TEXT *)
<region-child-component> ::= <action-d>
  | <action-e>
  | <axis>
  | <column-b>
  | <column-c>
  | <column-d>
  | <column-e>
  | <column-f>
  | <column-g>
  | <column-group-a>
  | <column-group-b>
  | <facet>
  | <facet-group>
  | <filter-c>
  | <filter-group>
  | <layer>
  | <parameter-l>
  | <saved-report-a>
  | <saved-report-b>
  | <search-source>
  | <series>

(* action *)
(* direct properties use default group: identification *)
<action-d> ::= "action" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-d-body-line> } <indent> ")" <line-end>
<action-d-body-line> ::= <action-d-direct-property-line>
  | <action-d-group-block>
  | <action-d-child-component>
<action-d-direct-property-line> ::= <indent> <action-d-direct-property> <line-end>
<action-d-direct-property> ::= "type" ":" <ws> ( "button" | "fullCard" | "title" | "subtitle" | "media" ) (* required; type: SELECT LIST *)
  | "label" ":" <ws> <string-like-value> (* required; applies when type = BUTTON; type: TEXT *)
<action-d-group-block> ::= <action-d-layout>
  | <action-d-behavior>
  | <action-d-appearance>
  | <action-d-advanced>
  | <action-d-server-side-condition>
  | <action-d-security>
  | <action-d-config>
  | <action-d-comments>
<action-d-layout> ::= <indent> "layout" <ws> "{" <line-end> { <action-d-layout-property-line> } <indent> "}" <line-end>
<action-d-layout-property-line> ::= <indent> <action-d-layout-property> <line-end>
<action-d-layout-property> ::= "position" ":" <ws> ( "primary" | "secondary" ) (* required; applies when type = BUTTON; type: SELECT LIST *)
  | "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<action-d-behavior> ::= <indent> "behavior" <ws> "{" <line-end> { <action-d-behavior-property-line> } <indent> "}" <line-end>
<action-d-behavior-property-line> ::= <indent> <action-d-behavior-property> <line-end>
<action-d-behavior-property> ::= "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; type: SELECT LIST *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_PAGE; type: LINK_IN_APP *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_APP; type: LINK_IN_DIFF_APP *)
  | "targetUrl" ":" <ws> <string-like-value> (* required; applies when type = REDIRECT_URL; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when type in (REDIRECT_PAGE, REDIRECT_APP, REDIRECT_URL); type: TEXT *)
<action-d-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <action-d-appearance-property-line> } <indent> "}" <line-end>
<action-d-appearance-property-line> ::= <indent> <action-d-appearance-property> <line-end>
<action-d-appearance-property> ::= "displayType" ":" <ws> ( "text" | "icon" | "textWithIcon" ) (* required; applies when type = BUTTON; type: SELECT LIST *)
  | "icon" ":" <ws> <string-like-value> (* required; applies when displayType in (ICON, TEXT_WITH_ICON); type: ICON *)
  | "hot" ":" <ws> <boolean> (* required; applies when type = BUTTON; type: YES NO *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type = BUTTON; type: COMBOBOX *)
<action-d-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <action-d-advanced-property-line> } <indent> "}" <line-end>
<action-d-advanced-property-line> ::= <indent> <action-d-advanced-property> <line-end>
<action-d-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<action-d-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <action-d-server-side-condition-property-line> } <indent> "}" <line-end>
<action-d-server-side-condition-property-line> ::= <indent> <action-d-server-side-condition-property> <line-end>
<action-d-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when type is set and type != NEVER; type: SELECT LIST *)
<action-d-security> ::= <indent> "security" <ws> "{" <line-end> { <action-d-security-property-line> } <indent> "}" <line-end>
<action-d-security-property-line> ::= <indent> <action-d-security-property> <line-end>
<action-d-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<action-d-config> ::= <indent> "config" <ws> "{" <line-end> { <action-d-config-property-line> } <indent> "}" <line-end>
<action-d-config-property-line> ::= <indent> <action-d-config-property> <line-end>
<action-d-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<action-d-comments> ::= <indent> "comments" <ws> "{" <line-end> { <action-d-comments-property-line> } <indent> "}" <line-end>
<action-d-comments-property-line> ::= <indent> <action-d-comments-property> <line-end>
<action-d-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<action-d-child-component> ::= <trigger-action-d>

(* triggerAction *)
(* direct properties use default group: identification *)
<trigger-action-d> ::= "triggerAction" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <trigger-action-d-body-line> } <indent> ")" <line-end>
<trigger-action-d-body-line> ::= <trigger-action-d-direct-property-line>
  | <trigger-action-d-group-block>
<trigger-action-d-direct-property-line> ::= <indent> <trigger-action-d-direct-property> <line-end>
<trigger-action-d-direct-property> ::= "name" ":" <ws> <string-like-value> (* type: TEXT *)
  | "action" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<trigger-action-d-group-block> ::= <trigger-action-d-gen-ai>
  | <trigger-action-d-affected-elements>
  | <trigger-action-d-execution>
  | <trigger-action-d-client-side-condition>
  | <trigger-action-d-server-side-condition>
  | <trigger-action-d-security>
  | <trigger-action-d-config>
  | <trigger-action-d-advanced>
  | <trigger-action-d-comments>
<trigger-action-d-gen-ai> ::= <indent> "genAI" <ws> "{" <line-end> { <trigger-action-d-gen-ai-property-line> } <indent> "}" <line-end>
<trigger-action-d-gen-ai-property-line> ::= <indent> <trigger-action-d-gen-ai-property> <line-end>
<trigger-action-d-gen-ai-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when action supports AI_ENABLED; type: YES NO *)
  | "agent" ":" <ws> <reference> (* applies when action supports AI_ENABLED_ALWAYS, AI_ENABLED and enabled = Y or not set; type: COMPONENT *)
  | "service" ":" <ws> <reference> (* applies when agent is not set; type: COMPONENT *)
  | "systemPrompt" ":" <ws> <multiline-string> (* applies when action supports AI_SYSTEM_PROMPT and agent is not set; type: TEXT EDITOR *)
  | "welcomeMessage" ":" <ws> <multiline-string> (* applies when action supports AI_UI and agent is not set; type: HTML *)
  | "itemsToSubmit" ":" <ws> <array-of-string-like-value> (* applies when action supports AI_ENABLED_ALWAYS, AI_ENABLED and enabled = Y or not set; type: ITEM *)
<trigger-action-d-affected-elements> ::= <indent> "affectedElements" <ws> "{" <line-end> { <trigger-action-d-affected-elements-property-line> } <indent> "}" <line-end>
<trigger-action-d-affected-elements-property-line> ::= <indent> <trigger-action-d-affected-elements-property> <line-end>
<trigger-action-d-affected-elements-property> ::= "selectionType" ":" <ws> <string-like-value> (* required; applies when action supports ITEM, BUTTON, REGION, JQUERY_SELECTOR, JAVASCRIPT_EXPRESSION, TRIGGERING_ELEMENT, EVENT_SOURCE; type: SELECT LIST *)
  | "region" ":" <ws> <reference> (* required; applies when selectionType = REGION; type: COMPONENT *)
  | "button" ":" <ws> <reference> (* required; applies when selectionType = BUTTON; type: COMPONENT *)
  | "items" ":" <ws> <array-of-string-like-value> (* required; applies when selectionType = ITEM; type: ITEM *)
  | "jquerySelector" ":" <ws> <string-like-value> (* required; applies when selectionType = JQUERY_SELECTOR; type: TEXT *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when selectionType = JAVASCRIPT_EXPRESSION; type: JAVASCRIPT *)
<trigger-action-d-execution> ::= <indent> "execution" <ws> "{" <line-end> { <trigger-action-d-execution-property-line> } <indent> "}" <line-end>
<trigger-action-d-execution-property-line> ::= <indent> <trigger-action-d-execution-property> <line-end>
<trigger-action-d-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; applies when action supports STOP_EXECUTION_ON_ERROR; type: YES NO *)
  | "waitForResult" ":" <ws> <boolean> (* required; applies when action supports WAIT_FOR_RESULT; type: YES NO *)
<trigger-action-d-client-side-condition> ::= <indent> "clientSideCondition" <ws> "{" <line-end> { <trigger-action-d-client-side-condition-property-line> } <indent> "}" <line-end>
<trigger-action-d-client-side-condition-property-line> ::= <indent> <trigger-action-d-client-side-condition-property> <line-end>
<trigger-action-d-client-side-condition-property> ::= "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* type: SELECT LIST *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS, GREATER_THAN, GREATER_THAN_OR_EQUAL, LESS_THAN, LESS_THAN_OR_EQUAL, NULL, NOT_NULL, IN_LIST, NOT_IN_LIST); type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS, GREATER_THAN, GREATER_THAN_OR_EQUAL, LESS_THAN, LESS_THAN_OR_EQUAL); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when type = JAVASCRIPT_EXPRESSION; type: JAVASCRIPT *)
<trigger-action-d-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <trigger-action-d-server-side-condition-property-line> } <indent> "}" <line-end>
<trigger-action-d-server-side-condition-property-line> ::= <indent> <trigger-action-d-server-side-condition-property> <line-end>
<trigger-action-d-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<trigger-action-d-security> ::= <indent> "security" <ws> "{" <line-end> { <trigger-action-d-security-property-line> } <indent> "}" <line-end>
<trigger-action-d-security-property-line> ::= <indent> <trigger-action-d-security-property> <line-end>
<trigger-action-d-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<trigger-action-d-config> ::= <indent> "config" <ws> "{" <line-end> { <trigger-action-d-config-property-line> } <indent> "}" <line-end>
<trigger-action-d-config-property-line> ::= <indent> <trigger-action-d-config-property> <line-end>
<trigger-action-d-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<trigger-action-d-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <trigger-action-d-advanced-property-line> } <indent> "}" <line-end>
<trigger-action-d-advanced-property-line> ::= <indent> <trigger-action-d-advanced-property> <line-end>
<trigger-action-d-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "initJavaScriptFunction" ":" <ws> <multiline-string> (* applies when action supports INIT_JAVASCRIPT_CODE; type: JAVASCRIPT *)
<trigger-action-d-comments> ::= <indent> "comments" <ws> "{" <line-end> { <trigger-action-d-comments-property-line> } <indent> "}" <line-end>
<trigger-action-d-comments-property-line> ::= <indent> <trigger-action-d-comments-property> <line-end>
<trigger-action-d-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* action *)
(* direct properties use default group: identification *)
<action-e> ::= "action" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-e-body-line> } <indent> ")" <line-end>
<action-e-body-line> ::= <action-e-direct-property-line>
  | <action-e-group-block>
  | <action-e-child-component>
<action-e-direct-property-line> ::= <indent> <action-e-direct-property> <line-end>
<action-e-direct-property> ::= "position" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "template" ":" <ws> <string-like-value> (* required; applies when position supports TEMPLATE; type: SELECT LIST *)
  | "label" ":" <ws> <string-like-value> (* required; applies when template supports LABEL or position supports TMPL_LABEL; type: TEXT *)
<action-e-group-block> ::= <action-e-layout>
  | <action-e-behavior>
  | <action-e-appearance>
  | <action-e-advanced>
  | <action-e-server-side-condition>
  | <action-e-security>
  | <action-e-config>
  | <action-e-comments>
<action-e-layout> ::= <indent> "layout" <ws> "{" <line-end> { <action-e-layout-property-line> } <indent> "}" <line-end>
<action-e-layout-property-line> ::= <indent> <action-e-layout-property> <line-end>
<action-e-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<action-e-behavior> ::= <indent> "behavior" <ws> "{" <line-end> { <action-e-behavior-property-line> } <indent> "}" <line-end>
<action-e-behavior-property-line> ::= <indent> <action-e-behavior-property> <line-end>
<action-e-behavior-property> ::= "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "triggerAction" ) (* required; applies when template supports LINK_URL or position supports LINK, TMPL_LINK_URL; type: SELECT LIST *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_PAGE; type: LINK_IN_APP *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_APP; type: LINK_IN_DIFF_APP *)
  | "targetUrl" ":" <ws> <string-like-value> (* required; applies when type = REDIRECT_URL; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when type in (REDIRECT_PAGE, REDIRECT_APP, REDIRECT_URL) and property matches; type: TEXT *)
<action-e-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <action-e-appearance-property-line> } <indent> "}" <line-end>
<action-e-appearance-property-line> ::= <indent> <action-e-appearance-property> <line-end>
<action-e-appearance-property> ::= "displayType" ":" <ws> ( "text" | "icon" | "textWithIcon" ) (* required; applies when template supports ICON_CLASSES or position supports TMPL_ICON_CLASSES; type: SELECT LIST *)
  | "icon" ":" <ws> <string-like-value> (* required; applies when displayType in (ICON, TEXT_WITH_ICON); type: ICON *)
  | "hot" ":" <ws> <boolean> (* required; applies when template supports IS_HOT or position supports TMPL_IS_HOT; type: YES NO *)
  | "showAsDisabled" ":" <ws> <boolean> (* required; applies when template supports IS_DISABLED or position supports TMPL_IS_DISABLED; type: YES NO *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when template supports CSS_CLASSES or position supports TMPL_CSS_CLASSES; type: COMBOBOX *)
<action-e-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <action-e-advanced-property-line> } <indent> "}" <line-end>
<action-e-advanced-property-line> ::= <indent> <action-e-advanced-property> <line-end>
<action-e-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<action-e-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <action-e-server-side-condition-property-line> } <indent> "}" <line-end>
<action-e-server-side-condition-property-line> ::= <indent> <action-e-server-side-condition-property> <line-end>
<action-e-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when type is set and type != NEVER; type: SELECT LIST *)
<action-e-security> ::= <indent> "security" <ws> "{" <line-end> { <action-e-security-property-line> } <indent> "}" <line-end>
<action-e-security-property-line> ::= <indent> <action-e-security-property> <line-end>
<action-e-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<action-e-config> ::= <indent> "config" <ws> "{" <line-end> { <action-e-config-property-line> } <indent> "}" <line-end>
<action-e-config-property-line> ::= <indent> <action-e-config-property> <line-end>
<action-e-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<action-e-comments> ::= <indent> "comments" <ws> "{" <line-end> { <action-e-comments-property-line> } <indent> "}" <line-end>
<action-e-comments-property-line> ::= <indent> <action-e-comments-property> <line-end>
<action-e-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<action-e-child-component> ::= <menu-a>
  | <trigger-action-b>

