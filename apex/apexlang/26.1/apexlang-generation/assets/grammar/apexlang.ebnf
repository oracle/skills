<report-layout-data-loop-property> ::= "name" ":" <ws> <string-like-value> (* applies when type not in (RTF_FILE, XSL_FILE, XSL_GENERIC); type: TEXT *)
<report-layout-templates> ::= <indent> "templates" <ws> "{" <line-end> { <report-layout-templates-property-line> } <indent> "}" <line-end>
<report-layout-templates-property-line> ::= <indent> <report-layout-templates-property> <line-end>
<report-layout-templates-property> ::= "page" ":" <ws> <multiline-string> (* required; applies when type in (RTF_FILE, XSL_FILE, XSL_GENERIC); type: CLOB *)
  | "columnHeading" ":" <ws> <multiline-string> (* required; applies when type = XSL_GENERIC; type: TEXT EDITOR *)
  | "column" ":" <ws> <multiline-string> (* required; applies when type = XSL_GENERIC; type: TEXT EDITOR *)
  | "columnWidth" ":" <ws> <multiline-string> (* required; applies when type = XSL_GENERIC; type: TEXT EDITOR *)
<report-layout-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <report-layout-advanced-property-line> } <indent> "}" <line-end>
