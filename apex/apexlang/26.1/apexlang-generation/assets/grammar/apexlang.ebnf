<report-layout-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<report-layout-subscription> ::= <indent> "subscription" <ws> "{" <line-end> { <report-layout-subscription-property-line> } <indent> "}" <line-end>
<report-layout-subscription-property-line> ::= <indent> <report-layout-subscription-property> <line-end>
<report-layout-subscription-property> ::= "master" ":" <ws> <string-like-value> (* type: SUBSCRIPTION *)
<report-layout-comments> ::= <indent> "comments" <ws> "{" <line-end> { <report-layout-comments-property-line> } <indent> "}" <line-end>
<report-layout-comments-property-line> ::= <indent> <report-layout-comments-property> <line-end>
<report-layout-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

