(* savedReport *)
(* direct properties use default group: identification *)
<saved-report-b> ::= "savedReport" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <saved-report-b-body-line> } <indent> ")" <line-end>
<saved-report-b-body-line> ::= <saved-report-b-direct-property-line>
  | <saved-report-b-group-block>
  | <saved-report-b-child-component>
<saved-report-b-direct-property-line> ::= <indent> <saved-report-b-direct-property> <line-end>
<saved-report-b-direct-property> ::= "visibility" ":" <ws> ( "primary" | "alternative" | "public" | "private" ) (* required; type: SELECT LIST *)
  | "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<saved-report-b-group-block> ::= <saved-report-b-chart>
  | <saved-report-b-view>
  | <saved-report-b-single-row-view>
  | <saved-report-b-flashback>
  | <saved-report-b-security>
  | <saved-report-b-axis-title>
  | <saved-report-b-sort>
  | <saved-report-b-chart-appearance>
<saved-report-b-chart> ::= <indent> "chart" <ws> "{" <line-end> { <saved-report-b-chart-property-line> } <indent> "}" <line-end>
<saved-report-b-chart-property-line> ::= <indent> <saved-report-b-chart-property> <line-end>
<saved-report-b-chart-property> ::= "type" ":" <ws> ( "area" | "bar" | "bubble" | "donut" | "funnel" | "line" | "lineWithArea" | "pie" | "polar" | "radar" | "range" | "scatter" | "stock" ) (* required; type: SELECT LIST *)
  | "label" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type not in (bubble, range, scatter, stock); type: SELECT LIST *)
  | "valueAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when value is set; type: SELECT LIST *)
  | "open" ":" <ws> <string-like-value> (* required; applies when type = stock; type: SELECT LIST *)
  | "openAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when open is set; type: SELECT LIST *)
  | "close" ":" <ws> <string-like-value> (* required; applies when type = stock; type: SELECT LIST *)
  | "closeAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when close is set; type: SELECT LIST *)
  | "high" ":" <ws> <string-like-value> (* required; applies when type in (range, stock); type: SELECT LIST *)
  | "highAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when high is set; type: SELECT LIST *)
  | "low" ":" <ws> <string-like-value> (* required; applies when type in (range, stock); type: SELECT LIST *)
  | "lowAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when low is set; type: SELECT LIST *)
  | "volume" ":" <ws> <string-like-value> (* applies when type = stock; type: SELECT LIST *)
  | "volumeAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when volume is set; type: SELECT LIST *)
  | "target" ":" <ws> <string-like-value> (* applies when type = funnel; type: SELECT LIST *)
  | "targetAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when target is set; type: SELECT LIST *)
  | "x" ":" <ws> <string-like-value> (* required; applies when type in (bubble, scatter); type: SELECT LIST *)
  | "xAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when x is set; type: SELECT LIST *)
  | "y" ":" <ws> <string-like-value> (* required; applies when type in (bubble, scatter); type: SELECT LIST *)
  | "yAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when y is set; type: SELECT LIST *)
  | "z" ":" <ws> <string-like-value> (* required; applies when type in (bubble, bar, range); type: SELECT LIST *)
  | "zAggregation" ":" <ws> ( "sum" | "average" | "count" | "countDistinct" | "approxCountDistinct" | "min" | "max" | "median" ) (* applies when type in (bubble, bar, range) and z is set; type: SELECT LIST *)
  | "series" ":" <ws> <string-like-value> (* applies when type in (area, bar, line, lineWithArea, range, scatter); type: SELECT LIST *)
  | "stacked" ":" <ws> <boolean> (* required; applies when series is set; type: YES NO *)
<saved-report-b-view> ::= <indent> "view" <ws> "{" <line-end> { <saved-report-b-view-property-line> } <indent> "}" <line-end>
<saved-report-b-view-property-line> ::= <indent> <saved-report-b-view-property> <line-end>
<saved-report-b-view-property> ::= "chart" ":" <ws> <boolean> (* required; type: YES NO *)
  | "default" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "rowsPerPage" ":" <ws> <string-like-value> (* type: COMBOBOX *)
  | "stretchColumns" ":" <ws> <boolean> (* required; type: YES NO *)
  | "settingsAreaExpanded" ":" <ws> <boolean> (* required; type: YES NO *)
<saved-report-b-single-row-view> ::= <indent> "singleRowView" <ws> "{" <line-end> { <saved-report-b-single-row-view-property-line> } <indent> "}" <line-end>
<saved-report-b-single-row-view-property-line> ::= <indent> <saved-report-b-single-row-view-property> <line-end>
<saved-report-b-single-row-view-property> ::= "excludeNullValues" ":" <ws> <boolean> (* required; type: YES NO *)
  | "displayedColumns" ":" <ws> <boolean> (* required; type: YES NO *)
<saved-report-b-flashback> ::= <indent> "flashback" <ws> "{" <line-end> { <saved-report-b-flashback-property-line> } <indent> "}" <line-end>
<saved-report-b-flashback-property-line> ::= <indent> <saved-report-b-flashback-property> <line-end>
<saved-report-b-flashback-property> ::= "minutesAgo" ":" <ws> <number> (* type: NUMBER *)
  | "enabled" ":" <ws> <boolean> (* required; applies when minutesAgo is set; type: YES NO *)
<saved-report-b-security> ::= <indent> "security" <ws> "{" <line-end> { <saved-report-b-security-property-line> } <indent> "}" <line-end>
<saved-report-b-security-property-line> ::= <indent> <saved-report-b-security-property> <line-end>
<saved-report-b-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<saved-report-b-axis-title> ::= <indent> "axisTitle" <ws> "{" <line-end> { <saved-report-b-axis-title-property-line> } <indent> "}" <line-end>
<saved-report-b-axis-title-property-line> ::= <indent> <saved-report-b-axis-title-property> <line-end>
<saved-report-b-axis-title-property> ::= "label" ":" <ws> <string-like-value> (* applies when type in (area, bar, bubble, line, lineWithArea, range, scatter); type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* applies when type in (area, bar, bubble, line, lineWithArea, range, scatter); type: TEXT *)
  | "decimalPlaces" ":" <ws> <number> (* applies when type in (area, bar, bubble, donut, line, lineWithArea, pie, range, scatter); type: INTEGER *)
<saved-report-b-sort> ::= <indent> "sort" <ws> "{" <line-end> { <saved-report-b-sort-property-line> } <indent> "}" <line-end>
<saved-report-b-sort-property-line> ::= <indent> <saved-report-b-sort-property> <line-end>
<saved-report-b-sort-property> ::= "by" ":" <ws> <string-like-value> (* required; applies when type != stock; type: SELECT LIST *)
  | "direction" ":" <ws> ( "asc" | "desc" ) (* required; applies when type != stock; type: SELECT LIST *)
  | "nulls" ":" <ws> ( "first" | "last" ) (* required; applies when type != stock; type: SELECT LIST *)
<saved-report-b-chart-appearance> ::= <indent> "chartAppearance" <ws> "{" <line-end> { <saved-report-b-chart-appearance-property-line> } <indent> "}" <line-end>
<saved-report-b-chart-appearance-property-line> ::= <indent> <saved-report-b-chart-appearance-property> <line-end>
<saved-report-b-chart-appearance-property> ::= "orientation" ":" <ws> ( "vertical" | "horizontal" ) (* required; applies when type in (area, bar, funnel, line, lineWithArea, range); type: SELECT LIST *)
<saved-report-b-child-component> ::= <aggregate-b>
