  | <sort-b-group-block>
<sort-b-direct-property-line> ::= <indent> <sort-b-direct-property> <line-end>
<sort-b-direct-property> ::= "column" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
<sort-b-group-block> ::= <sort-b-sort>
<sort-b-sort> ::= <indent> "sort" <ws> "{" <line-end> { <sort-b-sort-property-line> } <indent> "}" <line-end>
<sort-b-sort-property-line> ::= <indent> <sort-b-sort-property> <line-end>
<sort-b-sort-property> ::= "direction" ":" <ws> ( "asc" | "desc" ) (* required; type: SELECT LIST *)
  | "nulls" ":" <ws> ( "first" | "last" ) (* required; type: SELECT LIST *)
  | "sequence" ":" <ws> <number> (* required; type: NUMBER *)

(* searchSource *)
(* direct properties use default group: identification *)
<search-source> ::= "searchSource" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <search-source-body-line> } <indent> ")" <line-end>
<search-source-body-line> ::= <search-source-direct-property-line>
  | <search-source-group-block>
<search-source-direct-property-line> ::= <indent> <search-source-direct-property> <line-end>
<search-source-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "searchConfig" ":" <ws> <reference> (* required; type: COMPONENT *)
  | "useAsInitialResult" ":" <ws> <boolean> (* required; type: YES NO *)
<search-source-group-block> ::= <search-source-layout>
  | <search-source-appearance>
  | <search-source-icon-and-badge>
  | <search-source-advanced>
  | <search-source-server-side-condition>
  | <search-source-config>
  | <search-source-comments>
<search-source-layout> ::= <indent> "layout" <ws> "{" <line-end> { <search-source-layout-property-line> } <indent> "}" <line-end>
<search-source-layout-property-line> ::= <indent> <search-source-layout-property> <line-end>
<search-source-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<search-source-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <search-source-appearance-property-line> } <indent> "}" <line-end>
<search-source-appearance-property-line> ::= <indent> <search-source-appearance-property> <line-end>
<search-source-appearance-property> ::= "overrideLabel" ":" <ws> <string-like-value> (* type: TEXT *)
  | "maxResults" ":" <ws> <number> (* type: INTEGER *)
<search-source-icon-and-badge> ::= <indent> "iconAndBadge" <ws> "{" <line-end> { <search-source-icon-and-badge-property-line> } <indent> "}" <line-end>
<search-source-icon-and-badge-property-line> ::= <indent> <search-source-icon-and-badge-property> <line-end>
<search-source-icon-and-badge-property> ::= "iconCssClasses" ":" <ws> <string-like-value> (* type: ICON *)
<search-source-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <search-source-advanced-property-line> } <indent> "}" <line-end>
<search-source-advanced-property-line> ::= <indent> <search-source-advanced-property> <line-end>
<search-source-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<search-source-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <search-source-server-side-condition-property-line> } <indent> "}" <line-end>
<search-source-server-side-condition-property-line> ::= <indent> <search-source-server-side-condition-property> <line-end>
<search-source-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<search-source-config> ::= <indent> "config" <ws> "{" <line-end> { <search-source-config-property-line> } <indent> "}" <line-end>
<search-source-config-property-line> ::= <indent> <search-source-config-property> <line-end>
<search-source-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<search-source-comments> ::= <indent> "comments" <ws> "{" <line-end> { <search-source-comments-property-line> } <indent> "}" <line-end>
<search-source-comments-property-line> ::= <indent> <search-source-comments-property> <line-end>
<search-source-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* series *)
(* direct properties use default group: identification *)
<series> ::= "series" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <series-body-line> } <indent> ")" <line-end>
<series-body-line> ::= <series-direct-property-line>
  | <series-group-block>
  | <series-child-component>
<series-direct-property-line> ::= <indent> <series-direct-property> <line-end>
<series-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> ( "area" | "bar" | "line" | "lineWithArea" | "barRange" | "areaRange" ) (* required; applies when type = combo; type: SELECT LIST *)
  | "type" ":" <ws> ( "barRange" | "areaRange" ) (* required; applies when type = range; type: SELECT LIST *)
  | "type" ":" <ws> ( "area" | "bar" | "line" | "lineWithArea" | "scatter" | "bubble" | "barRange" | "areaRange" ) (* required; applies when type = polar; type: SELECT LIST *)
  | "type" ":" <ws> ( "area" | "areaRange" | "line" ) (* required; applies when type = radar; type: SELECT LIST *)
  | "type" ":" <ws> ( "area" | "bar" | "boxPlot" | "line" | "lineWithArea" ) (* required; applies when type = boxPlot; type: SELECT LIST *)
<series-group-block> ::= <series-execution>
  | <series-source>
  | <series-order-by>
  | <series-data-profile>
  | <series-rest-synchronization>
  | <series-external-filter-and-order-by>
  | <series-local-post-processing>
  | <series-remote-cache>
  | <series-timeline>
  | <series-column-mapping>
  | <series-viewport>
  | <series-appearance>
  | <series-link>
  | <series-thresholds>
  | <series-reference-lines>
  | <series-line>
  | <series-marker>
  | <series-label>
  | <series-performance>
  | <series-advanced>
  | <series-server-side-condition>
  | <series-security>
  | <series-config>
<series-execution> ::= <indent> "execution" <ws> "{" <line-end> { <series-execution-property-line> } <indent> "}" <line-end>
<series-execution-property-line> ::= <indent> <series-execution-property> <line-end>
<series-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<series-source> ::= <indent> "source" <ws> "{" <line-end> { <series-source-property-line> } <indent> "}" <line-end>
<series-source-property-line> ::= <indent> <series-source-property> <line-end>
<series-source-property> ::= "location" ":" <ws> ( "localDatabase" | "restEnabledSql" | "restSource" | "jsonDualityView" | "jsonSource" | "regionSource" | "sampleData" ) (* required; type: SELECT LIST *)
  | "remoteServer" ":" <ws> <reference> (* required; applies when location = REMOTE; type: COMPONENT *)
  | "sampleData" ":" <ws> ( "employees" | "tasks" | "products" | "projects" ) (* required; applies when location = SAMPLE_DATA; type: SELECT LIST *)
  | "type" ":" <ws> <string-like-value> (* required; applies when location in (LOCAL, REMOTE); type: SELECT LIST *)
  | "tableOwner" ":" <ws> <string-like-value> (* applies when type = TABLE; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type = TABLE; type: TABLE *)
  | "includeRowidColumn" ":" <ws> <boolean> (* required; applies when type = TABLE and remoteServer supports IS_ORACLE or not set; type: YES NO *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = TABLE; type: WHERE CLAUSE *)
  | "graphOwner" ":" <ws> <string-like-value> (* applies when type = GRAPH; type: OWNER *)
  | "graphName" ":" <ws> <string-like-value> (* required; applies when type = GRAPH; type: GRAPH *)
  | "matchClause" ":" <ws> <multiline-string> (* required; applies when type = GRAPH; type: TEXT EDITOR *)
  | "columnsClause" ":" <ws> <multiline-string> (* required; applies when type = GRAPH; type: TEXT EDITOR *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = GRAPH; type: WHERE CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "restSource" ":" <ws> <reference> (* required; applies when location = WEB_SOURCE; type: COMPONENT *)
  | "jsonDualityView" ":" <ws> <reference> (* required; applies when location = DUALITY_VIEW; type: COMPONENT *)
  | "jsonSource" ":" <ws> <reference> (* required; applies when location = JSON_COLLECTION; type: COMPONENT *)
  | "pageItemsToSubmit" ":" <ws> <array-of-string-like-value> (* applies when location != REGION_SOURCE; type: ITEM *)
  | "optimizerHint" ":" <ws> <string-like-value> (* applies when location in (LOCAL, REMOTE, WEB_SOURCE, DUALITY_VIEW, JSON_COLLECTION); type: TEXT *)
<series-order-by> ::= <indent> "orderBy" <ws> "{" <line-end> { <series-order-by-property-line> } <indent> "}" <line-end>
<series-order-by-property-line> ::= <indent> <series-order-by-property> <line-end>
<series-order-by-property> ::= "type" ":" <ws> ( "staticValue" | "item" ) (* applies when location in (LOCAL, REMOTE, SAMPLE_DATA) and type in (TABLE, GRAPH, SQL, FUNC_BODY_RETURNING_SQL, $NULL$) or not set; type: SELECT LIST *)
  | "orderByClause" ":" <ws> <multiline-string> (* required; applies when type = STATIC and type in (TABLE, SQL, FUNC_BODY_RETURNING_SQL, $NULL$) or not set; type: ORDER BY CLAUSE *)
  | "item" ":" <ws> <value> (* required; applies when type = ITEM and type in (TABLE, SQL, FUNC_BODY_RETURNING_SQL, $NULL$) or not set; type: ORDER BY ITEM *)
  | "orderByClause" ":" <ws> <multiline-string> (* required; applies when type = STATIC and type = GRAPH; type: ORDER BY CLAUSE *)
  | "item" ":" <ws> <value> (* required; applies when type = ITEM and type = GRAPH; type: ORDER BY ITEM *)
<series-data-profile> ::= <indent> "dataProfile" <ws> "{" <line-end> { <series-data-profile-property-line> } <indent> "}" <line-end>
<series-data-profile-property-line> ::= <indent> <series-data-profile-property> <line-end>
<series-data-profile-property> ::= "nestedRows" ":" <ws> <reference> (* applies when restSource supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
  | "nestedRows" ":" <ws> <reference> (* applies when jsonDualityView supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
  | "nestedRows" ":" <ws> <reference> (* applies when jsonSource supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
<series-rest-synchronization> ::= <indent> "restSynchronization" <ws> "{" <line-end> { <series-rest-synchronization-property-line> } <indent> "}" <line-end>
<series-rest-synchronization-property-line> ::= <indent> <series-rest-synchronization-property> <line-end>
<series-rest-synchronization-property> ::= "useLocalTable" ":" <ws> <boolean> (* required; applies when restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS or property matches or nestedRows supports IS_SYNCED; type: YES NO *)
<series-external-filter-and-order-by> ::= <indent> "externalFilterAndOrderBy" <ws> "{" <line-end> { <series-external-filter-and-order-by-property-line> } <indent> "}" <line-end>
<series-external-filter-and-order-by-property-line> ::= <indent> <series-external-filter-and-order-by-property> <line-end>
<series-external-filter-and-order-by-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when restSource is set and useLocalTable in (N, $NULL$) or not set; type: YES NO *)
  | "filter" ":" <ws> <multiline-string> (* applies when enabled = Y; type: TEXT EDITOR *)
  | "orderByType" ":" <ws> ( "staticValue" | "item" ) (* applies when enabled = Y; type: SELECT LIST *)
  | "orderBy" ":" <ws> <multiline-string> (* required; applies when orderByType = STATIC; type: TEXT EDITOR *)
  | "item" ":" <ws> <value> (* required; applies when orderByType = ITEM; type: ORDER BY ITEM *)
<series-local-post-processing> ::= <indent> "localPostProcessing" <ws> "{" <line-end> { <series-local-post-processing-property-line> } <indent> "}" <line-end>
<series-local-post-processing-property-line> ::= <indent> <series-local-post-processing-property> <line-end>
<series-local-post-processing-property> ::= "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when restSource is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "orderByType" ":" <ws> ( "staticValue" | "item" ) (* applies when type = WHERE_ORDER_BY_CLAUSE; type: SELECT LIST *)
  | "orderByClause" ":" <ws> <multiline-string> (* required; applies when orderByType = STATIC; type: ORDER BY CLAUSE *)
  | "item" ":" <ws> <value> (* required; applies when orderByType = ITEM; type: ORDER BY ITEM *)
  | "orderByItem" ":" <ws> <value> (* applies when type in (SQL, FUNC_BODY_RETURNING_SQL); type: ORDER BY ITEM *)
  | "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when jsonDualityView is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "orderByType" ":" <ws> ( "staticValue" | "item" ) (* applies when type = WHERE_ORDER_BY_CLAUSE; type: SELECT LIST *)
  | "orderByClause" ":" <ws> <multiline-string> (* required; applies when orderByType = STATIC; type: ORDER BY CLAUSE *)
  | "item" ":" <ws> <value> (* required; applies when orderByType = ITEM; type: ORDER BY ITEM *)
  | "orderByItem" ":" <ws> <value> (* applies when type in (SQL, FUNC_BODY_RETURNING_SQL); type: ORDER BY ITEM *)
  | "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when jsonSource is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "orderByType" ":" <ws> ( "staticValue" | "item" ) (* applies when type = WHERE_ORDER_BY_CLAUSE; type: SELECT LIST *)
  | "orderByClause" ":" <ws> <multiline-string> (* required; applies when orderByType = STATIC; type: ORDER BY CLAUSE *)
  | "item" ":" <ws> <value> (* required; applies when orderByType = ITEM; type: ORDER BY ITEM *)
  | "orderByItem" ":" <ws> <value> (* applies when type in (SQL, FUNC_BODY_RETURNING_SQL); type: ORDER BY ITEM *)
<series-remote-cache> ::= <indent> "remoteCache" <ws> "{" <line-end> { <series-remote-cache-property-line> } <indent> "}" <line-end>
<series-remote-cache-property-line> ::= <indent> <series-remote-cache-property> <line-end>
<series-remote-cache-property> ::= "caching" ":" <ws> ( "allUsers" | "user" | "session" ) (* applies when location = REMOTE; type: SELECT LIST *)
  | "timeout" ":" <ws> <multiline-string> (* required; applies when caching is set; type: TEXT EDITOR *)
<series-timeline> ::= <indent> "timeline" <ws> "{" <line-end> { <series-timeline-property-line> } <indent> "}" <line-end>
<series-timeline-property-line> ::= <indent> <series-timeline-property> <line-end>
<series-timeline-property> ::= "startDateSourceType" ":" <ws> ( "databaseColumn" | "item" ) (* required; applies when type = gantt; type: SELECT LIST *)
  | "startDateColumn" ":" <ws> <string-like-value> (* applies when type = gantt and startDateSourceType = DB_COLUMN; type: COLUMN *)
  | "startDateItem" ":" <ws> <string-like-value> (* applies when type = gantt and startDateSourceType = ITEM; type: ITEM *)
  | "endDateSourceType" ":" <ws> ( "databaseColumn" | "item" ) (* required; applies when type = gantt; type: SELECT LIST *)
  | "endDateColumn" ":" <ws> <string-like-value> (* applies when type = gantt and endDateSourceType = DB_COLUMN; type: COLUMN *)
  | "endDateItem" ":" <ws> <string-like-value> (* applies when type = gantt and endDateSourceType = ITEM; type: ITEM *)
<series-column-mapping> ::= <indent> "columnMapping" <ws> "{" <line-end> { <series-column-mapping-property-line> } <indent> "}" <line-end>
<series-column-mapping-property-line> ::= <indent> <series-column-mapping-property> <line-end>
<series-column-mapping-property> ::= "seriesName" ":" <ws> <string-like-value> (* applies when type not in (dial, stock, gantt); type: COLUMN *)
  | "label" ":" <ws> <string-like-value> (* required; applies when type not in (dial, gantt); type: COLUMN *)
  | "label" ":" <ws> <string-like-value> (* applies when type = dial; type: COLUMN *)
  | "valueAggregation" ":" <ws> ( "count" | "sum" | "average" | "median" | "min" | "max" | "countDistinct" | "approxCountDistinct" ) (* applies when property matches and type not in (SQL, FUNC_BODY_RETURNING_SQL) or not set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when property matches and valueAggregation in ($NULL$, SUM, AVG, MEDIAN, MIN, MAX, COUNT_DISTINCT, APPROX_COUNT_DISTINCT) or not set; type: COLUMN *)
  | "open" ":" <ws> <string-like-value> (* required; applies when type = stock; type: COLUMN *)
  | "low" ":" <ws> <string-like-value> (* required; applies when type = stock or type in (barRange, areaRange) or type in (barRange, areaRange) or type in (barRange, areaRange) or type = areaRange; type: COLUMN *)
  | "high" ":" <ws> <string-like-value> (* required; applies when type = stock or type in (barRange, areaRange) or type in (barRange, areaRange) or type in (barRange, areaRange) or type = areaRange; type: COLUMN *)
  | "low" ":" <ws> <string-like-value> (* applies when type = boxPlot; type: COLUMN *)
  | "high" ":" <ws> <string-like-value> (* applies when type = boxPlot; type: COLUMN *)
  | "close" ":" <ws> <string-like-value> (* required; applies when type = stock; type: COLUMN *)
  | "volume" ":" <ws> <string-like-value> (* applies when type = stock; type: COLUMN *)
  | "x" ":" <ws> <string-like-value> (* required; applies when type in (bubble, scatter) or type in (bubble, scatter); type: COLUMN *)
  | "y" ":" <ws> <string-like-value> (* required; applies when type in (bubble, scatter) or type in (bubble, scatter); type: COLUMN *)
  | "z" ":" <ws> <string-like-value> (* applies when type in (bar, bubble) or type in (bar, barRange) or type = barRange or type in (bar, bubble, barRange) or type in (bar, boxPlot); type: COLUMN *)
  | "targetValue" ":" <ws> <string-like-value> (* applies when type = funnel; type: COLUMN *)
  | "minValue" ":" <ws> <string-like-value> (* applies when type = dial; type: COLUMN *)
  | "maxValue" ":" <ws> <string-like-value> (* required; applies when type = dial; type: COLUMN *)
  | "rowId" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "rowName" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "taskId" ":" <ws> <string-like-value> (* required; applies when type = gantt; type: COLUMN *)
  | "taskName" ":" <ws> <string-like-value> (* required; applies when type = gantt; type: COLUMN *)
  | "taskStartDate" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "taskEndDate" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "progress" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "baselineStartDate" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "baselineEndDate" ":" <ws> <string-like-value> (* applies when type = gantt; type: COLUMN *)
  | "customTooltip" ":" <ws> <string-like-value> (* type: COLUMN *)
  | "legendTooltip" ":" <ws> <string-like-value> (* applies when type in (area, bar, bubble, line, lineWithArea, scatter, stock) or type in (area, bar, line, lineWithArea) or type in (area, bar, line, lineWithArea, bubble, scatter) or type in (area, line) or type in (area, bar, line, lineWithArea, boxPlot); type: COLUMN *)
  | "labelTooltip" ":" <ws> <string-like-value> (* applies when type in (area, bar, bubble, line, lineWithArea, scatter, stock) or type in (area, bar, line, lineWithArea) or type in (area, bar, line, lineWithArea, bubble, scatter) or type in (area, line) or type in (area, bar, line, lineWithArea, boxPlot); type: COLUMN *)
  | "customColumn" ":" <ws> <string-like-value> (* applies when type != gantt; type: COLUMN *)
<series-viewport> ::= <indent> "viewport" <ws> "{" <line-end> { <series-viewport-property-line> } <indent> "}" <line-end>
<series-viewport-property-line> ::= <indent> <series-viewport-property> <line-end>
<series-viewport-property> ::= "startDateSourceType" ":" <ws> ( "databaseColumn" | "item" ) (* applies when type = gantt; type: SELECT LIST *)
  | "startDateColumn" ":" <ws> <string-like-value> (* applies when type = gantt and startDateSourceType = DB_COLUMN; type: COLUMN *)
  | "startDateItem" ":" <ws> <string-like-value> (* applies when type = gantt and startDateSourceType = ITEM; type: ITEM *)
  | "endDateSourceType" ":" <ws> ( "databaseColumn" | "item" ) (* applies when type = gantt; type: SELECT LIST *)
  | "endDateColumn" ":" <ws> <string-like-value> (* applies when type = gantt and endDateSourceType = DB_COLUMN; type: COLUMN *)
  | "endDateItem" ":" <ws> <string-like-value> (* applies when type = gantt and endDateSourceType = ITEM; type: ITEM *)
<series-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <series-appearance-property-line> } <indent> "}" <line-end>
<series-appearance-property-line> ::= <indent> <series-appearance-property> <line-end>
<series-appearance-property> ::= "taskCssClasses" ":" <ws> <array-of-string-like-value> (* applies when type = gantt; type: COMBOBOX *)
  | "progressCssClasses" ":" <ws> <array-of-string-like-value> (* applies when type = gantt; type: COMBOBOX *)
  | "baselineCssClasses" ":" <ws> <array-of-string-like-value> (* applies when type = gantt; type: COMBOBOX *)
  | "color" ":" <ws> <string-like-value> (* applies when type not in (gantt); type: COLOR *)
  | "plotAreaColor" ":" <ws> <string-like-value> (* applies when type = dial; type: COLOR *)
  | "q2Color" ":" <ws> <string-like-value> (* applies when type = boxPlot; type: COLOR *)
  | "q3Color" ":" <ws> <string-like-value> (* applies when type = boxPlot; type: COLOR *)
  | "assignedToY2Axis" ":" <ws> <boolean> (* required; applies when type in (area, bar, line, lineWithArea, boxPlot, combo); type: YES NO *)
  | "stackCategory" ":" <ws> <string-like-value> (* applies when type in (area, bar, line, lineWithArea, combo); type: TEXT *)
<series-link> ::= <indent> "link" <ws> "{" <line-end> { <series-link-property-line> } <indent> "}" <line-end>
<series-link-property-line> ::= <indent> <series-link-property> <line-end>
<series-link-property> ::= "type" ":" <ws> ( "redirectThisApp" | "redirectOtherApp" | "redirectUrl" | "redirectUrlReturnedByFirstCol" ) (* applies when type not in (dial, gantt); type: SELECT LIST *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_PAGE; type: LINK_IN_APP *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_APP; type: LINK_IN_DIFF_APP *)
  | "targetUrl" ":" <ws> <string-like-value> (* required; applies when type = REDIRECT_URL; type: TEXT *)
<series-thresholds> ::= <indent> "thresholds" <ws> "{" <line-end> { <series-thresholds-property-line> } <indent> "}" <line-end>
<series-thresholds-property-line> ::= <indent> <series-thresholds-property> <line-end>
<series-thresholds-property> ::= "values" ":" <ws> <string-like-value> (* applies when type = dial; type: TEXT *)
  | "colors" ":" <ws> <string-like-value> (* applies when type = dial; type: TEXT *)
  | "display" ":" <ws> ( "all" | "onIndicator" | "currentThresholdOnly" ) (* applies when type = dial; type: SELECT LIST *)
<series-reference-lines> ::= <indent> "referenceLines" <ws> "{" <line-end> { <series-reference-lines-property-line> } <indent> "}" <line-end>
<series-reference-lines-property-line> ::= <indent> <series-reference-lines-property> <line-end>
<series-reference-lines-property> ::= "values" ":" <ws> <string-like-value> (* applies when type = dial; type: TEXT *)
  | "colors" ":" <ws> <string-like-value> (* applies when type = dial; type: TEXT *)
<series-line> ::= <indent> "line" <ws> "{" <line-end> { <series-line-property-line> } <indent> "}" <line-end>
<series-line-property-line> ::= <indent> <series-line-property> <line-end>
<series-line-property> ::= "style" ":" <ws> ( "dotted" | "dashed" | "solid" ) (* required; applies when type in (line, lineWithArea, bubble, scatter, combo); type: SELECT LIST *)
  | "width" ":" <ws> <number> (* applies when type in (line, lineWithArea, bubble, scatter, combo); type: INTEGER *)
  | "type" ":" <ws> ( "centeredStepped" | "curved" | "centeredSegmented" | "stepped" | "segmented" | "straight" | "auto" | "none" ) (* required; applies when type in (line, lineWithArea, area, scatter) or type = areaRange or type in (line, lineWithArea, area, areaRange) or type in (line, lineWithArea, area) or type in (line, lineWithArea, area, scatter, areaRange) or type in (line, areaRange, area); type: SELECT LIST *)
<series-marker> ::= <indent> "marker" <ws> "{" <line-end> { <series-marker-property-line> } <indent> "}" <line-end>
<series-marker-property-line> ::= <indent> <series-marker-property> <line-end>
<series-marker-property> ::= "show" ":" <ws> ( "auto" | "true" | "false" ) (* required; applies when type in (line, lineWithArea, scatter, area, bubble, boxPlot) or type = areaRange or type in (line, lineWithArea, area, areaRange) or type in (line, lineWithArea, area) or type in (line, lineWithArea, area, scatter, areaRange) or type in (line, areaRange, area); type: SELECT LIST *)
  | "shape" ":" <ws> ( "auto" | "circle" | "diamond" | "human" | "plus" | "square" | "star" | "triangleDown" | "triangleUp" ) (* required; applies when type in (line, lineWithArea, scatter, area, bubble, boxPlot, combo, range) and show != off; type: SELECT LIST *)
<series-label> ::= <indent> "label" <ws> "{" <line-end> { <series-label-property-line> } <indent> "}" <line-end>
<series-label-property-line> ::= <indent> <series-label-property> <line-end>
<series-label-property> ::= "show" ":" <ws> <boolean> (* required; type: YES NO *)
  | "position" ":" <ws> ( "center" | "outsideSlice" | "aboveMarker" | "belowMarker" | "beforeMarker" | "afterMarker" | "insideBarEdge" | "outsideBarEdge" | "auto" | "none" | "start" ) (* required; applies when show = Y and type not in (gantt); type: SELECT LIST *)
  | "displayAs" ":" <ws> ( "label" | "percentage" | "value" | "labelValue" | "labelPercentage" | "labelPercentageValue" | "percentageValue" ) (* required; applies when show = Y and type in (pie, donut); type: SELECT LIST *)
  | "cssStyling" ":" <ws> <array-of-string-like-value> (* applies when show = Y and type not in (dial, gantt); type: COMBOBOX *)
  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* applies when show = Y; type: SELECT LIST *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* applies when show = Y; type: SELECT LIST *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* applies when show = Y; type: SELECT LIST *)
  | "fontColor" ":" <ws> <string-like-value> (* applies when show = Y; type: COLOR *)
  | "taskLabelPosition" ":" <ws> ( "start" | "end" | "innerCenter" | "innerStart" | "innerEnd" ) (* required; applies when type = gantt and show = Y; type: SELECT LIST *)
<series-performance> ::= <indent> "performance" <ws> "{" <line-end> { <series-performance-property-line> } <indent> "}" <line-end>
<series-performance-property-line> ::= <indent> <series-performance-property> <line-end>
<series-performance-property> ::= "maxRowsToProcess" ":" <ws> <number> (* applies when type != dial; type: INTEGER *)
<series-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <series-advanced-property-line> } <indent> "}" <line-end>
<series-advanced-property-line> ::= <indent> <series-advanced-property> <line-end>
<series-advanced-property> ::= "javaScriptStaticId" ":" <ws> <string-like-value> (* type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* type: STATIC ID *)
<series-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <series-server-side-condition-property-line> } <indent> "}" <line-end>
<series-server-side-condition-property-line> ::= <indent> <series-server-side-condition-property> <line-end>
<series-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<series-security> ::= <indent> "security" <ws> "{" <line-end> { <series-security-property-line> } <indent> "}" <line-end>
<series-security-property-line> ::= <indent> <series-security-property> <line-end>
<series-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<series-config> ::= <indent> "config" <ws> "{" <line-end> { <series-config-property-line> } <indent> "}" <line-end>
<series-config-property-line> ::= <indent> <series-config-property> <line-end>
<series-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<series-child-component> ::= <parameter-k>

(* parameter *)
(* direct properties use default group: identification *)
<parameter-k> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-k-body-line> } <indent> ")" <line-end>
<parameter-k-body-line> ::= <parameter-k-direct-property-line>
  | <parameter-k-group-block>
<parameter-k-direct-property-line> ::= <indent> <parameter-k-direct-property> <line-end>
<parameter-k-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-k-group-block> ::= <parameter-k-parameter>
  | <parameter-k-value>
<parameter-k-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-k-parameter-property-line> } <indent> "}" <line-end>
<parameter-k-parameter-property-line> ::= <indent> <parameter-k-parameter-property> <line-end>
<parameter-k-parameter-property> ::= "ignoreOutput" ":" <ws> <boolean> (* required; applies when name supports IN_OUT_PARAMETER and name NOT_FEATURES FETCH_COLLECTION_OPERATION_PRM; type: YES NO *)
<parameter-k-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-k-value-property-line> } <indent> "}" <line-end>
<parameter-k-value-property-line> ::= <indent> <parameter-k-value-property> <line-end>
<parameter-k-value-property> ::= "type" ":" <ws> ( "staticValue" | "restSourceDefault" | "item" | "sqlQuery" | "expression" | "functionBody" | "collectionClob" | "preference" | "parentColumn" | "null" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = COLLECTION; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, DATE_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ_PARAMETER and type in (STATIC, ITEM, PREFERENCE); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "column" ":" <ws> <reference> (* required; applies when type = PARENT_COLUMN; type: COMPONENT *)

(* validation *)
(* direct properties use default group: identification *)
<validation-b> ::= "validation" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <validation-b-body-line> } <indent> ")" <line-end>
<validation-b-body-line> ::= <validation-b-direct-property-line>
  | <validation-b-group-block>
<validation-b-direct-property-line> ::= <indent> <validation-b-direct-property> <line-end>
<validation-b-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<validation-b-group-block> ::= <validation-b-execution>
  | <validation-b-validation>
  | <validation-b-advanced>
  | <validation-b-error>
  | <validation-b-server-side-condition>
  | <validation-b-security>
  | <validation-b-config>
  | <validation-b-comments>
<validation-b-execution> ::= <indent> "execution" <ws> "{" <line-end> { <validation-b-execution-property-line> } <indent> "}" <line-end>
<validation-b-execution-property-line> ::= <indent> <validation-b-execution-property> <line-end>
<validation-b-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<validation-b-validation> ::= <indent> "validation" <ws> "{" <line-end> { <validation-b-validation-property-line> } <indent> "}" <line-end>
<validation-b-validation-property-line> ::= <indent> <validation-b-validation-property> <line-end>
<validation-b-validation-property> ::= "editableRegion" ":" <ws> <reference> (* type: COMPONENT *)
  | "type" ":" <ws> ( "rowsReturned" | "noRowsReturned" | "expression" | "plsqlError" | "functionBodyReturningBoolean" | "functionBody" | "itemIsNotNull" | "itemIsNotNullOrZero" | "itemIsNotZero" | "itemContainsNoSpaces" | "itemIsAlphanumeric" | "itemIsNumeric" | "itemIsAValidDate" | "itemIsAValidTimestamp" | "item=Value" | "item!=Value" | "itemIsContainedInValue" | "itemIsNotContainedInValue" | "itemContainsOnlyCharsInValue" | "itemContainsAtLeastOneOfCharsInValue" | "itemContainsNoneOfCharsInValue" | "itemMatchesRegexp" ) (* required; applies when editableRegion is not set; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_BOOLEAN; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_ERR_TEXT; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "plsqlCodeRaisingError" ":" <ws> <multiline-string> (* required; applies when type = PLSQL_ERROR; type: PLSQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type starts with ITEM, REGULAR_EXPRESSION; type: ITEM *)
  | "regexp" ":" <ws> <string-like-value> (* required; applies when type = REGULAR_EXPRESSION; type: TEXT *)
  | "value" ":" <ws> <multiline-string> (* required; type: TEXT EDITOR *)
  | "type" ":" <ws> ( "rowsReturned" | "noRowsReturned" | "expression" | "plsqlError" | "functionBodyReturningBoolean" | "functionBody" | "columnIsNotNull" | "columnIsNotNullOrZero" | "columnIsNotZero" | "columnContainsNoSpaces" | "columnIsAlphanumeric" | "columnIsNumeric" | "columnIsAValidDate" | "columnIsAValidTimestamp" | "column=Value" | "column!=Value" | "columnIsContainedInValue" | "columnIsNotContainedInValue" | "columnContainsOnlyCharsInValue" | "columnContainsAtLeastOneOfCharsInValue" | "columnContainsNoneOfCharsInValue" | "columnMatchesRegexp" ) (* required; applies when editableRegion is set; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_BOOLEAN; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_ERR_TEXT; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "plsqlCodeRaisingError" ":" <ws> <multiline-string> (* required; applies when type = PLSQL_ERROR; type: PLSQL *)
  | "column" ":" <ws> <string-like-value> (* required; applies when type starts with ITEM, REGULAR_EXPRESSION; type: REGION COLUMN *)
  | "regexp" ":" <ws> <string-like-value> (* required; applies when type = REGULAR_EXPRESSION; type: TEXT *)
  | "value" ":" <ws> <multiline-string> (* required; type: TEXT EDITOR *)
  | "alwaysExecute" ":" <ws> <boolean> (* required; type: YES NO *)
<validation-b-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <validation-b-advanced-property-line> } <indent> "}" <line-end>
<validation-b-advanced-property-line> ::= <indent> <validation-b-advanced-property> <line-end>
<validation-b-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<validation-b-error> ::= <indent> "error" <ws> "{" <line-end> { <validation-b-error-property-line> } <indent> "}" <line-end>
<validation-b-error-property-line> ::= <indent> <validation-b-error-property> <line-end>
<validation-b-error-property> ::= "errorMessage" ":" <ws> <multiline-string> (* required; applies when type != FUNC_BODY_RETURNING_ERR_TEXT or not set and type != FUNC_BODY_RETURNING_ERR_TEXT or not set; type: TEXT EDITOR *)
  | "displayLocation" ":" <ws> ( "inlineWithFieldAndInNotification" | "inlineWithField" | "inlineInNotification" | "onErrorPage" ) (* required; type: SELECT LIST *)
  | "associatedItem" ":" <ws> <reference> (* applies when editableRegion is not set; type: COMPONENT *)
  | "associatedColumn" ":" <ws> <string-like-value> (* applies when editableRegion is set; type: REGION COLUMN *)
<validation-b-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <validation-b-server-side-condition-property-line> } <indent> "}" <line-end>
<validation-b-server-side-condition-property-line> ::= <indent> <validation-b-server-side-condition-property> <line-end>
<validation-b-server-side-condition-property> ::= "whenButtonPressed" ":" <ws> <reference> (* type: COMPONENT *)
  | "executionScope" ":" <ws> ( "forCreatedAndModifiedRows" | "allSubmittedRows" ) (* required; applies when editableRegion is set; type: SELECT LIST *)
  | "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when editableRegion is set and type is set and type != NEVER; type: SELECT LIST *)
<validation-b-security> ::= <indent> "security" <ws> "{" <line-end> { <validation-b-security-property-line> } <indent> "}" <line-end>
<validation-b-security-property-line> ::= <indent> <validation-b-security-property> <line-end>
<validation-b-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<validation-b-config> ::= <indent> "config" <ws> "{" <line-end> { <validation-b-config-property-line> } <indent> "}" <line-end>
<validation-b-config-property-line> ::= <indent> <validation-b-config-property> <line-end>
<validation-b-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<validation-b-comments> ::= <indent> "comments" <ws> "{" <line-end> { <validation-b-comments-property-line> } <indent> "}" <line-end>
<validation-b-comments-property-line> ::= <indent> <validation-b-comments-property> <line-end>
<validation-b-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* pageGroup *)
(* direct properties use default group: identification *)
<page-group> ::= "pageGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <page-group-body-line> } <indent> ")" <line-end>
<page-group-body-line> ::= <page-group-direct-property-line>
  | <page-group-group-block>
<page-group-direct-property-line> ::= <indent> <page-group-direct-property> <line-end>
<page-group-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "sequence" ":" <ws> <number> (* type: INTEGER *)
<page-group-group-block> ::= <page-group-description>
<page-group-description> ::= <indent> "description" <ws> "{" <line-end> { <page-group-description-property-line> } <indent> "}" <line-end>
<page-group-description-property-line> ::= <indent> <page-group-description-property> <line-end>
<page-group-description-property> ::= "description" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* plugin *)
(* direct properties use default group: identification *)
<plugin> ::= "plugin" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <plugin-body-line> } <indent> ")" <line-end>
<plugin-body-line> ::= <plugin-direct-property-line>
  | <plugin-group-block>
  | <plugin-child-component>
<plugin-direct-property-line> ::= <indent> <plugin-direct-property> <line-end>
<plugin-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "apexlangName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "type" ":" <ws> ( "templateComponent" | "item" | "region" | "dynamicAction" | "genAITool" | "process" | "authenticationScheme" | "authorizationScheme" | "restDataSource" | "interactiveReportColumn" ) (* required; type: SELECT LIST *)
  | "theme" ":" <ws> <reference> (* applies when type = TEMPLATE COMPONENT; type: COMPONENT *)
<plugin-group-block> ::= <plugin-template-component>
  | <plugin-default-slots>
  | <plugin-ai-tool>
  | <plugin-on-demand>
  | <plugin-component>
  | <plugin-source>
  | <plugin-callbacks>
  | <plugin-advanced>
  | <plugin-css>
  | <plugin-java-script>
  | <plugin-information>
  | <plugin-subscription>
  | <plugin-comments>
<plugin-template-component> ::= <indent> "templateComponent" <ws> "{" <line-end> { <plugin-template-component-property-line> } <indent> "}" <line-end>
<plugin-template-component-property-line> ::= <indent> <plugin-template-component-property> <line-end>
<plugin-template-component-property> ::= "availableAs" ":" <ws> <array-of-string-like-value> (* applies when type = TEMPLATE COMPONENT; type: CHECKBOXES *)
  | "partial" ":" <ws> <multiline-string> (* applies when type = TEMPLATE COMPONENT; type: HTML *)
  | "reportBody" ":" <ws> <multiline-string> (* applies when availableAs = REPORT; type: HTML *)
  | "reportGroup" ":" <ws> <multiline-string> (* applies when availableAs = REPORT; type: HTML *)
  | "reportRow" ":" <ws> <multiline-string> (* applies when availableAs = REPORT; type: HTML *)
  | "reportContainer" ":" <ws> <multiline-string> (* applies when availableAs = REPORT; type: HTML *)
  | "translateTemplates" ":" <ws> <boolean> (* required; applies when type = TEMPLATE COMPONENT; type: YES NO *)
  | "defaultEscapeMode" ":" <ws> ( "html" | "htmlAttribute" | "stripHtml" | "raw" ) (* required; applies when type = TEMPLATE COMPONENT; type: SELECT LIST *)
  | "numberOfLazyLoadingSkeletons" ":" <ws> <number> (* applies when availableAs = REPORT; type: INTEGER *)
<plugin-default-slots> ::= <indent> "defaultSlots" <ws> "{" <line-end> { <plugin-default-slots-property-line> } <indent> "}" <line-end>
<plugin-default-slots-property-line> ::= <indent> <plugin-default-slots-property> <line-end>
<plugin-default-slots-property> ::= "regions" ":" <ws> <string-like-value> (* applies when type = TEMPLATE COMPONENT; type: SELECT LIST *)
  | "items" ":" <ws> <string-like-value> (* applies when type = TEMPLATE COMPONENT; type: SELECT LIST *)
  | "buttons" ":" <ws> <string-like-value> (* applies when type = TEMPLATE COMPONENT; type: SELECT LIST *)
<plugin-ai-tool> ::= <indent> "aiTool" <ws> "{" <line-end> { <plugin-ai-tool-property-line> } <indent> "}" <line-end>
<plugin-ai-tool-property-line> ::= <indent> <plugin-ai-tool-property> <line-end>
<plugin-ai-tool-property> ::= "executionLocation" ":" <ws> ( "clientSide" | "serverSide" ) (* required; applies when type = AI TOOL; type: SELECT LIST *)
  | "supportedExecutionPoints" ":" <ws> <array-of-string-like-value> (* required; applies when type = AI TOOL; type: CHECKBOXES *)
<plugin-on-demand> ::= <indent> "onDemand" <ws> "{" <line-end> { <plugin-on-demand-property-line> } <indent> "}" <line-end>
<plugin-on-demand-property-line> ::= <indent> <plugin-on-demand-property> <line-end>
<plugin-on-demand-property> ::= "description" ":" <ws> <multiline-string> (* applies when supportedExecutionPoints = ON_DEMAND; type: TEXT EDITOR *)
  | "parameters" ":" <ws> ( "noParameters" | "definedByAiTool" | "definedByPlugIn" ) (* required; applies when supportedExecutionPoints = ON_DEMAND; type: SELECT LIST *)
  | "parametersJsonSchema" ":" <ws> <multiline-string> (* required; applies when parameters = PARAMETERS_DEFINED_BY_PLUGIN; type: JSON *)
<plugin-component> ::= <indent> "component" <ws> "{" <line-end> { <plugin-component-property-line> } <indent> "}" <line-end>
<plugin-component-property-line> ::= <indent> <plugin-component-property> <line-end>
<plugin-component-property> ::= "supports" ":" <ws> <array-of-string-like-value> (* required; applies when type = ITEM TYPE; type: CHECKBOXES *)
  | "supports" ":" <ws> <array-of-string-like-value> (* required; applies when type = PROCESS TYPE; type: CHECKBOXES *)
  | "supportsSessionStateDataTypes" ":" <ws> <array-of-string-like-value> (* required; applies when type = ITEM TYPE; type: CHECKBOXES *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = ITEM TYPE; type: CHECKBOXES; large enum list omitted *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = TEMPLATE COMPONENT; type: CHECKBOXES *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = REGION TYPE; type: CHECKBOXES; large enum list omitted *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = DYNAMIC ACTION; type: CHECKBOXES *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = AUTHENTICATION TYPE; type: CHECKBOXES *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = WEB SOURCE TYPE; type: CHECKBOXES *)
  | "standardAttributes" ":" <ws> <array-of-string-like-value> (* applies when type = PROCESS TYPE; type: CHECKBOXES *)
<plugin-source> ::= <indent> "source" <ws> "{" <line-end> { <plugin-source-property-line> } <indent> "}" <line-end>
<plugin-source-property-line> ::= <indent> <plugin-source-property> <line-end>
<plugin-source-property> ::= "plsqlCode" ":" <ws> <multiline-string> (* applies when type in (REGION TYPE, DYNAMIC ACTION, PROCESS TYPE, AUTHORIZATION TYPE, AUTHENTICATION TYPE, ITEM TYPE, WEB SOURCE TYPE, AI TOOL); type: PLSQL *)
  | "sampleData" ":" <ws> ( "employees" | "tasks" | "products" | "projects" ) (* applies when type in (REGION TYPE, TEMPLATE COMPONENT); type: SELECT LIST *)
<plugin-callbacks> ::= <indent> "callbacks" <ws> "{" <line-end> { <plugin-callbacks-property-line> } <indent> "}" <line-end>
<plugin-callbacks-property-line> ::= <indent> <plugin-callbacks-property> <line-end>
<plugin-callbacks-property> ::= "apiInterface" ":" <ws> <string-like-value> (* required; applies when type not in (TEMPLATE COMPONENT, AI TOOL); type: SELECT LIST *)
  | "renderProcedureName" ":" <ws> <string-like-value> (* applies when type in (DYNAMIC ACTION, ITEM TYPE, REGION TYPE) or property matches; type: TEXT *)
  | "metaDataProcedureName" ":" <ws> <string-like-value> (* applies when type = ITEM TYPE; type: TEXT *)
  | "sessionSentryProcedureName" ":" <ws> <string-like-value> (* applies when type = AUTHENTICATION TYPE; type: TEXT *)
  | "invalidSessionProcedureName" ":" <ws> <string-like-value> (* applies when type = AUTHENTICATION TYPE; type: TEXT *)
  | "authenticationProcedureName" ":" <ws> <string-like-value> (* applies when type = AUTHENTICATION TYPE; type: TEXT *)
  | "postLogoutProcedureName" ":" <ws> <string-like-value> (* applies when type = AUTHENTICATION TYPE; type: TEXT *)
  | "ajaxProcedureName" ":" <ws> <string-like-value> (* applies when type in (AUTHENTICATION TYPE, DYNAMIC ACTION, REGION TYPE, ITEM TYPE); type: TEXT *)
  | "validationProcedureName" ":" <ws> <string-like-value> (* applies when type = ITEM TYPE; type: TEXT *)
  | "executionFunctionProcedureName" ":" <ws> <string-like-value> (* applies when type in (AUTHORIZATION TYPE, PROCESS TYPE) or property matches; type: TEXT *)
  | "completionFunctionProcedureName" ":" <ws> <string-like-value> (* applies when standardAttributes = WAIT_FOR_COMPLETION; type: TEXT *)
  | "terminationFunctionProcedureName" ":" <ws> <string-like-value> (* applies when standardAttributes = WAIT_FOR_COMPLETION; type: TEXT *)
  | "restSourceCapabilitiesProcedure" ":" <ws> <string-like-value> (* applies when type = WEB SOURCE TYPE; type: TEXT *)
  | "restSourceFetchProcedure" ":" <ws> <string-like-value> (* applies when type = WEB SOURCE TYPE; type: TEXT *)
  | "restSourceDmlProcedure" ":" <ws> <string-like-value> (* applies when type = WEB SOURCE TYPE; type: TEXT *)
  | "restSourceExecuteProcedure" ":" <ws> <string-like-value> (* applies when type = WEB SOURCE TYPE; type: TEXT *)
  | "aiRequestHandlerProcedure" ":" <ws> <string-like-value> (* applies when property matches or property matches or property matches; type: TEXT *)
  | "aiResponseHandlerProcedure" ":" <ws> <string-like-value> (* applies when property matches or property matches or property matches; type: TEXT *)
  | "restSourceDiscoverProcedure" ":" <ws> <string-like-value> (* applies when type = WEB SOURCE TYPE; type: TEXT *)
<plugin-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <plugin-advanced-property-line> } <indent> "}" <line-end>
<plugin-advanced-property-line> ::= <indent> <plugin-advanced-property> <line-end>
<plugin-advanced-property> ::= "filePrefix" ":" <ws> <string-like-value> (* applies when type in (REGION TYPE, DYNAMIC ACTION, ITEM TYPE, TEMPLATE COMPONENT) or property matches; type: TEXT *)
  | "category" ":" <ws> ( "component" | "effect" | "execute" | "initialize" | "miscellaneous" | "navigation" | "notification" | "style" | "builtInComponents" | "appComponents" | "themeComponents" | "ai" ) (* applies when type = DYNAMIC ACTION; type: SELECT LIST *)
  | "quickPick" ":" <ws> <boolean> (* required; applies when type = TEMPLATE COMPONENT; type: YES NO *)
  | "substituteAttributeValues" ":" <ws> <boolean> (* required; type: YES NO *)
  | "deprecated" ":" <ws> <boolean> (* required; type: YES NO *)
  | "legacy" ":" <ws> <boolean> (* required; type: YES NO *)
<plugin-css> ::= <indent> "css" <ws> "{" <line-end> { <plugin-css-property-line> } <indent> "}" <line-end>
<plugin-css-property-line> ::= <indent> <plugin-css-property> <line-end>
<plugin-css-property> ::= "fileUrls" ":" <ws> <array-of-string-like-value> (* applies when type in (REGION TYPE, DYNAMIC ACTION, ITEM TYPE, TEMPLATE COMPONENT) or property matches; type: FILE URLS CSS *)
<plugin-java-script> ::= <indent> "javaScript" <ws> "{" <line-end> { <plugin-java-script-property-line> } <indent> "}" <line-end>
<plugin-java-script-property-line> ::= <indent> <plugin-java-script-property> <line-end>
<plugin-java-script-property> ::= "fileUrls" ":" <ws> <array-of-string-like-value> (* applies when type in (REGION TYPE, DYNAMIC ACTION, ITEM TYPE, TEMPLATE COMPONENT) or property matches; type: FILE URLS JAVASCRIPT *)
<plugin-information> ::= <indent> "information" <ws> "{" <line-end> { <plugin-information-property-line> } <indent> "}" <line-end>
<plugin-information-property-line> ::= <indent> <plugin-information-property> <line-end>
<plugin-information-property> ::= "version" ":" <ws> <string-like-value> (* type: TEXT *)
  | "aboutUrl" ":" <ws> <string-like-value> (* type: TEXT *)
  | "helpText" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<plugin-subscription> ::= <indent> "subscription" <ws> "{" <line-end> { <plugin-subscription-property-line> } <indent> "}" <line-end>
<plugin-subscription-property-line> ::= <indent> <plugin-subscription-property> <line-end>
<plugin-subscription-property> ::= "master" ":" <ws> <string-like-value> (* type: SUBSCRIPTION *)
  | "subscribeComponentSettings" ":" <ws> <boolean> (* required; applies when master is set; type: YES NO *)
<plugin-comments> ::= <indent> "comments" <ws> "{" <line-end> { <plugin-comments-property-line> } <indent> "}" <line-end>
<plugin-comments-property-line> ::= <indent> <plugin-comments-property> <line-end>
<plugin-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<plugin-child-component> ::= <action-position>
  | <action-template>
  | <attribute-group>
  | <custom-attribute>
  | <event>
  | <file-b>
  | <slot-c>
  | <standard-attribute-config>

(* actionPosition *)
(* direct properties use default group: identification *)
<action-position> ::= "actionPosition" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-position-body-line> } <indent> ")" <line-end>
<action-position-body-line> ::= <action-position-direct-property-line>
  | <action-position-group-block>
<action-position-direct-property-line> ::= <indent> <action-position-direct-property> <line-end>
<action-position-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "apexlangName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "sequence" ":" <ws> <number> (* required; type: INTEGER *)
<action-position-group-block> ::= <action-position-position>
  | <action-position-help>
  | <action-position-advanced>
  | <action-position-comments>
<action-position-position> ::= <indent> "position" <ws> "{" <line-end> { <action-position-position-property-line> } <indent> "}" <line-end>
<action-position-position-property-line> ::= <indent> <action-position-position-property> <line-end>
<action-position-position-property> ::= "type" ":" <ws> ( "link" | "template" ) (* required; type: SELECT LIST *)
  | "predefinedTemplate" ":" <ws> <string-like-value> (* applies when type = TEMPLATE; type: SELECT LIST *)
<action-position-help> ::= <indent> "help" <ws> "{" <line-end> { <action-position-help-property-line> } <indent> "}" <line-end>
<action-position-help-property-line> ::= <indent> <action-position-help-property> <line-end>
<action-position-help-property> ::= "helpText" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<action-position-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <action-position-advanced-property-line> } <indent> "}" <line-end>
<action-position-advanced-property-line> ::= <indent> <action-position-advanced-property> <line-end>
<action-position-advanced-property> ::= "quickPick" ":" <ws> <boolean> (* required; type: YES NO *)
<action-position-comments> ::= <indent> "comments" <ws> "{" <line-end> { <action-position-comments-property-line> } <indent> "}" <line-end>
<action-position-comments-property-line> ::= <indent> <action-position-comments-property> <line-end>
<action-position-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* actionTemplate *)
(* direct properties use default group: identification *)
<action-template> ::= "actionTemplate" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-template-body-line> } <indent> ")" <line-end>
<action-template-body-line> ::= <action-template-direct-property-line>
  | <action-template-group-block>
<action-template-direct-property-line> ::= <indent> <action-template-direct-property> <line-end>
<action-template-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "apexlangName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> ( "button" | "menu" ) (* required; type: SELECT LIST *)
<action-template-group-block> ::= <action-template-template>
  | <action-template-help>
  | <action-template-advanced>
  | <action-template-comments>
<action-template-template> ::= <indent> "template" <ws> "{" <line-end> { <action-template-template-property-line> } <indent> "}" <line-end>
<action-template-template-property-line> ::= <indent> <action-template-template-property> <line-end>
<action-template-template-property> ::= "actionTemplate" ":" <ws> <multiline-string> (* required; type: HTML *)
<action-template-help> ::= <indent> "help" <ws> "{" <line-end> { <action-template-help-property-line> } <indent> "}" <line-end>
<action-template-help-property-line> ::= <indent> <action-template-help-property> <line-end>
<action-template-help-property> ::= "helpText" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<action-template-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <action-template-advanced-property-line> } <indent> "}" <line-end>
<action-template-advanced-property-line> ::= <indent> <action-template-advanced-property> <line-end>
<action-template-advanced-property> ::= "translatable" ":" <ws> <boolean> (* required; type: YES NO *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<action-template-comments> ::= <indent> "comments" <ws> "{" <line-end> { <action-template-comments-property-line> } <indent> "}" <line-end>
<action-template-comments-property-line> ::= <indent> <action-template-comments-property> <line-end>
<action-template-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* attributeGroup *)
(* direct properties use default group: identification *)
<attribute-group> ::= "attributeGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <attribute-group-body-line> } <indent> ")" <line-end>
<attribute-group-body-line> ::= <attribute-group-direct-property-line>
  | <attribute-group-group-block>
<attribute-group-direct-property-line> ::= <indent> <attribute-group-direct-property> <line-end>
<attribute-group-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "apexlangName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "sequence" ":" <ws> <number> (* required; type: INTEGER *)
<attribute-group-group-block> ::= <attribute-group-advanced>
<attribute-group-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <attribute-group-advanced-property-line> } <indent> "}" <line-end>
<attribute-group-advanced-property-line> ::= <indent> <attribute-group-advanced-property> <line-end>
<attribute-group-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)

(* customAttribute *)
(* direct properties use default group: identification *)
<custom-attribute> ::= "customAttribute" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <custom-attribute-body-line> } <indent> ")" <line-end>
<custom-attribute-body-line> ::= <custom-attribute-direct-property-line>
  | <custom-attribute-group-block>
  | <custom-attribute-child-component>
<custom-attribute-direct-property-line> ::= <indent> <custom-attribute-direct-property> <line-end>
<custom-attribute-direct-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "apexlangName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "attribute" ":" <ws> <number> (* required; type: INTEGER *)
  | "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "scope" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
  | "type" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
<custom-attribute-group-block> ::= <custom-attribute-component-lov>
  | <custom-attribute-validation>
  | <custom-attribute-security>
  | <custom-attribute-appearance>
  | <custom-attribute-builder>
  | <custom-attribute-template-support>
  | <custom-attribute-accessibility>
  | <custom-attribute-default>
  | <custom-attribute-supports>
  | <custom-attribute-depending-on>
  | <custom-attribute-help>
  | <custom-attribute-examples>
  | <custom-attribute-advanced>
  | <custom-attribute-comments>
<custom-attribute-component-lov> ::= <indent> "componentLov" <ws> "{" <line-end> { <custom-attribute-component-lov-property-line> } <indent> "}" <line-end>
<custom-attribute-component-lov-property-line> ::= <indent> <custom-attribute-component-lov-property> <line-end>
<custom-attribute-component-lov-property> ::= "type" ":" <ws> ( "static" | "component" ) (* required; applies when type in (SELECT LIST, CHECKBOXES); type: SELECT LIST *)
  | "componentType" ":" <ws> <string-like-value> (* applies when type = COMPONENT; type: SELECT LIST; large enum list omitted *)
  | "onDeleteBehavior" ":" <ws> ( "cascade" | "setToNull" ) (* applies when componentType is set; type: SELECT LIST *)
  | "nullText" ":" <ws> <string-like-value> (* applies when type in (SELECT LIST, COMPONENT) and required = N; type: TEXT *)
<custom-attribute-validation> ::= <indent> "validation" <ws> "{" <line-end> { <custom-attribute-validation-property-line> } <indent> "}" <line-end>
<custom-attribute-validation-property-line> ::= <indent> <custom-attribute-validation-property> <line-end>
<custom-attribute-validation-property> ::= "required" ":" <ws> <boolean> (* required; applies when type != CHECKBOX; type: YES NO *)
  | "maxLength" ":" <ws> <number> (* applies when type in (TEXT, TEXTAREA, NUMBER, INTEGER); type: NUMBER *)
  | "minColumns" ":" <ws> <number> (* applies when type = SQL; type: NUMBER *)
  | "maxColumns" ":" <ws> <number> (* applies when type = SQL; type: NUMBER *)
  | "textCase" ":" <ws> ( "uppercase" | "lowercase" ) (* applies when type in (TEXT, TEXTAREA); type: SELECT LIST *)
<custom-attribute-security> ::= <indent> "security" <ws> "{" <line-end> { <custom-attribute-security-property-line> } <indent> "}" <line-end>
<custom-attribute-security-property-line> ::= <indent> <custom-attribute-security-property> <line-end>
<custom-attribute-security-property> ::= "escapeMode" ":" <ws> ( "html" | "htmlAttribute" | "stripHtml" | "raw" ) (* required; applies when type = TEMPLATE COMPONENT; type: SELECT LIST *)
<custom-attribute-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <custom-attribute-appearance-property-line> } <indent> "}" <line-end>
<custom-attribute-appearance-property-line> ::= <indent> <custom-attribute-appearance-property> <line-end>
<custom-attribute-appearance-property> ::= "attributeGroup" ":" <ws> <string-like-value> (* applies when type in (TEMPLATE COMPONENT, DYNAMIC ACTION, ITEM TYPE, REGION TYPE, PROCESS TYPE, AI TOOL); type: SELECT LIST *)
  | "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<custom-attribute-builder> ::= <indent> "builder" <ws> "{" <line-end> { <custom-attribute-builder-property-line> } <indent> "}" <line-end>
<custom-attribute-builder-property-line> ::= <indent> <custom-attribute-builder-property> <line-end>
<custom-attribute-builder-property> ::= "common" ":" <ws> <boolean> (* required; type: YES NO *)
  | "showInWizard" ":" <ws> <boolean> (* required; applies when type != TEMPLATE COMPONENT; type: YES NO *)
  | "unit" ":" <ws> <string-like-value> (* applies when type in (TEXT, NUMBER, INTEGER); type: TEXT *)
  | "translatable" ":" <ws> <boolean> (* required; applies when type in (TEXT, TEXTAREA, HTML, XML); type: YES NO *)
  | "includeColumnsInItemsPicker" ":" <ws> <boolean> (* required; applies when type in (REGION TYPE, PROCESS TYPE) and type in (TEXT, TEXTAREA, HTML, XML, SQL, PLSQL, PLSQL EXPRESSION, PLSQL EXPRESSION BOOLEAN, PLSQL FUNCTION BODY, PLSQL FUNCTION BODY BOOLEAN, JAVASCRIPT, PAGE ITEM, PAGE ITEMS, LINK); type: YES NO *)
  | "displayWidth" ":" <ws> <number> (* applies when type != TEMPLATE COMPONENT and type in (TEXT, TEXTAREA, NUMBER, INTEGER); type: NUMBER *)
<custom-attribute-template-support> ::= <indent> "templateSupport" <ws> "{" <line-end> { <custom-attribute-template-support-property-line> } <indent> "}" <line-end>
<custom-attribute-template-support-property-line> ::= <indent> <custom-attribute-template-support-property> <line-end>
<custom-attribute-template-support-property> ::= "type" ":" <ws> ( "substitutions" | "templateDirectivesClient" | "templateDirectivesServer" ) (* applies when type != TEMPLATE COMPONENT; type: SELECT LIST *)
  | "customSubstitutions" ":" <ws> <array-of-string-like-value> (* applies when type in (TD_C, TD_S) and type in (HTML, TEXTAREA); type: TEXT *)
<custom-attribute-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <custom-attribute-accessibility-property-line> } <indent> "}" <line-end>
<custom-attribute-accessibility-property-line> ::= <indent> <custom-attribute-accessibility-property> <line-end>
<custom-attribute-accessibility-property> ::= "importantForAccessibility" ":" <ws> <boolean> (* required; type: YES NO *)
  | "helpText" ":" <ws> <multiline-string> (* applies when importantForAccessibility = Y; type: TEXT EDITOR *)
<custom-attribute-default> ::= <indent> "default" <ws> "{" <line-end> { <custom-attribute-default-property-line> } <indent> "}" <line-end>
<custom-attribute-default-property-line> ::= <indent> <custom-attribute-default-property> <line-end>
<custom-attribute-default-property> ::= "value" ":" <ws> <boolean> (* required; applies when type = CHECKBOX; type: YES NO *)
  | "value" ":" <ws> <multiline-string> (* required; applies when type not in (MEDIA, CHECKBOX); type: TEXT EDITOR *)
  | "sampleDataValue" ":" <ws> <multiline-string> (* applies when type in (TEMPLATE COMPONENT, REGION TYPE); type: TEXT EDITOR *)
<custom-attribute-supports> ::= <indent> "supports" <ws> "{" <line-end> { <custom-attribute-supports-property-line> } <indent> "}" <line-end>
<custom-attribute-supports-property-line> ::= <indent> <custom-attribute-supports-property> <line-end>
<custom-attribute-supports-property> ::= "components" ":" <ws> <array-of-string-like-value> (* applies when type = ITEM TYPE and scope != APPLICATION; type: CHECKBOXES *)
  | "components" ":" <ws> <array-of-string-like-value> (* applies when type = PROCESS TYPE and scope != APPLICATION; type: CHECKBOXES *)
  | "dataTypes" ":" <ws> <array-of-string-like-value> (* required; applies when type in (REGION SOURCE COLUMN, COLUMN, SESSION STATE VALUE); type: CHECKBOXES *)
<custom-attribute-depending-on> ::= <indent> "dependingOn" <ws> "{" <line-end> { <custom-attribute-depending-on-property-line> } <indent> "}" <line-end>
<custom-attribute-depending-on-property-line> ::= <indent> <custom-attribute-depending-on-property> <line-end>
<custom-attribute-depending-on-property> ::= "attribute" ":" <ws> <string-like-value> (* type: SELECT LIST *)
  | "conditionType" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; applies when attribute is set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when conditionType in (EQUALS, NOT_EQUALS); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when conditionType in (IN_LIST, NOT_IN_LIST); type: TEXT *)
  | "alwaysEvaluate" ":" <ws> <boolean> (* required; applies when attribute is set; type: YES NO *)
  | "parentAttribute" ":" <ws> <string-like-value> (* applies when type in (TABLE, COLUMN, PLSQL PACKAGE, PLSQL METHOD, REST OPERATION ID); type: SELECT LIST *)
<custom-attribute-help> ::= <indent> "help" <ws> "{" <line-end> { <custom-attribute-help-property-line> } <indent> "}" <line-end>
<custom-attribute-help-property-line> ::= <indent> <custom-attribute-help-property> <line-end>
<custom-attribute-help-property> ::= "helpText" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<custom-attribute-examples> ::= <indent> "examples" <ws> "{" <line-end> { <custom-attribute-examples-property-line> } <indent> "}" <line-end>
<custom-attribute-examples-property-line> ::= <indent> <custom-attribute-examples-property> <line-end>
<custom-attribute-examples-property> ::= "examples" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<custom-attribute-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <custom-attribute-advanced-property-line> } <indent> "}" <line-end>
<custom-attribute-advanced-property-line> ::= <indent> <custom-attribute-advanced-property> <line-end>
<custom-attribute-advanced-property> ::= "showDeprecatedAttributeForValues" ":" <ws> <array-of-string-like-value> (* type: TEXT *)
<custom-attribute-comments> ::= <indent> "comments" <ws> "{" <line-end> { <custom-attribute-comments-property-line> } <indent> "}" <line-end>
<custom-attribute-comments-property-line> ::= <indent> <custom-attribute-comments-property> <line-end>
