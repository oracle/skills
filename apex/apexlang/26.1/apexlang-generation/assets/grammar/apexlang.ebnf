  | <validation-a-group-block>
<validation-a-direct-property-line> ::= <indent> <validation-a-direct-property> <line-end>
<validation-a-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<validation-a-group-block> ::= <validation-a-execution>
  | <validation-a-validation>
  | <validation-a-error>
  | <validation-a-server-side-condition>
<validation-a-execution> ::= <indent> "execution" <ws> "{" <line-end> { <validation-a-execution-property-line> } <indent> "}" <line-end>
<validation-a-execution-property-line> ::= <indent> <validation-a-execution-property> <line-end>
<validation-a-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<validation-a-validation> ::= <indent> "validation" <ws> "{" <line-end> { <validation-a-validation-property-line> } <indent> "}" <line-end>
<validation-a-validation-property-line> ::= <indent> <validation-a-validation-property> <line-end>
<validation-a-validation-property> ::= "type" ":" <ws> ( "always" | "rowsReturned" | "noRowsReturned" | "expression" | "functionBody" | "never" ) (* type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
<validation-a-error> ::= <indent> "error" <ws> "{" <line-end> { <validation-a-error-property-line> } <indent> "}" <line-end>
<validation-a-error-property-line> ::= <indent> <validation-a-error-property> <line-end>
<validation-a-error-property> ::= "errorMessage" ":" <ws> <multiline-string> (* required; type: TEXT EDITOR *)
<validation-a-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <validation-a-server-side-condition-property-line> } <indent> "}" <line-end>
<validation-a-server-side-condition-property-line> ::= <indent> <validation-a-server-side-condition-property> <line-end>
<validation-a-server-side-condition-property> ::= "type" ":" <ws> ( "always" | "rowsReturned" | "noRowsReturned" | "expression" | "functionBody" | "never" ) (* type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)

(* taskDefinition *)
(* direct properties use default group: identification *)
<task-definition> ::= "taskDefinition" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <task-definition-body-line> } <indent> ")" <line-end>
<task-definition-body-line> ::= <task-definition-direct-property-line>
  | <task-definition-group-block>
  | <task-definition-child-component>
<task-definition-direct-property-line> ::= <indent> <task-definition-direct-property> <line-end>
<task-definition-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> ( "approval" | "action" ) (* required; type: SELECT LIST *)
<task-definition-group-block> ::= <task-definition-task>
  | <task-definition-deadline>
  | <task-definition-source>
  | <task-definition-column-mapping>
  | <task-definition-advanced>
  | <task-definition-comments>
<task-definition-task> ::= <indent> "task" <ws> "{" <line-end> { <task-definition-task-property-line> } <indent> "}" <line-end>
<task-definition-task-property-line> ::= <indent> <task-definition-task-property> <line-end>
<task-definition-task-property> ::= "subject" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "priority" ":" <ws> ( "1" | "2" | "3" | "4" | "5" ) (* required; type: SELECT LIST *)
  | "initiatorCanComplete" ":" <ws> <boolean> (* required; applies when type = APPROVAL; type: YES NO *)
<task-definition-deadline> ::= <indent> "deadline" <ws> "{" <line-end> { <task-definition-deadline-property-line> } <indent> "}" <line-end>
<task-definition-deadline-property-line> ::= <indent> <task-definition-deadline-property> <line-end>
<task-definition-deadline-property> ::= "dueOnType" ":" <ws> ( "interval" | "sqlQuery" | "expression" | "functionBody" | "schedulerExpression" ) (* type: SELECT LIST *)
  | "interval" ":" <ws> <string-like-value> (* required; applies when dueOnType = INTERVAL; type: TEXT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when dueOnType = SQL_QUERY; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when dueOnType = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when dueOnType = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "schedulerExpression" ":" <ws> <multiline-string> (* required; applies when dueOnType = SCHEDULER_EXPRESSION; type: TEXT EDITOR *)
  | "expirationPolicy" ":" <ws> ( "none" | "expire" | "renew" ) (* required; applies when dueOnType is set; type: SELECT LIST *)
  | "maxRenewalCount" ":" <ws> <number> (* required; applies when expirationPolicy = RENEW; type: NUMBER *)
<task-definition-source> ::= <indent> "source" <ws> "{" <line-end> { <task-definition-source-property-line> } <indent> "}" <line-end>
<task-definition-source-property-line> ::= <indent> <task-definition-source-property> <line-end>
<task-definition-source-property> ::= "type" ":" <ws> ( "none" | "tableView" | "sqlQuery" ) (* required; type: SELECT LIST *)
  | "tableOwner" ":" <ws> <string-like-value> (* applies when type = TABLE; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type = TABLE; type: TABLE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
<task-definition-column-mapping> ::= <indent> "columnMapping" <ws> "{" <line-end> { <task-definition-column-mapping-property-line> } <indent> "}" <line-end>
<task-definition-column-mapping-property-line> ::= <indent> <task-definition-column-mapping-property> <line-end>
<task-definition-column-mapping-property> ::= "primaryKeyColumn" ":" <ws> <string-like-value> (* applies when type = TABLE; type: COLUMN *)
<task-definition-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <task-definition-advanced-property-line> } <indent> "}" <line-end>
<task-definition-advanced-property-line> ::= <indent> <task-definition-advanced-property> <line-end>
<task-definition-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "vacationRuleProcedureName" ":" <ws> <string-like-value> (* type: TEXT *)
  | "detailsPage" ":" <ws> <value> (* type: LINK *)
<task-definition-comments> ::= <indent> "comments" <ws> "{" <line-end> { <task-definition-comments-property-line> } <indent> "}" <line-end>
<task-definition-comments-property-line> ::= <indent> <task-definition-comments-property> <line-end>
<task-definition-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<task-definition-child-component> ::= <action-b>
  | <parameter-g>
  | <participant-a>

(* action *)
(* direct properties use default group: identification *)
<action-b> ::= "action" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <action-b-body-line> } <indent> ")" <line-end>
<action-b-body-line> ::= <action-b-direct-property-line>
  | <action-b-group-block>
<action-b-direct-property-line> ::= <indent> <action-b-direct-property> <line-end>
<action-b-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<action-b-group-block> ::= <action-b-source>
  | <action-b-execution>
  | <action-b-success-message>
  | <action-b-error>
  | <action-b-advanced>
  | <action-b-server-side-condition>
  | <action-b-config>
  | <action-b-comments>
<action-b-source> ::= <indent> "source" <ws> "{" <line-end> { <action-b-source-property-line> } <indent> "}" <line-end>
<action-b-source-property-line> ::= <indent> <action-b-source-property> <line-end>
<action-b-source-property> ::= "location" ":" <ws> ( "localDatabase" | "restEnabledSql" ) (* required; applies when type = NATIVE_PLSQL; type: SELECT LIST *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when location = LOCAL; type: CODE LANGUAGE *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL *)
  | "javaScriptCode" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT *)
  | "remoteServer" ":" <ws> <reference> (* required; applies when location = REMOTE; type: COMPONENT *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when location = REMOTE; type: PLSQL *)
<action-b-execution> ::= <indent> "execution" <ws> "{" <line-end> { <action-b-execution-property-line> } <indent> "}" <line-end>
<action-b-execution-property-line> ::= <indent> <action-b-execution-property> <line-end>
<action-b-execution-property> ::= "onEvent" ":" <ws> ( "claim" | "complete" | "delegate" | "updateComment" | "updatePriority" | "updateParameter" | "release" | "cancel" | "create" | "requestInformation" | "submitInformation" | "beforeExpire" | "expire" ) (* required; type: SELECT LIST *)
  | "outcome" ":" <ws> ( "approved" | "rejected" ) (* applies when onEvent = COMPLETE and type = APPROVAL; type: SELECT LIST *)
  | "beforeExpirationInterval" ":" <ws> <string-like-value> (* applies when onEvent = BEFORE_EXPIRE; type: TEXT *)
  | "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<action-b-success-message> ::= <indent> "successMessage" <ws> "{" <line-end> { <action-b-success-message-property-line> } <indent> "}" <line-end>
<action-b-success-message-property-line> ::= <indent> <action-b-success-message-property> <line-end>
<action-b-success-message-property> ::= "successMessage" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<action-b-error> ::= <indent> "error" <ws> "{" <line-end> { <action-b-error-property-line> } <indent> "}" <line-end>
<action-b-error-property-line> ::= <indent> <action-b-error-property> <line-end>
<action-b-error-property> ::= "errorMessage" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
  | "logging" ":" <ws> ( "none" | "success" | "failure" | "all" ) (* required; type: SELECT LIST *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; type: YES NO *)
<action-b-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <action-b-advanced-property-line> } <indent> "}" <line-end>
<action-b-advanced-property-line> ::= <indent> <action-b-advanced-property> <line-end>
<action-b-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<action-b-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <action-b-server-side-condition-property-line> } <indent> "}" <line-end>
<action-b-server-side-condition-property-line> ::= <indent> <action-b-server-side-condition-property> <line-end>
<action-b-server-side-condition-property> ::= "type" ":" <ws> ( "rowsReturned" | "noRowsReturned" | "expression" | "functionBody" | "item=value" | "item!=value" | "itemIsNull" | "itemIsNotNull" | "itemIsZero" | "itemIsNotZero" | "itemIsNullOrZero" | "itemIsNotNullAndNotZero" | "itemContainsNoSpaces" | "itemIsNumeric" | "itemIsNotNumeric" | "itemIsAlphanumeric" | "itemIsInColonDelimitedList" | "itemIsNotInColonDelimitedList" | "textIsContainedInItem" | "text=value" | "text!=value" | "textIsContainedInValue" | "textIsNotContainedInValue" | "never" ) (* type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<action-b-config> ::= <indent> "config" <ws> "{" <line-end> { <action-b-config-property-line> } <indent> "}" <line-end>
<action-b-config-property-line> ::= <indent> <action-b-config-property> <line-end>
<action-b-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<action-b-comments> ::= <indent> "comments" <ws> "{" <line-end> { <action-b-comments-property-line> } <indent> "}" <line-end>
<action-b-comments-property-line> ::= <indent> <action-b-comments-property> <line-end>
<action-b-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-g> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-g-body-line> } <indent> ")" <line-end>
<parameter-g-body-line> ::= <parameter-g-direct-property-line>
  | <parameter-g-group-block>
<parameter-g-direct-property-line> ::= <indent> <parameter-g-direct-property> <line-end>
<parameter-g-direct-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "label" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "dataType" ":" <ws> ( "string" ) (* required; type: SELECT LIST *)
<parameter-g-group-block> ::= <parameter-g-validation>
  | <parameter-g-advanced>
  | <parameter-g-comments>
<parameter-g-validation> ::= <indent> "validation" <ws> "{" <line-end> { <parameter-g-validation-property-line> } <indent> "}" <line-end>
<parameter-g-validation-property-line> ::= <indent> <parameter-g-validation-property> <line-end>
<parameter-g-validation-property> ::= "required" ":" <ws> <boolean> (* required; type: YES NO *)
<parameter-g-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <parameter-g-advanced-property-line> } <indent> "}" <line-end>
<parameter-g-advanced-property-line> ::= <indent> <parameter-g-advanced-property> <line-end>
<parameter-g-advanced-property> ::= "showOnTaskDetails" ":" <ws> <boolean> (* required; type: YES NO *)
  | "updatable" ":" <ws> <boolean> (* required; type: YES NO *)
<parameter-g-comments> ::= <indent> "comments" <ws> "{" <line-end> { <parameter-g-comments-property-line> } <indent> "}" <line-end>
<parameter-g-comments-property-line> ::= <indent> <parameter-g-comments-property> <line-end>
<parameter-g-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* participant *)
(* direct properties use default group: identification *)
<participant-a> ::= "participant" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <participant-a-body-line> } <indent> ")" <line-end>
<participant-a-body-line> ::= <participant-a-direct-property-line>
  | <participant-a-group-block>
<participant-a-direct-property-line> ::= <indent> <participant-a-direct-property> <line-end>
<participant-a-direct-property> ::= "type" ":" <ws> ( "potentialOwner" | "businessAdministrator" | "excludedOwner" | "excludedAdmin" ) (* required; type: SELECT LIST *)
  | "identityType" ":" <ws> ( "user" | "authorizationScheme" ) (* required; type: SELECT LIST *)
<participant-a-group-block> ::= <participant-a-value>
<participant-a-value> ::= <indent> "value" <ws> "{" <line-end> { <participant-a-value-property-line> } <indent> "}" <line-end>
<participant-a-value-property-line> ::= <indent> <participant-a-value-property> <line-end>
<participant-a-value-property> ::= "type" ":" <ws> ( "staticValue" | "sqlQuery" | "expression" | "functionBody" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: TEXT EDITOR *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)

(* textMessage *)
(* direct properties use default group: identification *)
<text-message> ::= "textMessage" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <text-message-body-line> } <indent> ")" <line-end>
<text-message-body-line> ::= <text-message-direct-property-line>
  | <text-message-group-block>
<text-message-direct-property-line> ::= <indent> <text-message-direct-property> <line-end>
<text-message-direct-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<text-message-group-block> ::= <text-message-message>
  | <text-message-advanced>
  | <text-message-subscription>
  | <text-message-comments>
<text-message-message> ::= <indent> "message" <ws> "{" <line-end> { <text-message-message-property-line> } <indent> "}" <line-end>
<text-message-message-property-line> ::= <indent> <text-message-message-property> <line-end>
<text-message-message-property> ::= "text" ":" <ws> <multiline-string> (* required; type: TEXT EDITOR *)
  | "language" ":" <ws> <string-like-value> (* required; type: SELECT LIST; large enum list omitted *)
  | "usedInJavaScript" ":" <ws> <boolean> (* required; type: YES NO *)
<text-message-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <text-message-advanced-property-line> } <indent> "}" <line-end>
<text-message-advanced-property-line> ::= <indent> <text-message-advanced-property> <line-end>
<text-message-advanced-property> ::= "metadata" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<text-message-subscription> ::= <indent> "subscription" <ws> "{" <line-end> { <text-message-subscription-property-line> } <indent> "}" <line-end>
<text-message-subscription-property-line> ::= <indent> <text-message-subscription-property> <line-end>
<text-message-subscription-property> ::= "master" ":" <ws> <string-like-value> (* type: SUBSCRIPTION *)
<text-message-comments> ::= <indent> "comments" <ws> "{" <line-end> { <text-message-comments-property-line> } <indent> "}" <line-end>
<text-message-comments-property-line> ::= <indent> <text-message-comments-property> <line-end>
<text-message-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* theme *)
(* direct properties use default group: identification *)
<theme> ::= "theme" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <theme-body-line> } <indent> ")" <line-end>
<theme-body-line> ::= <theme-direct-property-line>
  | <theme-group-block>
  | <theme-child-component>
<theme-direct-property-line> ::= <indent> <theme-direct-property> <line-end>
<theme-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "themeNumber" ":" <ws> <number> (* type: INTEGER *)
  | "baseTheme" ":" <ws> ( "ut-24.2" | "ut-26.1" ) (* type: SELECT LIST *)
  | "version" ":" <ws> <string-like-value> (* applies when baseTheme is not set or master is set; type: TEXT *)
<theme-group-block> ::= <theme-style>
  | <theme-java-script>
