<connection-a-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SELECT LIST *)
<connection-a-group-block> ::= <connection-a-execution>
  | <connection-a-activity>
  | <connection-a-condition>
  | <connection-a-config>
  | <connection-a-advanced>
  | <connection-a-comments>
