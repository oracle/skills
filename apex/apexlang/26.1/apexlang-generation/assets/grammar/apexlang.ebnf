  | "region" ":" <ws> <reference> (* required; applies when selectionType = REGION; type: COMPONENT *)
  | "button" ":" <ws> <reference> (* required; applies when selectionType = BUTTON; type: COMPONENT *)
  | "items" ":" <ws> <array-of-string-like-value> (* required; applies when selectionType = ITEM; type: ITEM *)
  | "jquerySelector" ":" <ws> <string-like-value> (* required; applies when selectionType = JQUERY_SELECTOR; type: TEXT *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when selectionType = JAVASCRIPT_EXPRESSION; type: JAVASCRIPT *)
<trigger-action-f-execution> ::= <indent> "execution" <ws> "{" <line-end> { <trigger-action-f-execution-property-line> } <indent> "}" <line-end>
<trigger-action-f-execution-property-line> ::= <indent> <trigger-action-f-execution-property> <line-end>
<trigger-action-f-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "stopExecutionOnError" ":" <ws> <boolean> (* required; applies when action supports STOP_EXECUTION_ON_ERROR; type: YES NO *)
  | "waitForResult" ":" <ws> <boolean> (* required; applies when action supports WAIT_FOR_RESULT; type: YES NO *)
<trigger-action-f-client-side-condition> ::= <indent> "clientSideCondition" <ws> "{" <line-end> { <trigger-action-f-client-side-condition-property-line> } <indent> "}" <line-end>
<trigger-action-f-client-side-condition-property-line> ::= <indent> <trigger-action-f-client-side-condition-property> <line-end>
<trigger-action-f-client-side-condition-property> ::= "type" ":" <ws> ( "item=value" | "item!=value" | "item>value" | "item>=value" | "item<value" | "item<=value" | "itemIsNull" | "itemIsNotNull" | "itemIsInList" | "itemIsNotInList" | "jsExpression" ) (* type: SELECT LIST *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS, GREATER_THAN, GREATER_THAN_OR_EQUAL, LESS_THAN, LESS_THAN_OR_EQUAL, NULL, NOT_NULL, IN_LIST, NOT_IN_LIST); type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS, GREATER_THAN, GREATER_THAN_OR_EQUAL, LESS_THAN, LESS_THAN_OR_EQUAL); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when type = JAVASCRIPT_EXPRESSION; type: JAVASCRIPT *)
<trigger-action-f-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <trigger-action-f-server-side-condition-property-line> } <indent> "}" <line-end>
<trigger-action-f-server-side-condition-property-line> ::= <indent> <trigger-action-f-server-side-condition-property> <line-end>
<trigger-action-f-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<trigger-action-f-security> ::= <indent> "security" <ws> "{" <line-end> { <trigger-action-f-security-property-line> } <indent> "}" <line-end>
<trigger-action-f-security-property-line> ::= <indent> <trigger-action-f-security-property> <line-end>
<trigger-action-f-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<trigger-action-f-config> ::= <indent> "config" <ws> "{" <line-end> { <trigger-action-f-config-property-line> } <indent> "}" <line-end>
<trigger-action-f-config-property-line> ::= <indent> <trigger-action-f-config-property> <line-end>
<trigger-action-f-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<trigger-action-f-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <trigger-action-f-advanced-property-line> } <indent> "}" <line-end>
<trigger-action-f-advanced-property-line> ::= <indent> <trigger-action-f-advanced-property> <line-end>
<trigger-action-f-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "initJavaScriptFunction" ":" <ws> <multiline-string> (* applies when action supports INIT_JAVASCRIPT_CODE; type: JAVASCRIPT *)
<trigger-action-f-comments> ::= <indent> "comments" <ws> "{" <line-end> { <trigger-action-f-comments-property-line> } <indent> "}" <line-end>
<trigger-action-f-comments-property-line> ::= <indent> <trigger-action-f-comments-property> <line-end>
<trigger-action-f-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* column *)
(* direct properties use default group: identification *)
<column-c> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-c-body-line> } <indent> ")" <line-end>
<column-c-body-line> ::= <column-c-direct-property-line>
  | <column-c-group-block>
<column-c-direct-property-line> ::= <indent> <column-c-direct-property> <line-end>
<column-c-direct-property> ::= "columnName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "reportColumnQueryId" ":" <ws> <string-like-value> (* type: HIDDEN *)
  | "derivedColumn" ":" <ws> <string-like-value> (* type: HIDDEN *)
  | "type" ":" <ws> ( "plainText" | "plainTextBasedOnLov" | "richText" | "link" | "displayImage" | "downloadBlob" | "percentGraph" | "hidden" | "displayAsTextSavesState" | "datePickerClassic" | "datePicker" | "textField" | "textArea" | "selectList" | "radioGroup" | "hiddenField" | "popupLov" | "popupKeyLov" | "simpleCheckbox" | "rowSelector" ) (* required; type: SELECT LIST *)
<column-c-group-block> ::= <column-c-heading>
  | <column-c-lov>
  | <column-c-layout>
  | <column-c-accessibility>
  | <column-c-appearance>
  | <column-c-settings>
  | <column-c-blob-attributes>
  | <column-c-link>
  | <column-c-element>
  | <column-c-column-formatting>
  | <column-c-sorting>
  | <column-c-export-printing>
  | <column-c-advanced>
  | <column-c-ui-defaults-reference>
  | <column-c-server-side-condition>
  | <column-c-security>
  | <column-c-config>
  | <column-c-comments>
<column-c-heading> ::= <indent> "heading" <ws> "{" <line-end> { <column-c-heading-property-line> } <indent> "}" <line-end>
<column-c-heading-property-line> ::= <indent> <column-c-heading-property> <line-end>
<column-c-heading-property> ::= "heading" ":" <ws> <string-like-value> (* applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: TEXT *)
  | "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: PILL BUTTONS *)
<column-c-lov> ::= <indent> "lov" <ws> "{" <line-end> { <column-c-lov-property-line> } <indent> "}" <line-end>
<column-c-lov-property-line> ::= <indent> <column-c-lov-property> <line-end>
<column-c-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type in (PLAIN_LOV, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY); type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "checkboxValues" ":" <ws> <string-like-value> (* required; applies when type = SIMPLE_CHECKBOX; type: TEXT *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; applies when type in (SELECT_LIST, RADIOGROUP); type: YES NO *)
  | "displayNullValue" ":" <ws> <boolean> (* required; applies when type in (SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY); type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
  | "nullReturnValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
<column-c-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-c-layout-property-line> } <indent> "}" <line-end>
<column-c-layout-property-line> ::= <indent> <column-c-layout-property> <line-end>
<column-c-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: PILL BUTTONS *)
<column-c-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <column-c-accessibility-property-line> } <indent> "}" <line-end>
<column-c-accessibility-property-line> ::= <indent> <column-c-accessibility-property> <line-end>
<column-c-accessibility-property> ::= "valueIdentifiesRow" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD, PCT_GRAPH, ROW_SELECTOR, RICH_TEXT); type: YES NO *)
  | "imageDescription" ":" <ws> <string-like-value> (* applies when type = IMAGE; type: TEXT *)
<column-c-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-c-appearance-property-line> } <indent> "}" <line-end>
<column-c-appearance-property-line> ::= <indent> <column-c-appearance-property> <line-end>
<column-c-appearance-property> ::= "formatMask" ":" <ws> <string-like-value> (* applies when type in (PLAIN, LINK, DISPLAY_AND_SAVE, TEXT, DATE_PICKER); type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* required; applies when type = DATE_POPUP; type: SELECT LIST; large enum list omitted *)
  | "backgroundColor" ":" <ws> <string-like-value> (* applies when type = PCT_GRAPH; type: COLOR *)
  | "foregroundColor" ":" <ws> <string-like-value> (* applies when type = PCT_GRAPH; type: COLOR *)
  | "barWidth" ":" <ws> <number> (* applies when type = PCT_GRAPH; type: INTEGER *)
  | "width" ":" <ws> <number> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, POPUP, POPUPKEY); type: NUMBER *)
  | "height" ":" <ws> <number> (* applies when type = TEXTAREA; type: NUMBER *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; applies when type = DOWNLOAD; type: SELECT LIST *)
  | "template" ":" <ws> <reference> (* applies when type in (DISPLAY_AND_SAVE, TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMPONENT *)
  | "downloadText" ":" <ws> <string-like-value> (* applies when type = DOWNLOAD; type: TEXT *)
<column-c-settings> ::= <indent> "settings" <ws> "{" <line-end> { <column-c-settings-property-line> } <indent> "}" <line-end>
<column-c-settings-property-line> ::= <indent> <column-c-settings-property> <line-end>
<column-c-settings-property> ::= "format" ":" <ws> ( "html" | "markdown" ) (* required; applies when type = RICH_TEXT; type: SELECT LIST *)
<column-c-blob-attributes> ::= <indent> "blobAttributes" <ws> "{" <line-end> { <column-c-blob-attributes-property-line> } <indent> "}" <line-end>
<column-c-blob-attributes-property-line> ::= <indent> <column-c-blob-attributes-property> <line-end>
<column-c-blob-attributes-property> ::= "tableOwner" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: TABLE *)
  | "blobColumn" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn1" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn2" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "mimeTypeColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "filenameColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "lastUpdatedColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "charSetColumn" ":" <ws> <string-like-value> (* applies when type = DOWNLOAD; type: COLUMN *)
<column-c-link> ::= <indent> "link" <ws> "{" <line-end> { <column-c-link-property-line> } <indent> "}" <line-end>
<column-c-link-property-line> ::= <indent> <column-c-link-property> <line-end>
<column-c-link-property> ::= "target" ":" <ws> <value> (* applies when type in (LINK, PCT_GRAPH); type: LINK *)
  | "linkText" ":" <ws> <string-like-value> (* required; applies when target is set; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when target is set; type: TEXT *)
<column-c-element> ::= <indent> "element" <ws> "{" <line-end> { <column-c-element-property-line> } <indent> "}" <line-end>
<column-c-element-property-line> ::= <indent> <column-c-element-property> <line-end>
<column-c-element-property> ::= "numberOfColumns" ":" <ws> <number> (* applies when type = RADIOGROUP; type: INTEGER *)
<column-c-column-formatting> ::= <indent> "columnFormatting" <ws> "{" <line-end> { <column-c-column-formatting-property-line> } <indent> "}" <line-end>
<column-c-column-formatting-property-line> ::= <indent> <column-c-column-formatting-property> <line-end>
<column-c-column-formatting-property> ::= "htmlExpression" ":" <ws> <multiline-string> (* applies when type = PLAIN; type: HTML *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type in (PLAIN, LINK, PCT_GRAPH); type: COMBOBOX *)
  | "cssStyle" ":" <ws> <array-of-string-like-value> (* applies when type in (PLAIN, LINK, PCT_GRAPH); type: COMBOBOX *)
  | "highlightWords" ":" <ws> <string-like-value> (* applies when type = PLAIN; type: TEXT *)
<column-c-sorting> ::= <indent> "sorting" <ws> "{" <line-end> { <column-c-sorting-property-line> } <indent> "}" <line-end>
<column-c-sorting-property-line> ::= <indent> <column-c-sorting-property> <line-end>
<column-c-sorting-property> ::= "defaultSequence" ":" <ws> ( "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" ) (* applies when type not in (ROW_SELECTOR); type: SELECT LIST *)
  | "direction" ":" <ws> ( "desc" ) (* applies when defaultSequence is set; type: SELECT LIST *)
  | "sortable" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, ROW_SELECTOR); type: YES NO *)
<column-c-export-printing> ::= <indent> "exportPrinting" <ws> "{" <line-end> { <column-c-export-printing-property-line> } <indent> "}" <line-end>
<column-c-export-printing-property-line> ::= <indent> <column-c-export-printing-property> <line-end>
<column-c-export-printing-property> ::= "includeInExportPrint" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, ROW_SELECTOR); type: YES NO *)
  | "printWidth" ":" <ws> <string-like-value> (* applies when includeInExportPrint = Y; type: TEXT *)
<column-c-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-c-advanced-property-line> } <indent> "}" <line-end>
<column-c-advanced-property-line> ::= <indent> <column-c-advanced-property> <line-end>
<column-c-advanced-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMBOBOX *)
  | "customAttributes" ":" <ws> <string-like-value> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMBOBOX *)
  | "cellWidth" ":" <ws> <number> (* applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: INTEGER *)
  | "computeSum" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD, ROW_SELECTOR, DATE_POPUP, DATE_PICKER, RICH_TEXT); type: YES NO *)
<column-c-ui-defaults-reference> ::= <indent> "uiDefaultsReference" <ws> "{" <line-end> { <column-c-ui-defaults-reference-property-line> } <indent> "}" <line-end>
<column-c-ui-defaults-reference-property-line> ::= <indent> <column-c-ui-defaults-reference-property> <line-end>
<column-c-ui-defaults-reference-property> ::= "tableOwner" ":" <ws> <string-like-value> (* applies when derivedColumn = N; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* type: TABLE *)
  | "column" ":" <ws> <string-like-value> (* type: COLUMN *)
<column-c-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-c-server-side-condition-property-line> } <indent> "}" <line-end>
<column-c-server-side-condition-property-line> ::= <indent> <column-c-server-side-condition-property> <line-end>
<column-c-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-c-security> ::= <indent> "security" <ws> "{" <line-end> { <column-c-security-property-line> } <indent> "}" <line-end>
<column-c-security-property-line> ::= <indent> <column-c-security-property> <line-end>
<column-c-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type in (PLAIN, LINK, HIDDEN_COLUMN, PLAIN_LOV); type: YES NO *)
<column-c-config> ::= <indent> "config" <ws> "{" <line-end> { <column-c-config-property-line> } <indent> "}" <line-end>
<column-c-config-property-line> ::= <indent> <column-c-config-property> <line-end>
<column-c-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-c-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-c-comments-property-line> } <indent> "}" <line-end>
<column-c-comments-property-line> ::= <indent> <column-c-comments-property> <line-end>
<column-c-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* column *)
(* direct properties use default group: identification *)
<column-d> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-d-body-line> } <indent> ")" <line-end>
<column-d-body-line> ::= <column-d-direct-property-line>
  | <column-d-group-block>
<column-d-direct-property-line> ::= <indent> <column-d-direct-property> <line-end>
<column-d-direct-property> ::= "columnName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "reportColumnQueryId" ":" <ws> <string-like-value> (* type: HIDDEN *)
  | "derivedColumn" ":" <ws> <string-like-value> (* type: HIDDEN *)
  | "type" ":" <ws> ( "rowSelector" | "plainText" | "plainTextSavesState" | "plainTextBasedOnLov" | "link" | "displayImage" | "downloadBlob" | "percentGraph" | "textField" | "textArea" | "selectList" | "popupLovShowsDisplaysValue" | "popupLovShowsReturnValue" | "radioGroup" | "simpleCheckbox" | "datePicker" | "datePickerClassic" | "hidden" | "hiddenSavesState" ) (* required; type: SELECT LIST *)
<column-d-group-block> ::= <column-d-heading>
  | <column-d-lov>
  | <column-d-layout>
  | <column-d-accessibility>
  | <column-d-appearance>
  | <column-d-blob-attributes>
  | <column-d-link>
  | <column-d-element>
  | <column-d-column-formatting>
  | <column-d-default>
  | <column-d-primary-key-source>
  | <column-d-sorting>
  | <column-d-export-printing>
  | <column-d-advanced>
  | <column-d-ui-defaults-reference>
  | <column-d-server-side-condition>
  | <column-d-security>
  | <column-d-config>
  | <column-d-comments>
<column-d-heading> ::= <indent> "heading" <ws> "{" <line-end> { <column-d-heading-property-line> } <indent> "}" <line-end>
<column-d-heading-property-line> ::= <indent> <column-d-heading-property> <line-end>
<column-d-heading-property> ::= "heading" ":" <ws> <string-like-value> (* applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: TEXT *)
  | "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: PILL BUTTONS *)
<column-d-lov> ::= <indent> "lov" <ws> "{" <line-end> { <column-d-lov-property-line> } <indent> "}" <line-end>
<column-d-lov-property-line> ::= <indent> <column-d-lov-property> <line-end>
<column-d-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type in (PLAIN_LOV, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY); type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "checkboxValues" ":" <ws> <string-like-value> (* required; applies when type = SIMPLE_CHECKBOX; type: TEXT *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; applies when type in (SELECT_LIST, RADIOGROUP); type: YES NO *)
  | "displayNullValue" ":" <ws> <boolean> (* required; applies when type in (SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY); type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
  | "nullReturnValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
<column-d-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-d-layout-property-line> } <indent> "}" <line-end>
<column-d-layout-property-line> ::= <indent> <column-d-layout-property> <line-end>
<column-d-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: PILL BUTTONS *)
<column-d-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <column-d-accessibility-property-line> } <indent> "}" <line-end>
<column-d-accessibility-property-line> ::= <indent> <column-d-accessibility-property> <line-end>
<column-d-accessibility-property> ::= "valueIdentifiesRow" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD, PCT_GRAPH, ROW_SELECTOR); type: YES NO *)
  | "imageDescription" ":" <ws> <string-like-value> (* applies when type = IMAGE; type: TEXT *)
<column-d-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-d-appearance-property-line> } <indent> "}" <line-end>
<column-d-appearance-property-line> ::= <indent> <column-d-appearance-property> <line-end>
<column-d-appearance-property> ::= "formatMask" ":" <ws> <string-like-value> (* applies when type in (PLAIN, LINK, DISPLAY_AND_SAVE, TEXT, DATE_PICKER); type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* required; applies when type = DATE_POPUP; type: SELECT LIST; large enum list omitted *)
  | "backgroundColor" ":" <ws> <string-like-value> (* applies when type = PCT_GRAPH; type: COLOR *)
  | "foregroundColor" ":" <ws> <string-like-value> (* applies when type = PCT_GRAPH; type: COLOR *)
  | "barWidth" ":" <ws> <number> (* applies when type = PCT_GRAPH; type: INTEGER *)
  | "width" ":" <ws> <number> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, POPUP, POPUPKEY); type: NUMBER *)
  | "height" ":" <ws> <number> (* applies when type = TEXTAREA; type: NUMBER *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; applies when type = DOWNLOAD; type: SELECT LIST *)
  | "template" ":" <ws> <reference> (* applies when type in (DISPLAY_AND_SAVE, TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMPONENT *)
  | "downloadText" ":" <ws> <string-like-value> (* applies when type = DOWNLOAD; type: TEXT *)
<column-d-blob-attributes> ::= <indent> "blobAttributes" <ws> "{" <line-end> { <column-d-blob-attributes-property-line> } <indent> "}" <line-end>
<column-d-blob-attributes-property-line> ::= <indent> <column-d-blob-attributes-property> <line-end>
<column-d-blob-attributes-property> ::= "tableOwner" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: TABLE *)
  | "blobColumn" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn1" ":" <ws> <string-like-value> (* required; applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "primaryKeyColumn2" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "mimeTypeColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "filenameColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "lastUpdatedColumn" ":" <ws> <string-like-value> (* applies when type in (IMAGE, DOWNLOAD); type: COLUMN *)
  | "charSetColumn" ":" <ws> <string-like-value> (* applies when type = DOWNLOAD; type: COLUMN *)
<column-d-link> ::= <indent> "link" <ws> "{" <line-end> { <column-d-link-property-line> } <indent> "}" <line-end>
<column-d-link-property-line> ::= <indent> <column-d-link-property> <line-end>
<column-d-link-property> ::= "target" ":" <ws> <value> (* applies when type in (LINK, PCT_GRAPH); type: LINK *)
  | "linkText" ":" <ws> <string-like-value> (* required; applies when target is set; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when target is set; type: TEXT *)
<column-d-element> ::= <indent> "element" <ws> "{" <line-end> { <column-d-element-property-line> } <indent> "}" <line-end>
<column-d-element-property-line> ::= <indent> <column-d-element-property> <line-end>
<column-d-element-property> ::= "numberOfColumns" ":" <ws> <number> (* applies when type = RADIOGROUP; type: INTEGER *)
<column-d-column-formatting> ::= <indent> "columnFormatting" <ws> "{" <line-end> { <column-d-column-formatting-property-line> } <indent> "}" <line-end>
<column-d-column-formatting-property-line> ::= <indent> <column-d-column-formatting-property> <line-end>
<column-d-column-formatting-property> ::= "htmlExpression" ":" <ws> <multiline-string> (* applies when type = PLAIN; type: HTML *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type in (PLAIN, LINK, PCT_GRAPH); type: COMBOBOX *)
  | "cssStyle" ":" <ws> <array-of-string-like-value> (* applies when type in (PLAIN, LINK, PCT_GRAPH); type: COMBOBOX *)
  | "highlightWords" ":" <ws> <string-like-value> (* applies when type = PLAIN; type: TEXT *)
<column-d-default> ::= <indent> "default" <ws> "{" <line-end> { <column-d-default-property-line> } <indent> "}" <line-end>
<column-d-default-property-line> ::= <indent> <column-d-default-property> <line-end>
<column-d-default-property> ::= "type" ":" <ws> ( "item" | "plsqlExpression" ) (* applies when type in (DISPLAY_AND_SAVE, DATE_POPUP, DATE_PICKER, TEXT, TEXTAREA, SELECT_LIST, RADIOGROUP, HIDDEN_FIELD, POPUP, POPUPKEY, SIMPLE_CHECKBOX, ROW_SELECTOR); type: SELECT LIST *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when type = FUNCTION *)
<column-d-primary-key-source> ::= <indent> "primaryKeySource" <ws> "{" <line-end> { <column-d-primary-key-source-property-line> } <indent> "}" <line-end>
<column-d-primary-key-source-property-line> ::= <indent> <column-d-primary-key-source-property> <line-end>
<column-d-primary-key-source-property> ::= "type" ":" <ws> ( "existingTrigger" | "plsqlExpression" | "existingSequence" ) (* applies when type != ROW_SELECTOR; type: SELECT LIST *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = S; type: TEXT *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when type = F *)
<column-d-sorting> ::= <indent> "sorting" <ws> "{" <line-end> { <column-d-sorting-property-line> } <indent> "}" <line-end>
<column-d-sorting-property-line> ::= <indent> <column-d-sorting-property> <line-end>
<column-d-sorting-property> ::= "defaultSequence" ":" <ws> ( "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" ) (* applies when type not in (ROW_SELECTOR); type: SELECT LIST *)
  | "direction" ":" <ws> ( "desc" ) (* applies when defaultSequence is set; type: SELECT LIST *)
  | "sortable" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, ROW_SELECTOR); type: YES NO *)
<column-d-export-printing> ::= <indent> "exportPrinting" <ws> "{" <line-end> { <column-d-export-printing-property-line> } <indent> "}" <line-end>
<column-d-export-printing-property-line> ::= <indent> <column-d-export-printing-property> <line-end>
<column-d-export-printing-property> ::= "includeInExportPrint" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, ROW_SELECTOR); type: YES NO *)
  | "printWidth" ":" <ws> <string-like-value> (* applies when includeInExportPrint = Y; type: TEXT *)
<column-d-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-d-advanced-property-line> } <indent> "}" <line-end>
<column-d-advanced-property-line> ::= <indent> <column-d-advanced-property> <line-end>
<column-d-advanced-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMBOBOX *)
  | "customAttributes" ":" <ws> <string-like-value> (* applies when type in (TEXT, TEXTAREA, DATE_POPUP, DATE_PICKER, HIDDEN_FIELD, SELECT_LIST, RADIOGROUP, POPUP, POPUPKEY, SIMPLE_CHECKBOX); type: COMBOBOX *)
  | "cellWidth" ":" <ws> <number> (* applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD); type: INTEGER *)
  | "computeSum" ":" <ws> <boolean> (* required; applies when type not in (HIDDEN_COLUMN, HIDDEN_FIELD, ROW_SELECTOR, DATE_POPUP, DATE_PICKER); type: YES NO *)
<column-d-ui-defaults-reference> ::= <indent> "uiDefaultsReference" <ws> "{" <line-end> { <column-d-ui-defaults-reference-property-line> } <indent> "}" <line-end>
<column-d-ui-defaults-reference-property-line> ::= <indent> <column-d-ui-defaults-reference-property> <line-end>
<column-d-ui-defaults-reference-property> ::= "tableOwner" ":" <ws> <string-like-value> (* applies when derivedColumn = N; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* type: TABLE *)
  | "column" ":" <ws> <string-like-value> (* type: COLUMN *)
<column-d-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-d-server-side-condition-property-line> } <indent> "}" <line-end>
<column-d-server-side-condition-property-line> ::= <indent> <column-d-server-side-condition-property> <line-end>
<column-d-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-d-security> ::= <indent> "security" <ws> "{" <line-end> { <column-d-security-property-line> } <indent> "}" <line-end>
<column-d-security-property-line> ::= <indent> <column-d-security-property> <line-end>
<column-d-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type in (PLAIN, LINK, HIDDEN_COLUMN, PLAIN_LOV); type: YES NO *)
<column-d-config> ::= <indent> "config" <ws> "{" <line-end> { <column-d-config-property-line> } <indent> "}" <line-end>
<column-d-config-property-line> ::= <indent> <column-d-config-property> <line-end>
<column-d-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-d-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-d-comments-property-line> } <indent> "}" <line-end>
<column-d-comments-property-line> ::= <indent> <column-d-comments-property> <line-end>
<column-d-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* column *)
(* direct properties use default group: identification *)
<column-e> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-e-body-line> } <indent> ")" <line-end>
<column-e-body-line> ::= <column-e-direct-property-line>
  | <column-e-group-block>
<column-e-direct-property-line> ::= <indent> <column-e-direct-property> <line-end>
<column-e-direct-property> ::= "columnName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "show" ":" <ws> <boolean> (* required; type: YES NO *)
<column-e-group-block> ::= <column-e-source>
  | <column-e-heading>
  | <column-e-layout>
  | <column-e-appearance>
  | <column-e-advanced>
  | <column-e-server-side-condition>
  | <column-e-security>
  | <column-e-config>
  | <column-e-comments>
<column-e-source> ::= <indent> "source" <ws> "{" <line-end> { <column-e-source-property-line> } <indent> "}" <line-end>
<column-e-source-property-line> ::= <indent> <column-e-source-property> <line-end>
<column-e-source-property> ::= "dataType" ":" <ws> <string-like-value> (* required; type: TEXT *)
<column-e-heading> ::= <indent> "heading" <ws> "{" <line-end> { <column-e-heading-property-line> } <indent> "}" <line-end>
<column-e-heading-property-line> ::= <indent> <column-e-heading-property> <line-end>
<column-e-heading-property> ::= "heading" ":" <ws> <string-like-value> (* applies when type supports COLUMN_HEADING and show = Y; type: TEXT *)
  | "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type supports HEADING_ALIGNMENT and show = Y; type: PILL BUTTONS *)
<column-e-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-e-layout-property-line> } <indent> "}" <line-end>
<column-e-layout-property-line> ::= <indent> <column-e-layout-property> <line-end>
<column-e-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type supports VALUE_ALIGNMENT and show = Y; type: PILL BUTTONS *)
<column-e-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-e-appearance-property-line> } <indent> "}" <line-end>
<column-e-appearance-property-line> ::= <indent> <column-e-appearance-property> <line-end>
<column-e-appearance-property> ::= "formatMask" ":" <ws> <string-like-value> (* applies when dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when dataType = NUMBER; type: COMBOBOX *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type supports VALUE_CSS and show = Y; type: COMBOBOX *)
<column-e-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-e-advanced-property-line> } <indent> "}" <line-end>
<column-e-advanced-property-line> ::= <indent> <column-e-advanced-property> <line-end>
<column-e-advanced-property> ::= "customAttributes" ":" <ws> <string-like-value> (* applies when type supports VALUE_ATTRIBUTE and show = Y; type: COMBOBOX *)
<column-e-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-e-server-side-condition-property-line> } <indent> "}" <line-end>
<column-e-server-side-condition-property-line> ::= <indent> <column-e-server-side-condition-property> <line-end>
<column-e-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* applies when show = Y; type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-e-security> ::= <indent> "security" <ws> "{" <line-end> { <column-e-security-property-line> } <indent> "}" <line-end>
<column-e-security-property-line> ::= <indent> <column-e-security-property> <line-end>
<column-e-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* applies when show = Y; type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports VALUE_ESCAPE_OUTPUT; type: YES NO *)
<column-e-config> ::= <indent> "config" <ws> "{" <line-end> { <column-e-config-property-line> } <indent> "}" <line-end>
<column-e-config-property-line> ::= <indent> <column-e-config-property> <line-end>
<column-e-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-e-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-e-comments-property-line> } <indent> "}" <line-end>
<column-e-comments-property-line> ::= <indent> <column-e-comments-property> <line-end>
<column-e-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* column *)
(* direct properties use default group: identification *)
<column-f> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-f-body-line> } <indent> ")" <line-end>
<column-f-body-line> ::= <column-f-direct-property-line>
  | <column-f-group-block>
<column-f-direct-property-line> ::= <indent> <column-f-direct-property> <line-end>
<column-f-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<column-f-group-block> ::= <column-f-layout>
  | <column-f-source>
  | <column-f-lov>
  | <column-f-accessibility>
  | <column-f-appearance>
  | <column-f-server-side-condition>
  | <column-f-security>
  | <column-f-config>
  | <column-f-comments>
<column-f-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-f-layout-property-line> } <indent> "}" <line-end>
<column-f-layout-property-line> ::= <indent> <column-f-layout-property> <line-end>
<column-f-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<column-f-source> ::= <indent> "source" <ws> "{" <line-end> { <column-f-source-property-line> } <indent> "}" <line-end>
<column-f-source-property-line> ::= <indent> <column-f-source-property> <line-end>
<column-f-source-property> ::= "type" ":" <ws> ( "databaseColumn" | "sqlExpression" | "none" ) (* required; type: SELECT LIST *)
  | "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type = DB_COLUMN; type: TEXT *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when type = SQL_EXPRESSION; type: SQL EXPRESSION *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type != NONE; type: SELECT LIST *)
  | "primaryKey" ":" <ws> <boolean> (* required; applies when type = DB_COLUMN and dataType not in (BLOB, CLOB, BFILE, SDO_GEOMETRY); type: YES NO *)
  | "availableOnClient" ":" <ws> <boolean> (* required; applies when primaryKey = N and dataType not in (BLOB, CLOB, BFILE, SDO_GEOMETRY); type: YES NO *)
  | "valueProtected" ":" <ws> <boolean> (* required; applies when availableOnClient = Y; type: YES NO *)
<column-f-lov> ::= <indent> "lov" <ws> "{" <line-end> { <column-f-lov-property-line> } <indent> "}" <line-end>
<column-f-lov-property-line> ::= <indent> <column-f-lov-property> <line-end>
<column-f-lov-property> ::= "type" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" | "functionBody" ) (* applies when dataType not in (BLOB, CLOB, ROWID, BFILE, SDO_GEOMETRY); type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; applies when type is set; type: YES NO *)
<column-f-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <column-f-accessibility-property-line> } <indent> "}" <line-end>
<column-f-accessibility-property-line> ::= <indent> <column-f-accessibility-property> <line-end>
<column-f-accessibility-property> ::= "valueIdentifiesRow" ":" <ws> <boolean> (* required; applies when display = REPORT and dataType not in (BLOB, CLOB, BFILE, SDO_GEOMETRY); type: YES NO *)
<column-f-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-f-appearance-property-line> } <indent> "}" <line-end>
<column-f-appearance-property-line> ::= <indent> <column-f-appearance-property> <line-end>
<column-f-appearance-property> ::= "formatMask" ":" <ws> <string-like-value> (* applies when dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when dataType = NUMBER; type: COMBOBOX *)
  | "group" ":" <ws> <boolean> (* required; type: YES NO *)
<column-f-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-f-server-side-condition-property-line> } <indent> "}" <line-end>
<column-f-server-side-condition-property-line> ::= <indent> <column-f-server-side-condition-property> <line-end>
<column-f-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-f-security> ::= <indent> "security" <ws> "{" <line-end> { <column-f-security-property-line> } <indent> "}" <line-end>
<column-f-security-property-line> ::= <indent> <column-f-security-property> <line-end>
<column-f-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<column-f-config> ::= <indent> "config" <ws> "{" <line-end> { <column-f-config-property-line> } <indent> "}" <line-end>
<column-f-config-property-line> ::= <indent> <column-f-config-property> <line-end>
<column-f-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-f-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-f-comments-property-line> } <indent> "}" <line-end>
<column-f-comments-property-line> ::= <indent> <column-f-comments-property> <line-end>
<column-f-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* column *)
(* direct properties use default group: identification *)
<column-g> ::= "column" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-g-body-line> } <indent> ")" <line-end>
<column-g-body-line> ::= <column-g-direct-property-line>
  | <column-g-group-block>
<column-g-direct-property-line> ::= <indent> <column-g-direct-property> <line-end>
<column-g-direct-property> ::= "columnName" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<column-g-group-block> ::= <column-g-heading>
  | <column-g-lov>
  | <column-g-cascading-lov>
  | <column-g-multiple-values>
  | <column-g-layout>
  | <column-g-accessibility>
  | <column-g-appearance>
  | <column-g-validation>
  | <column-g-link>
  | <column-g-source>
  | <column-g-master-detail>
  | <column-g-default>
  | <column-g-session-state>
  | <column-g-column-filter>
  | <column-g-export-printing>
  | <column-g-enable-users-to>
  | <column-g-advanced>
  | <column-g-server-side-condition>
  | <column-g-read-only>
  | <column-g-security>
  | <column-g-help>
  | <column-g-config>
  | <column-g-comments>
<column-g-heading> ::= <indent> "heading" <ws> "{" <line-end> { <column-g-heading-property-line> } <indent> "}" <line-end>
<column-g-heading-property-line> ::= <indent> <column-g-heading-property> <line-end>
<column-g-heading-property> ::= "heading" ":" <ws> <string-like-value> (* type: TEXT *)
  | "alignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type supports VISIBLE; type: PILL BUTTONS *)
  | "alternativeLabel" ":" <ws> <string-like-value> (* applies when type supports VISIBLE; type: TEXT *)
<column-g-lov> ::= <indent> "lov" <ws> "{" <line-end> { <column-g-lov-property-line> } <indent> "}" <line-end>
<column-g-lov-property-line> ::= <indent> <column-g-lov-property> <line-end>
<column-g-lov-property> ::= "type" ":" <ws> ( "sharedComponent" | "sqlQuery" | "staticValues" | "functionBody" ) (* required; applies when type supports LOV; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "displayExtraValues" ":" <ws> <boolean> (* required; applies when type is set and type not in (NATIVE_COMBOBOX, NATIVE_SELECT_ONE, NATIVE_SELECT_MANY); type: YES NO *)
  | "displayNullValue" ":" <ws> <boolean> (* required; applies when type supports LOV_DISPLAY_NULL and type is set; type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
  | "nullReturnValue" ":" <ws> <string-like-value> (* applies when displayNullValue = Y; type: TEXT *)
<column-g-cascading-lov> ::= <indent> "cascadingLov" <ws> "{" <line-end> { <column-g-cascading-lov-property-line> } <indent> "}" <line-end>
<column-g-cascading-lov-property-line> ::= <indent> <column-g-cascading-lov-property> <line-end>
<column-g-cascading-lov-property> ::= "parentColumns" ":" <ws> <array-of-string-like-value> (* applies when type supports CASCADING_LOV and type is set and type != STATIC; type: ITEM *)
  | "itemsToSubmit" ":" <ws> <array-of-string-like-value> (* applies when parentColumns is set; type: ITEM *)
  | "parentRequired" ":" <ws> <boolean> (* required; applies when parentColumns is set; type: YES NO *)
<column-g-multiple-values> ::= <indent> "multipleValues" <ws> "{" <line-end> { <column-g-multiple-values-property-line> } <indent> "}" <line-end>
<column-g-multiple-values-property-line> ::= <indent> <column-g-multiple-values-property> <line-end>
<column-g-multiple-values-property> ::= "type" ":" <ws> ( "delimitedList" | "jsonArray" ) (* required; applies when type supports MULTI_VALUE_ALWAYS and type not in (NATIVE_SELECT_LIST); type: SELECT LIST *)
  | "type" ":" <ws> ( "delimitedList" | "jsonArray" ) (* applies when type supports MULTI_VALUE_OPTIONAL and type not in (NATIVE_SELECT_LIST); type: SELECT LIST *)
  | "separator" ":" <ws> <string-like-value> (* required; applies when type = SEPARATED or type = SEPARATED; type: TEXT *)
<column-g-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-g-layout-property-line> } <indent> "}" <line-end>
<column-g-layout-property-line> ::= <indent> <column-g-layout-property> <line-end>
<column-g-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "columnAlignment" ":" <ws> ( "start" | "center" | "end" ) (* required; applies when type supports VISIBLE; type: PILL BUTTONS *)
  | "group" ":" <ws> <reference> (* applies when type supports VISIBLE; type: COMPONENT *)
  | "useGroupFor" ":" <ws> ( "both" | "singleRowView" | "heading" ) (* required; applies when group is set; type: SELECT LIST *)
  | "stretch" ":" <ws> ( "never" | "always" ) (* applies when type supports VISIBLE; type: SELECT LIST *)
<column-g-accessibility> ::= <indent> "accessibility" <ws> "{" <line-end> { <column-g-accessibility-property-line> } <indent> "}" <line-end>
<column-g-accessibility-property-line> ::= <indent> <column-g-accessibility-property> <line-end>
<column-g-accessibility-property> ::= "valueIdentifiesRow" ":" <ws> <boolean> (* required; applies when type supports SOURCE and type not in (NATIVE_MARKDOWN_EDITOR, NATIVE_PASSWORD, NATIVE_PCT_GRAPH, NATIVE_RICH_TEXT_EDITOR); type: YES NO *)
<column-g-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <column-g-appearance-property-line> } <indent> "}" <line-end>
<column-g-appearance-property-line> ::= <indent> <column-g-appearance-property> <line-end>
<column-g-appearance-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type supports VISIBLE; type: COMBOBOX *)
  | "icon" ":" <ws> <string-like-value> (* applies when type supports ICON; type: ICON *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_ALL; type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_DATE; type: COMBOBOX *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_NUMBER; type: COMBOBOX *)
  | "width" ":" <ws> <number> (* applies when type supports WIDTH; type: NUMBER *)
  | "height" ":" <ws> <number> (* applies when type supports HEIGHT; type: NUMBER *)
  | "valuePlaceholder" ":" <ws> <string-like-value> (* applies when type supports PLACEHOLDER; type: TEXT *)
<column-g-validation> ::= <indent> "validation" <ws> "{" <line-end> { <column-g-validation-property-line> } <indent> "}" <line-end>
<column-g-validation-property-line> ::= <indent> <column-g-validation-property> <line-end>
<column-g-validation-property> ::= "valueRequired" ":" <ws> <boolean> (* required; applies when type supports SESSION_STATE; type: YES NO *)
  | "maxLength" ":" <ws> <number> (* applies when type supports WIDTH; type: NUMBER *)
<column-g-link> ::= <indent> "link" <ws> "{" <line-end> { <column-g-link-property-line> } <indent> "}" <line-end>
<column-g-link-property-line> ::= <indent> <column-g-link-property> <line-end>
<column-g-link-property> ::= "target" ":" <ws> <value> (* applies when type supports LINK; type: LINK *)
  | "linkText" ":" <ws> <string-like-value> (* applies when target is set and type != NATIVE_HTML_EXPRESSION; type: TEXT *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when target is set; type: TEXT *)
<column-g-source> ::= <indent> "source" <ws> "{" <line-end> { <column-g-source-property-line> } <indent> "}" <line-end>
<column-g-source-property-line> ::= <indent> <column-g-source-property> <line-end>
<column-g-source-property> ::= "type" ":" <ws> ( "databaseColumn" | "sqlExpression" | "none" ) (* required; applies when type supports SOURCE; type: SELECT LIST *)
  | "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type = DB_COLUMN; type: TEXT *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when type = SQL_EXPRESSION; type: SQL EXPRESSION *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type in (DB_COLUMN, SQL_EXPRESSION); type: SELECT LIST *)
  | "queryOnly" ":" <ws> <boolean> (* required; applies when type = DB_COLUMN and dataType != ROWID; type: YES NO *)
  | "primaryKey" ":" <ws> <boolean> (* required; applies when type = DB_COLUMN; type: YES NO *)
<column-g-master-detail> ::= <indent> "masterDetail" <ws> "{" <line-end> { <column-g-master-detail-property-line> } <indent> "}" <line-end>
<column-g-master-detail-property-line> ::= <indent> <column-g-master-detail-property> <line-end>
<column-g-master-detail-property> ::= "masterColumn" ":" <ws> <reference> (* type: COMPONENT *)
<column-g-default> ::= <indent> "default" <ws> "{" <line-end> { <column-g-default-property-line> } <indent> "}" <line-end>
<column-g-default-property-line> ::= <indent> <column-g-default-property> <line-end>
<column-g-default-property> ::= "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* applies when type supports SOURCE and masterColumn is not set or not set; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: TEXT EDITOR *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuerySingleValue" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY_COLON; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "sequence" ":" <ws> <string-like-value> (* required; applies when type = SEQUENCE; type: TEXT *)
  | "duplicateCopiesExistingValue" ":" <ws> <boolean> (* required; applies when type supports SOURCE and queryOnly = N and masterColumn is not set or not set; type: YES NO *)
<column-g-session-state> ::= <indent> "sessionState" <ws> "{" <line-end> { <column-g-session-state-property-line> } <indent> "}" <line-end>
<column-g-session-state-property-line> ::= <indent> <column-g-session-state-property> <line-end>
<column-g-session-state-property> ::= "dataType" ":" <ws> ( "varchar2" | "clob" | "boolean" ) (* required; type: SELECT LIST *)
<column-g-column-filter> ::= <indent> "columnFilter" <ws> "{" <line-end> { <column-g-column-filter-property-line> } <indent> "}" <line-end>
<column-g-column-filter-property-line> ::= <indent> <column-g-column-filter-property> <line-end>
<column-g-column-filter-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when type supports FILTER and type != NONE and parentColumns is not set or not set; type: YES NO *)
  | "performanceImpactingOperators" ":" <ws> <array-of-string-like-value> (* applies when enabled = Y and property matches; type: CHECKBOXES *)
  | "textCase" ":" <ws> ( "upper" | "lower" | "mixed" ) (* required; applies when enabled = Y and property matches; type: SELECT LIST *)
  | "lovType" ":" <ws> ( "none" | "distinctColumn" | "sqlQuery" | "sharedComponent" | "staticValues" | "functionBody" | "useLov" ) (* required; applies when enabled = Y; type: SELECT LIST *)
  | "dateRanges" ":" <ws> ( "all" | "past" | "future" ) (* required; applies when lovType = DISTINCT and property matches; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when lovType = SQL_QUERY; type: SQL *)
  | "namedLov" ":" <ws> <reference> (* required; applies when lovType = SHARED; type: COMPONENT *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when lovType = STATIC; type: TEXT EDITOR *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when lovType = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "exactMatch" ":" <ws> <boolean> (* required; applies when lovType != NONE and property matches; type: YES NO *)
<column-g-export-printing> ::= <indent> "exportPrinting" <ws> "{" <line-end> { <column-g-export-printing-property-line> } <indent> "}" <line-end>
<column-g-export-printing-property-line> ::= <indent> <column-g-export-printing-property> <line-end>
<column-g-export-printing-property> ::= "includeInExportPrint" ":" <ws> <boolean> (* required; applies when type supports SOURCE and type != NONE; type: YES NO *)
<column-g-enable-users-to> ::= <indent> "enableUsersTo" <ws> "{" <line-end> { <column-g-enable-users-to-property-line> } <indent> "}" <line-end>
<column-g-enable-users-to-property-line> ::= <indent> <column-g-enable-users-to-property> <line-end>
<column-g-enable-users-to-property> ::= "sort" ":" <ws> <boolean> (* required; type: YES NO *)
  | "controlBreakAggregate" ":" <ws> <boolean> (* required; applies when sort = Y; type: YES NO *)
  | "hide" ":" <ws> <boolean> (* required; applies when type supports VISIBLE; type: YES NO *)
<column-g-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-g-advanced-property-line> } <indent> "}" <line-end>
<column-g-advanced-property-line> ::= <indent> <column-g-advanced-property> <line-end>
<column-g-advanced-property> ::= "htmlDomId" ":" <ws> <string-like-value> (* applies when type != NATIVE_ROW_SELECTOR; type: TEXT *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type supports ELEMENT; type: COMBOBOX *)
  | "customAttributes" ":" <ws> <string-like-value> (* applies when type supports ELEMENT; type: COMBOBOX *)
  | "columnInitJavaScriptFunction" ":" <ws> <multiline-string> (* applies when type != NATIVE_ROW_SELECTOR; type: JAVASCRIPT *)
  | "initJavaScriptFunction" ":" <ws> <multiline-string> (* applies when type supports INIT_JAVASCRIPT_CODE; type: JAVASCRIPT *)
<column-g-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <column-g-server-side-condition-property-line> } <indent> "}" <line-end>
<column-g-server-side-condition-property-line> ::= <indent> <column-g-server-side-condition-property> <line-end>
<column-g-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<column-g-read-only> ::= <indent> "readOnly" <ws> "{" <line-end> { <column-g-read-only-property-line> } <indent> "}" <line-end>
<column-g-read-only-property-line> ::= <indent> <column-g-read-only-property> <line-end>
<column-g-read-only-property> ::= "type" ":" <ws> <string-like-value> (* applies when type supports READONLY; type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "execute" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when type is set and type != NEVER; type: SELECT LIST *)
<column-g-security> ::= <indent> "security" <ws> "{" <line-end> { <column-g-security-property-line> } <indent> "}" <line-end>
<column-g-security-property-line> ::= <indent> <column-g-security-property> <line-end>
<column-g-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<column-g-help> ::= <indent> "help" <ws> "{" <line-end> { <column-g-help-property-line> } <indent> "}" <line-end>
<column-g-help-property-line> ::= <indent> <column-g-help-property> <line-end>
<column-g-help-property> ::= "helpText" ":" <ws> <multiline-string> (* applies when type supports VISIBLE; type: HTML *)
<column-g-config> ::= <indent> "config" <ws> "{" <line-end> { <column-g-config-property-line> } <indent> "}" <line-end>
<column-g-config-property-line> ::= <indent> <column-g-config-property> <line-end>
<column-g-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<column-g-comments> ::= <indent> "comments" <ws> "{" <line-end> { <column-g-comments-property-line> } <indent> "}" <line-end>
<column-g-comments-property-line> ::= <indent> <column-g-comments-property> <line-end>
<column-g-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* columnGroup *)
(* direct properties use default group: identification *)
<column-group-a> ::= "columnGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-group-a-body-line> } <indent> ")" <line-end>
<column-group-a-body-line> ::= <column-group-a-direct-property-line>
  | <column-group-a-group-block>
<column-group-a-direct-property-line> ::= <indent> <column-group-a-direct-property> <line-end>
<column-group-a-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<column-group-a-group-block> ::= <column-group-a-layout>
  | <column-group-a-description>
  | <column-group-a-advanced>
<column-group-a-layout> ::= <indent> "layout" <ws> "{" <line-end> { <column-group-a-layout-property-line> } <indent> "}" <line-end>
<column-group-a-layout-property-line> ::= <indent> <column-group-a-layout-property> <line-end>
<column-group-a-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<column-group-a-description> ::= <indent> "description" <ws> "{" <line-end> { <column-group-a-description-property-line> } <indent> "}" <line-end>
<column-group-a-description-property-line> ::= <indent> <column-group-a-description-property> <line-end>
<column-group-a-description-property> ::= "description" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<column-group-a-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-group-a-advanced-property-line> } <indent> "}" <line-end>
<column-group-a-advanced-property-line> ::= <indent> <column-group-a-advanced-property> <line-end>
<column-group-a-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)

(* columnGroup *)
(* direct properties use default group: heading *)
<column-group-b> ::= "columnGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <column-group-b-body-line> } <indent> ")" <line-end>
<column-group-b-body-line> ::= <column-group-b-direct-property-line>
  | <column-group-b-group-block>
<column-group-b-direct-property-line> ::= <indent> <column-group-b-direct-property> <line-end>
<column-group-b-direct-property> ::= "heading" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "alternativeLabel" ":" <ws> <string-like-value> (* type: TEXT *)
<column-group-b-group-block> ::= <column-group-b-advanced>
<column-group-b-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <column-group-b-advanced-property-line> } <indent> "}" <line-end>
<column-group-b-advanced-property-line> ::= <indent> <column-group-b-advanced-property> <line-end>
<column-group-b-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)

(* facet *)
(* direct properties use default group: identification *)
<facet> ::= "facet" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <facet-body-line> } <indent> ")" <line-end>
<facet-body-line> ::= <facet-direct-property-line>
  | <facet-group-block>
<facet-direct-property-line> ::= <indent> <facet-direct-property> <line-end>
<facet-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<facet-group-block> ::= <facet-label>
  | <facet-lov>
  | <facet-cascading-lov>
  | <facet-layout>
  | <facet-appearance>
  | <facet-list-entries>
  | <facet-actions-menu>
  | <facet-advanced>
  | <facet-source>
  | <facet-multiple-values>
  | <facet-default>
  | <facet-depending-on>
  | <facet-server-side-condition>
  | <facet-security>
  | <facet-config>
  | <facet-comments>
<facet-label> ::= <indent> "label" <ws> "{" <line-end> { <facet-label-property-line> } <indent> "}" <line-end>
<facet-label-property-line> ::= <indent> <facet-label-property> <line-end>
<facet-label-property> ::= "label" ":" <ws> <string-like-value> (* applies when type supports VISIBLE; type: TEXT *)
  | "showLabelForCurrentFacet" ":" <ws> <boolean> (* required; applies when type supports VISIBLE and type != NATIVE_SEARCH; type: YES NO *)
<facet-lov> ::= <indent> "lov" <ws> "{" <line-end> { <facet-lov-property-line> } <indent> "}" <line-end>
<facet-lov-property-line> ::= <indent> <facet-lov-property> <line-end>
<facet-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type supports LOV; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "sortDirection" ":" <ws> ( "asc" | "desc" ) (* required; applies when type = DISTINCT; type: SELECT LIST *)
  | "includeNullOption" ":" <ws> <boolean> (* required; applies when type supports FC_LOV_DISPLAY_NULL and type is set; type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* required; applies when includeNullOption = Y; type: TEXT *)
<facet-cascading-lov> ::= <indent> "cascadingLov" <ws> "{" <line-end> { <facet-cascading-lov-property-line> } <indent> "}" <line-end>
<facet-cascading-lov-property-line> ::= <indent> <facet-cascading-lov-property> <line-end>
<facet-cascading-lov-property> ::= "parentFacet" ":" <ws> <string-like-value> (* applies when type = SHARED; type: FACET *)
  | "lovColumn" ":" <ws> <string-like-value> (* required; applies when parentFacet is set; type: TEXT *)
  | "parentRequired" ":" <ws> <boolean> (* required; applies when parentFacet is set; type: YES NO *)
<facet-layout> ::= <indent> "layout" <ws> "{" <line-end> { <facet-layout-property-line> } <indent> "}" <line-end>
<facet-layout-property-line> ::= <indent> <facet-layout-property> <line-end>
<facet-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "maxHeight" ":" <ws> <number> (* applies when type not in (NATIVE_SEARCH, NATIVE_INPUT); type: INTEGER *)
<facet-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <facet-appearance-property-line> } <indent> "}" <line-end>
<facet-appearance-property-line> ::= <indent> <facet-appearance-property> <line-end>
<facet-appearance-property> ::= "valuePlaceholder" ":" <ws> <string-like-value> (* applies when type supports PLACEHOLDER; type: TEXT *)
  | "icon" ":" <ws> <string-like-value> (* applies when type != NATIVE_SEARCH; type: ICON *)
  | "display" ":" <ws> ( "inline" | "addFilterDialog" ) (* required; applies when type != NATIVE_SEARCH; type: PILL BUTTONS *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_DATE and dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
<facet-list-entries> ::= <indent> "listEntries" <ws> "{" <line-end> { <facet-list-entries-property-line> } <indent> "}" <line-end>
<facet-list-entries-property-line> ::= <indent> <facet-list-entries-property> <line-end>
<facet-list-entries-property> ::= "computeCounts" ":" <ws> <boolean> (* required; applies when type supports FC_HAS_FEEDBACK; type: YES NO *)
  | "showCounts" ":" <ws> <boolean> (* required; applies when computeCounts = Y; type: YES NO *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; applies when computeCounts = Y; type: SELECT LIST *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; applies when showCounts = Y and type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP); type: YES NO *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; applies when type supports FC_SHOW_SELECTED_FIRST and type is set; type: YES NO *)
  | "maxDisplayedEntries" ":" <ws> <number> (* applies when type supports FC_SHOW_MORE_COUNT and type is set; type: INTEGER *)
  | "allowToExclude" ":" <ws> <boolean> (* required; applies when type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP, NATIVE_RANGE); type: YES NO *)
  | "displayFilterInitially" ":" <ws> <boolean> (* required; applies when type supports FC_FILTER_VALUES and type is set; type: YES NO *)
<facet-actions-menu> ::= <indent> "actionsMenu" <ws> "{" <line-end> { <facet-actions-menu-property-line> } <indent> "}" <line-end>
<facet-actions-menu-property-line> ::= <indent> <facet-actions-menu-property> <line-end>
<facet-actions-menu-property> ::= "filter" ":" <ws> <boolean> (* required; applies when type supports FC_FILTER_VALUES and type is set and display = INLINE; type: YES NO *)
  | "chart" ":" <ws> <boolean> (* required; applies when computeCounts = Y and type is set; type: YES NO *)
<facet-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <facet-advanced-property-line> } <indent> "}" <line-end>
<facet-advanced-property-line> ::= <indent> <facet-advanced-property> <line-end>
<facet-advanced-property> ::= "showChartInitially" ":" <ws> <boolean> (* required; applies when chart = Y and display = INLINE; type: YES NO *)
  | "collapsible" ":" <ws> <boolean> (* required; applies when type != NATIVE_SEARCH and display = INLINE; type: YES NO *)
  | "initiallyCollapsed" ":" <ws> <boolean> (* required; applies when collapsible = Y; type: YES NO *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type != NATIVE_SEARCH and display = INLINE; type: COMBOBOX *)
<facet-source> ::= <indent> "source" <ws> "{" <line-end> { <facet-source-property-line> } <indent> "}" <line-end>
<facet-source-property-line> ::= <indent> <facet-source-property> <line-end>
<facet-source-property> ::= "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type != NATIVE_SEARCH; type: TEXT *)
  | "dbColumns" ":" <ws> <string-like-value> (* applies when type = NATIVE_SEARCH; type: TEXT *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type != NATIVE_SEARCH; type: SELECT LIST *)
<facet-multiple-values> ::= <indent> "multipleValues" <ws> "{" <line-end> { <facet-multiple-values-property-line> } <indent> "}" <line-end>
<facet-multiple-values-property-line> ::= <indent> <facet-multiple-values-property> <line-end>
<facet-multiple-values-property> ::= "type" ":" <ws> ( "delimitedList" | "jsonArray" ) (* applies when type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP, NATIVE_SELECT_LIST); type: SELECT LIST *)
  | "separator" ":" <ws> <string-like-value> (* required; applies when type = SEPARATED; type: TEXT *)
  | "trimWhitespace" ":" <ws> <boolean> (* required; applies when type = SEPARATED; type: YES NO *)
  | "filterCombination" ":" <ws> ( "or" | "and" ) (* required; applies when type is set; type: SELECT LIST *)
<facet-default> ::= <indent> "default" <ws> "{" <line-end> { <facet-default-property-line> } <indent> "}" <line-end>
<facet-default-property-line> ::= <indent> <facet-default-property> <line-end>
<facet-default-property> ::= "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* applies when type supports SOURCE; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC_TEXT_WITH_SUBSTITUTIONS; type: TEXT EDITOR *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuerySingleValue" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY_COLON; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "sequence" ":" <ws> <string-like-value> (* required; applies when type = SEQUENCE; type: TEXT *)
<facet-depending-on> ::= <indent> "dependingOn" <ws> "{" <line-end> { <facet-depending-on-property-line> } <indent> "}" <line-end>
<facet-depending-on-property-line> ::= <indent> <facet-depending-on-property> <line-end>
<facet-depending-on-property> ::= "facet" ":" <ws> <reference> (* applies when type != NATIVE_SEARCH; type: COMPONENT *)
  | "type" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; applies when facet is set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
<facet-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <facet-server-side-condition-property-line> } <indent> "}" <line-end>
<facet-server-side-condition-property-line> ::= <indent> <facet-server-side-condition-property> <line-end>
<facet-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<facet-security> ::= <indent> "security" <ws> "{" <line-end> { <facet-security-property-line> } <indent> "}" <line-end>
<facet-security-property-line> ::= <indent> <facet-security-property> <line-end>
<facet-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "encryptSessionState" ":" <ws> <boolean> (* required; applies when type supports ENCRYPT; type: YES NO *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<facet-config> ::= <indent> "config" <ws> "{" <line-end> { <facet-config-property-line> } <indent> "}" <line-end>
<facet-config-property-line> ::= <indent> <facet-config-property> <line-end>
<facet-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<facet-comments> ::= <indent> "comments" <ws> "{" <line-end> { <facet-comments-property-line> } <indent> "}" <line-end>
<facet-comments-property-line> ::= <indent> <facet-comments-property> <line-end>
<facet-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* facetGroup *)
(* direct properties use default group: label *)
<facet-group> ::= "facetGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <facet-group-body-line> } <indent> ")" <line-end>
<facet-group-body-line> ::= <facet-group-direct-property-line>
  | <facet-group-group-block>
  | <facet-group-child-component>
<facet-group-direct-property-line> ::= <indent> <facet-group-direct-property> <line-end>
<facet-group-direct-property> ::= "label" ":" <ws> <string-like-value> (* required; type: TEXT *)
<facet-group-group-block> ::= <facet-group-layout>
  | <facet-group-appearance>
  | <facet-group-list-entries>
  | <facet-group-actions-menu>
  | <facet-group-advanced>
  | <facet-group-server-side-condition>
  | <facet-group-security>
  | <facet-group-config>
  | <facet-group-comments>
<facet-group-layout> ::= <indent> "layout" <ws> "{" <line-end> { <facet-group-layout-property-line> } <indent> "}" <line-end>
<facet-group-layout-property-line> ::= <indent> <facet-group-layout-property> <line-end>
<facet-group-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "maxHeight" ":" <ws> <number> (* type: INTEGER *)
<facet-group-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <facet-group-appearance-property-line> } <indent> "}" <line-end>
<facet-group-appearance-property-line> ::= <indent> <facet-group-appearance-property> <line-end>
<facet-group-appearance-property> ::= "icon" ":" <ws> <string-like-value> (* type: ICON *)
  | "display" ":" <ws> ( "inline" | "addFilterDialog" ) (* required; type: PILL BUTTONS *)
<facet-group-list-entries> ::= <indent> "listEntries" <ws> "{" <line-end> { <facet-group-list-entries-property-line> } <indent> "}" <line-end>
<facet-group-list-entries-property-line> ::= <indent> <facet-group-list-entries-property> <line-end>
<facet-group-list-entries-property> ::= "computeCounts" ":" <ws> <boolean> (* required; type: YES NO *)
  | "showCounts" ":" <ws> <boolean> (* required; applies when computeCounts = Y; type: YES NO *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; applies when computeCounts = Y; type: SELECT LIST *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; applies when showCounts = Y; type: YES NO *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; type: YES NO *)
  | "maxDisplayedEntries" ":" <ws> <number> (* type: INTEGER *)
<facet-group-actions-menu> ::= <indent> "actionsMenu" <ws> "{" <line-end> { <facet-group-actions-menu-property-line> } <indent> "}" <line-end>
<facet-group-actions-menu-property-line> ::= <indent> <facet-group-actions-menu-property> <line-end>
<facet-group-actions-menu-property> ::= "chart" ":" <ws> <boolean> (* required; applies when computeCounts = Y and display = INLINE; type: YES NO *)
<facet-group-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <facet-group-advanced-property-line> } <indent> "}" <line-end>
<facet-group-advanced-property-line> ::= <indent> <facet-group-advanced-property> <line-end>
<facet-group-advanced-property> ::= "showChartInitially" ":" <ws> <boolean> (* required; applies when chart = Y and display = INLINE; type: YES NO *)
  | "collapsible" ":" <ws> <boolean> (* required; applies when display = INLINE; type: YES NO *)
  | "initiallyCollapsed" ":" <ws> <boolean> (* required; applies when collapsible = Y; type: YES NO *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when display = INLINE; type: COMBOBOX *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "combineFilters" ":" <ws> ( "or" | "and" ) (* required; type: SELECT LIST *)
<facet-group-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <facet-group-server-side-condition-property-line> } <indent> "}" <line-end>
<facet-group-server-side-condition-property-line> ::= <indent> <facet-group-server-side-condition-property> <line-end>
<facet-group-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<facet-group-security> ::= <indent> "security" <ws> "{" <line-end> { <facet-group-security-property-line> } <indent> "}" <line-end>
<facet-group-security-property-line> ::= <indent> <facet-group-security-property> <line-end>
<facet-group-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<facet-group-config> ::= <indent> "config" <ws> "{" <line-end> { <facet-group-config-property-line> } <indent> "}" <line-end>
<facet-group-config-property-line> ::= <indent> <facet-group-config-property> <line-end>
<facet-group-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<facet-group-comments> ::= <indent> "comments" <ws> "{" <line-end> { <facet-group-comments-property-line> } <indent> "}" <line-end>
<facet-group-comments-property-line> ::= <indent> <facet-group-comments-property> <line-end>
<facet-group-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<facet-group-child-component> ::= <checkbox-a>

(* checkbox *)
(* direct properties use default group: identification *)
<checkbox-a> ::= "checkbox" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <checkbox-a-body-line> } <indent> ")" <line-end>
<checkbox-a-body-line> ::= <checkbox-a-direct-property-line>
  | <checkbox-a-group-block>
<checkbox-a-direct-property-line> ::= <indent> <checkbox-a-direct-property> <line-end>
<checkbox-a-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<checkbox-a-group-block> ::= <checkbox-a-label>
  | <checkbox-a-lov>
  | <checkbox-a-cascading-lov>
  | <checkbox-a-layout>
  | <checkbox-a-appearance>
  | <checkbox-a-source>
  | <checkbox-a-default>
  | <checkbox-a-depending-on>
  | <checkbox-a-server-side-condition>
  | <checkbox-a-security>
  | <checkbox-a-config>
  | <checkbox-a-comments>
<checkbox-a-label> ::= <indent> "label" <ws> "{" <line-end> { <checkbox-a-label-property-line> } <indent> "}" <line-end>
<checkbox-a-label-property-line> ::= <indent> <checkbox-a-label-property> <line-end>
<checkbox-a-label-property> ::= "label" ":" <ws> <string-like-value> (* applies when type supports VISIBLE; type: TEXT *)
  | "showLabelForCurrentFacet" ":" <ws> <boolean> (* required; applies when type supports VISIBLE and type != NATIVE_SEARCH; type: YES NO *)
<checkbox-a-lov> ::= <indent> "lov" <ws> "{" <line-end> { <checkbox-a-lov-property-line> } <indent> "}" <line-end>
<checkbox-a-lov-property-line> ::= <indent> <checkbox-a-lov-property> <line-end>
<checkbox-a-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type supports LOV; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "sortDirection" ":" <ws> ( "asc" | "desc" ) (* required; applies when type = DISTINCT; type: SELECT LIST *)
  | "includeNullOption" ":" <ws> <boolean> (* required; applies when type supports FC_LOV_DISPLAY_NULL and type is set; type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* required; applies when includeNullOption = Y; type: TEXT *)
<checkbox-a-cascading-lov> ::= <indent> "cascadingLov" <ws> "{" <line-end> { <checkbox-a-cascading-lov-property-line> } <indent> "}" <line-end>
<checkbox-a-cascading-lov-property-line> ::= <indent> <checkbox-a-cascading-lov-property> <line-end>
<checkbox-a-cascading-lov-property> ::= "parentFacet" ":" <ws> <string-like-value> (* applies when type = SHARED; type: FACET *)
  | "lovColumn" ":" <ws> <string-like-value> (* required; applies when parentFacet is set; type: TEXT *)
  | "parentRequired" ":" <ws> <boolean> (* required; applies when parentFacet is set; type: YES NO *)
<checkbox-a-layout> ::= <indent> "layout" <ws> "{" <line-end> { <checkbox-a-layout-property-line> } <indent> "}" <line-end>
<checkbox-a-layout-property-line> ::= <indent> <checkbox-a-layout-property> <line-end>
<checkbox-a-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "facetGroup" ":" <ws> <reference> (* required; type: COMPONENT *)
<checkbox-a-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <checkbox-a-appearance-property-line> } <indent> "}" <line-end>
<checkbox-a-appearance-property-line> ::= <indent> <checkbox-a-appearance-property> <line-end>
<checkbox-a-appearance-property> ::= "valuePlaceholder" ":" <ws> <string-like-value> (* applies when type supports PLACEHOLDER; type: TEXT *)
  | "icon" ":" <ws> <string-like-value> (* applies when type != NATIVE_SEARCH; type: ICON *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_DATE and dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
<checkbox-a-source> ::= <indent> "source" <ws> "{" <line-end> { <checkbox-a-source-property-line> } <indent> "}" <line-end>
<checkbox-a-source-property-line> ::= <indent> <checkbox-a-source-property> <line-end>
<checkbox-a-source-property> ::= "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type != NATIVE_SEARCH; type: TEXT *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type != NATIVE_SEARCH; type: SELECT LIST *)
<checkbox-a-default> ::= <indent> "default" <ws> "{" <line-end> { <checkbox-a-default-property-line> } <indent> "}" <line-end>
<checkbox-a-default-property-line> ::= <indent> <checkbox-a-default-property> <line-end>
<checkbox-a-default-property> ::= "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* applies when type supports SOURCE; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC_TEXT_WITH_SUBSTITUTIONS; type: TEXT EDITOR *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuerySingleValue" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY_COLON; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "sequence" ":" <ws> <string-like-value> (* required; applies when type = SEQUENCE; type: TEXT *)
<checkbox-a-depending-on> ::= <indent> "dependingOn" <ws> "{" <line-end> { <checkbox-a-depending-on-property-line> } <indent> "}" <line-end>
<checkbox-a-depending-on-property-line> ::= <indent> <checkbox-a-depending-on-property> <line-end>
<checkbox-a-depending-on-property> ::= "checkbox" ":" <ws> <reference> (* applies when type != NATIVE_SEARCH; type: COMPONENT *)
  | "type" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; applies when checkbox is set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
<checkbox-a-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <checkbox-a-server-side-condition-property-line> } <indent> "}" <line-end>
<checkbox-a-server-side-condition-property-line> ::= <indent> <checkbox-a-server-side-condition-property> <line-end>
<checkbox-a-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<checkbox-a-security> ::= <indent> "security" <ws> "{" <line-end> { <checkbox-a-security-property-line> } <indent> "}" <line-end>
<checkbox-a-security-property-line> ::= <indent> <checkbox-a-security-property> <line-end>
<checkbox-a-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "encryptSessionState" ":" <ws> <boolean> (* required; applies when type supports ENCRYPT; type: YES NO *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<checkbox-a-config> ::= <indent> "config" <ws> "{" <line-end> { <checkbox-a-config-property-line> } <indent> "}" <line-end>
<checkbox-a-config-property-line> ::= <indent> <checkbox-a-config-property> <line-end>
<checkbox-a-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<checkbox-a-comments> ::= <indent> "comments" <ws> "{" <line-end> { <checkbox-a-comments-property-line> } <indent> "}" <line-end>
<checkbox-a-comments-property-line> ::= <indent> <checkbox-a-comments-property> <line-end>
<checkbox-a-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* filter *)
(* direct properties use default group: identification *)
<filter-c> ::= "filter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <filter-c-body-line> } <indent> ")" <line-end>
<filter-c-body-line> ::= <filter-c-direct-property-line>
  | <filter-c-group-block>
<filter-c-direct-property-line> ::= <indent> <filter-c-direct-property> <line-end>
<filter-c-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<filter-c-group-block> ::= <filter-c-label>
  | <filter-c-lov>
  | <filter-c-cascading-lov>
  | <filter-c-layout>
  | <filter-c-appearance>
  | <filter-c-list-entries>
  | <filter-c-suggestions>
  | <filter-c-advanced>
  | <filter-c-source>
  | <filter-c-multiple-values>
  | <filter-c-default>
  | <filter-c-depending-on>
  | <filter-c-server-side-condition>
  | <filter-c-security>
  | <filter-c-config>
  | <filter-c-comments>
<filter-c-label> ::= <indent> "label" <ws> "{" <line-end> { <filter-c-label-property-line> } <indent> "}" <line-end>
<filter-c-label-property-line> ::= <indent> <filter-c-label-property> <line-end>
<filter-c-label-property> ::= "label" ":" <ws> <string-like-value> (* applies when type supports VISIBLE; type: TEXT *)
<filter-c-lov> ::= <indent> "lov" <ws> "{" <line-end> { <filter-c-lov-property-line> } <indent> "}" <line-end>
<filter-c-lov-property-line> ::= <indent> <filter-c-lov-property> <line-end>
<filter-c-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type supports LOV; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "sortDirection" ":" <ws> ( "asc" | "desc" ) (* required; applies when type = DISTINCT; type: SELECT LIST *)
  | "includeNullOption" ":" <ws> <boolean> (* required; applies when type supports FC_LOV_DISPLAY_NULL and type is set; type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* required; applies when includeNullOption = Y; type: TEXT *)
<filter-c-cascading-lov> ::= <indent> "cascadingLov" <ws> "{" <line-end> { <filter-c-cascading-lov-property-line> } <indent> "}" <line-end>
<filter-c-cascading-lov-property-line> ::= <indent> <filter-c-cascading-lov-property> <line-end>
<filter-c-cascading-lov-property> ::= "parentFilter" ":" <ws> <string-like-value> (* applies when type = SHARED; type: FACET *)
  | "lovColumn" ":" <ws> <string-like-value> (* required; applies when parentFilter is set; type: TEXT *)
  | "parentRequired" ":" <ws> <boolean> (* required; applies when parentFilter is set; type: YES NO *)
<filter-c-layout> ::= <indent> "layout" <ws> "{" <line-end> { <filter-c-layout-property-line> } <indent> "}" <line-end>
<filter-c-layout-property-line> ::= <indent> <filter-c-layout-property> <line-end>
<filter-c-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<filter-c-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <filter-c-appearance-property-line> } <indent> "}" <line-end>
<filter-c-appearance-property-line> ::= <indent> <filter-c-appearance-property> <line-end>
<filter-c-appearance-property> ::= "valuePlaceholder" ":" <ws> <string-like-value> (* applies when type supports PLACEHOLDER; type: TEXT *)
  | "icon" ":" <ws> <string-like-value> (* applies when type != NATIVE_SEARCH; type: ICON *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_DATE and dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
<filter-c-list-entries> ::= <indent> "listEntries" <ws> "{" <line-end> { <filter-c-list-entries-property-line> } <indent> "}" <line-end>
<filter-c-list-entries-property-line> ::= <indent> <filter-c-list-entries-property> <line-end>
<filter-c-list-entries-property> ::= "computeCounts" ":" <ws> <boolean> (* required; applies when type supports FC_HAS_FEEDBACK; type: YES NO *)
  | "showCounts" ":" <ws> <boolean> (* required; applies when computeCounts = Y; type: YES NO *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; applies when computeCounts = Y; type: SELECT LIST *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; applies when showCounts = Y and type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP); type: YES NO *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; applies when type supports FC_SHOW_SELECTED_FIRST and type is set; type: YES NO *)
  | "allowToExclude" ":" <ws> <boolean> (* required; applies when type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP, NATIVE_RANGE); type: YES NO *)
  | "clientSideFiltering" ":" <ws> <boolean> (* required; applies when type supports FC_FILTER_VALUES and type is set; type: YES NO *)
<filter-c-suggestions> ::= <indent> "suggestions" <ws> "{" <line-end> { <filter-c-suggestions-property-line> } <indent> "}" <line-end>
<filter-c-suggestions-property-line> ::= <indent> <filter-c-suggestions-property> <line-end>
<filter-c-suggestions-property> ::= "type" ":" <ws> ( "dynamic" | "staticValues" | "sqlQuery" ) (* applies when type != NATIVE_SEARCH; type: SELECT LIST *)
  | "staticValues" ":" <ws> <array-of-string-like-value> (* required; applies when type = STATIC; type: TEXT EDITOR *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "showLabel" ":" <ws> <boolean> (* required; applies when type is set and type != NATIVE_SEARCH; type: YES NO *)
<filter-c-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <filter-c-advanced-property-line> } <indent> "}" <line-end>
<filter-c-advanced-property-line> ::= <indent> <filter-c-advanced-property> <line-end>
<filter-c-advanced-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type != NATIVE_SEARCH; type: COMBOBOX *)
<filter-c-source> ::= <indent> "source" <ws> "{" <line-end> { <filter-c-source-property-line> } <indent> "}" <line-end>
<filter-c-source-property-line> ::= <indent> <filter-c-source-property> <line-end>
<filter-c-source-property> ::= "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type != NATIVE_SEARCH; type: TEXT *)
  | "dbColumns" ":" <ws> <string-like-value> (* applies when type = NATIVE_SEARCH; type: TEXT *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type != NATIVE_SEARCH; type: SELECT LIST *)
<filter-c-multiple-values> ::= <indent> "multipleValues" <ws> "{" <line-end> { <filter-c-multiple-values-property-line> } <indent> "}" <line-end>
<filter-c-multiple-values-property-line> ::= <indent> <filter-c-multiple-values-property> <line-end>
<filter-c-multiple-values-property> ::= "type" ":" <ws> ( "delimitedList" | "jsonArray" ) (* applies when type in (NATIVE_CHECKBOX, NATIVE_RADIOGROUP, NATIVE_SELECT_LIST); type: SELECT LIST *)
  | "separator" ":" <ws> <string-like-value> (* required; applies when type = SEPARATED; type: TEXT *)
  | "trimWhitespace" ":" <ws> <boolean> (* required; applies when type = SEPARATED; type: YES NO *)
  | "filterCombination" ":" <ws> ( "or" | "and" ) (* required; applies when type is set; type: SELECT LIST *)
<filter-c-default> ::= <indent> "default" <ws> "{" <line-end> { <filter-c-default-property-line> } <indent> "}" <line-end>
<filter-c-default-property-line> ::= <indent> <filter-c-default-property> <line-end>
<filter-c-default-property> ::= "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* applies when type supports SOURCE; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC_TEXT_WITH_SUBSTITUTIONS; type: TEXT EDITOR *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuerySingleValue" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY_COLON; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "sequence" ":" <ws> <string-like-value> (* required; applies when type = SEQUENCE; type: TEXT *)
<filter-c-depending-on> ::= <indent> "dependingOn" <ws> "{" <line-end> { <filter-c-depending-on-property-line> } <indent> "}" <line-end>
<filter-c-depending-on-property-line> ::= <indent> <filter-c-depending-on-property> <line-end>
<filter-c-depending-on-property> ::= "filter" ":" <ws> <reference> (* applies when type != NATIVE_SEARCH; type: COMPONENT *)
  | "type" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; applies when filter is set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
<filter-c-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <filter-c-server-side-condition-property-line> } <indent> "}" <line-end>
<filter-c-server-side-condition-property-line> ::= <indent> <filter-c-server-side-condition-property> <line-end>
<filter-c-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* applies when type != NATIVE_SEARCH; type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<filter-c-security> ::= <indent> "security" <ws> "{" <line-end> { <filter-c-security-property-line> } <indent> "}" <line-end>
<filter-c-security-property-line> ::= <indent> <filter-c-security-property> <line-end>
<filter-c-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* applies when type != NATIVE_SEARCH; type: COMPONENT *)
  | "encryptSessionState" ":" <ws> <boolean> (* required; applies when type supports ENCRYPT; type: YES NO *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<filter-c-config> ::= <indent> "config" <ws> "{" <line-end> { <filter-c-config-property-line> } <indent> "}" <line-end>
<filter-c-config-property-line> ::= <indent> <filter-c-config-property> <line-end>
<filter-c-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<filter-c-comments> ::= <indent> "comments" <ws> "{" <line-end> { <filter-c-comments-property-line> } <indent> "}" <line-end>
<filter-c-comments-property-line> ::= <indent> <filter-c-comments-property> <line-end>
<filter-c-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* filterGroup *)
(* direct properties use default group: label *)
<filter-group> ::= "filterGroup" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <filter-group-body-line> } <indent> ")" <line-end>
<filter-group-body-line> ::= <filter-group-direct-property-line>
  | <filter-group-group-block>
  | <filter-group-child-component>
<filter-group-direct-property-line> ::= <indent> <filter-group-direct-property> <line-end>
<filter-group-direct-property> ::= "label" ":" <ws> <string-like-value> (* required; type: TEXT *)
<filter-group-group-block> ::= <filter-group-layout>
  | <filter-group-appearance>
  | <filter-group-list-entries>
  | <filter-group-suggestions>
  | <filter-group-advanced>
  | <filter-group-server-side-condition>
  | <filter-group-security>
  | <filter-group-config>
  | <filter-group-comments>
<filter-group-layout> ::= <indent> "layout" <ws> "{" <line-end> { <filter-group-layout-property-line> } <indent> "}" <line-end>
<filter-group-layout-property-line> ::= <indent> <filter-group-layout-property> <line-end>
<filter-group-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<filter-group-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <filter-group-appearance-property-line> } <indent> "}" <line-end>
<filter-group-appearance-property-line> ::= <indent> <filter-group-appearance-property> <line-end>
<filter-group-appearance-property> ::= "icon" ":" <ws> <string-like-value> (* type: ICON *)
<filter-group-list-entries> ::= <indent> "listEntries" <ws> "{" <line-end> { <filter-group-list-entries-property-line> } <indent> "}" <line-end>
<filter-group-list-entries-property-line> ::= <indent> <filter-group-list-entries-property> <line-end>
<filter-group-list-entries-property> ::= "computeCounts" ":" <ws> <boolean> (* required; type: YES NO *)
  | "showCounts" ":" <ws> <boolean> (* required; applies when computeCounts = Y; type: YES NO *)
  | "zeroCountEntries" ":" <ws> ( "hide" | "disable" | "showLast" ) (* required; applies when computeCounts = Y; type: SELECT LIST *)
  | "sortByTopCounts" ":" <ws> <boolean> (* required; applies when showCounts = Y; type: YES NO *)
  | "showSelectedFirst" ":" <ws> <boolean> (* required; type: YES NO *)
<filter-group-suggestions> ::= <indent> "suggestions" <ws> "{" <line-end> { <filter-group-suggestions-property-line> } <indent> "}" <line-end>
<filter-group-suggestions-property-line> ::= <indent> <filter-group-suggestions-property> <line-end>
<filter-group-suggestions-property> ::= "type" ":" <ws> ( "dynamic" | "staticValues" | "sqlQuery" ) (* type: SELECT LIST *)
  | "staticValues" ":" <ws> <array-of-string-like-value> (* required; applies when type = STATIC; type: TEXT EDITOR *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "showLabel" ":" <ws> <boolean> (* required; applies when type is set; type: YES NO *)
<filter-group-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <filter-group-advanced-property-line> } <indent> "}" <line-end>
<filter-group-advanced-property-line> ::= <indent> <filter-group-advanced-property> <line-end>
<filter-group-advanced-property> ::= "cssClasses" ":" <ws> <array-of-string-like-value> (* type: COMBOBOX *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "combineFilters" ":" <ws> ( "or" | "and" ) (* required; type: SELECT LIST *)
<filter-group-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <filter-group-server-side-condition-property-line> } <indent> "}" <line-end>
<filter-group-server-side-condition-property-line> ::= <indent> <filter-group-server-side-condition-property> <line-end>
<filter-group-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<filter-group-security> ::= <indent> "security" <ws> "{" <line-end> { <filter-group-security-property-line> } <indent> "}" <line-end>
<filter-group-security-property-line> ::= <indent> <filter-group-security-property> <line-end>
<filter-group-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<filter-group-config> ::= <indent> "config" <ws> "{" <line-end> { <filter-group-config-property-line> } <indent> "}" <line-end>
<filter-group-config-property-line> ::= <indent> <filter-group-config-property> <line-end>
<filter-group-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<filter-group-comments> ::= <indent> "comments" <ws> "{" <line-end> { <filter-group-comments-property-line> } <indent> "}" <line-end>
<filter-group-comments-property-line> ::= <indent> <filter-group-comments-property> <line-end>
<filter-group-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<filter-group-child-component> ::= <checkbox-b>

(* checkbox *)
(* direct properties use default group: identification *)
<checkbox-b> ::= "checkbox" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <checkbox-b-body-line> } <indent> ")" <line-end>
<checkbox-b-body-line> ::= <checkbox-b-direct-property-line>
  | <checkbox-b-group-block>
<checkbox-b-direct-property-line> ::= <indent> <checkbox-b-direct-property> <line-end>
<checkbox-b-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<checkbox-b-group-block> ::= <checkbox-b-label>
  | <checkbox-b-lov>
  | <checkbox-b-cascading-lov>
  | <checkbox-b-layout>
  | <checkbox-b-appearance>
  | <checkbox-b-source>
  | <checkbox-b-default>
  | <checkbox-b-depending-on>
  | <checkbox-b-server-side-condition>
  | <checkbox-b-security>
  | <checkbox-b-config>
  | <checkbox-b-comments>
<checkbox-b-label> ::= <indent> "label" <ws> "{" <line-end> { <checkbox-b-label-property-line> } <indent> "}" <line-end>
<checkbox-b-label-property-line> ::= <indent> <checkbox-b-label-property> <line-end>
<checkbox-b-label-property> ::= "label" ":" <ws> <string-like-value> (* applies when type supports VISIBLE; type: TEXT *)
<checkbox-b-lov> ::= <indent> "lov" <ws> "{" <line-end> { <checkbox-b-lov-property-line> } <indent> "}" <line-end>
<checkbox-b-lov-property-line> ::= <indent> <checkbox-b-lov-property> <line-end>
<checkbox-b-lov-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when type supports LOV; type: SELECT LIST *)
  | "lov" ":" <ws> <reference> (* required; applies when type = SHARED; type: COMPONENT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "staticValues" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: STATIC LOV *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "sortDirection" ":" <ws> ( "asc" | "desc" ) (* required; applies when type = DISTINCT; type: SELECT LIST *)
  | "includeNullOption" ":" <ws> <boolean> (* required; applies when type supports FC_LOV_DISPLAY_NULL and type is set; type: YES NO *)
  | "nullDisplayValue" ":" <ws> <string-like-value> (* required; applies when includeNullOption = Y; type: TEXT *)
<checkbox-b-cascading-lov> ::= <indent> "cascadingLov" <ws> "{" <line-end> { <checkbox-b-cascading-lov-property-line> } <indent> "}" <line-end>
<checkbox-b-cascading-lov-property-line> ::= <indent> <checkbox-b-cascading-lov-property> <line-end>
<checkbox-b-cascading-lov-property> ::= "parentFilter" ":" <ws> <string-like-value> (* applies when type = SHARED; type: FACET *)
  | "lovColumn" ":" <ws> <string-like-value> (* required; applies when parentFilter is set; type: TEXT *)
  | "parentRequired" ":" <ws> <boolean> (* required; applies when parentFilter is set; type: YES NO *)
<checkbox-b-layout> ::= <indent> "layout" <ws> "{" <line-end> { <checkbox-b-layout-property-line> } <indent> "}" <line-end>
<checkbox-b-layout-property-line> ::= <indent> <checkbox-b-layout-property> <line-end>
<checkbox-b-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "filterGroup" ":" <ws> <reference> (* required; type: COMPONENT *)
<checkbox-b-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <checkbox-b-appearance-property-line> } <indent> "}" <line-end>
<checkbox-b-appearance-property-line> ::= <indent> <checkbox-b-appearance-property> <line-end>
<checkbox-b-appearance-property> ::= "valuePlaceholder" ":" <ws> <string-like-value> (* applies when type supports PLACEHOLDER; type: TEXT *)
  | "icon" ":" <ws> <string-like-value> (* applies when type != NATIVE_SEARCH; type: ICON *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when type supports FORMAT_MASK_DATE and dataType in (DATE, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
<checkbox-b-source> ::= <indent> "source" <ws> "{" <line-end> { <checkbox-b-source-property-line> } <indent> "}" <line-end>
<checkbox-b-source-property-line> ::= <indent> <checkbox-b-source-property> <line-end>
<checkbox-b-source-property> ::= "databaseColumn" ":" <ws> <string-like-value> (* required; applies when type != NATIVE_SEARCH; type: TEXT *)
  | "dataType" ":" <ws> ( "varchar2" | "number" | "date" | "timestamp" | "timestampWithTimeZone" | "timestampWithLocalTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "clob" | "blob" | "boolean" | "rowid" | "bfile" | "sdoGeometry" ) (* required; applies when type != NATIVE_SEARCH; type: SELECT LIST *)
<checkbox-b-default> ::= <indent> "default" <ws> "{" <line-end> { <checkbox-b-default-property-line> } <indent> "}" <line-end>
<checkbox-b-default-property-line> ::= <indent> <checkbox-b-default-property> <line-end>
<checkbox-b-default-property> ::= "type" ":" <ws> ( "static" | "item" | "sqlQuerySingleValue" | "sqlQueryMultipleValues" | "expression" | "functionBody" | "sequence" ) (* applies when type supports SOURCE; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC_TEXT_WITH_SUBSTITUTIONS; type: TEXT EDITOR *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuerySingleValue" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "sqlQueryMultipleValues" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY_COLON; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "sequence" ":" <ws> <string-like-value> (* required; applies when type = SEQUENCE; type: TEXT *)
<checkbox-b-depending-on> ::= <indent> "dependingOn" <ws> "{" <line-end> { <checkbox-b-depending-on-property-line> } <indent> "}" <line-end>
<checkbox-b-depending-on-property-line> ::= <indent> <checkbox-b-depending-on-property> <line-end>
<checkbox-b-depending-on-property> ::= "checkbox" ":" <ws> <reference> (* applies when type != NATIVE_SEARCH; type: COMPONENT *)
  | "type" ":" <ws> ( "=" | "!=" | "inList" | "notInList" | "isNull" | "isNotNull" ) (* required; applies when checkbox is set; type: SELECT LIST *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (EQUALS, NOT_EQUALS); type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (IN_LIST, NOT_IN_LIST); type: TEXT *)
<checkbox-b-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <checkbox-b-server-side-condition-property-line> } <indent> "}" <line-end>
<checkbox-b-server-side-condition-property-line> ::= <indent> <checkbox-b-server-side-condition-property> <line-end>
<checkbox-b-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<checkbox-b-security> ::= <indent> "security" <ws> "{" <line-end> { <checkbox-b-security-property-line> } <indent> "}" <line-end>
<checkbox-b-security-property-line> ::= <indent> <checkbox-b-security-property> <line-end>
<checkbox-b-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
  | "encryptSessionState" ":" <ws> <boolean> (* required; applies when type supports ENCRYPT; type: YES NO *)
  | "escapeSpecialChars" ":" <ws> <boolean> (* required; applies when type supports ESCAPE_OUTPUT; type: YES NO *)
<checkbox-b-config> ::= <indent> "config" <ws> "{" <line-end> { <checkbox-b-config-property-line> } <indent> "}" <line-end>
<checkbox-b-config-property-line> ::= <indent> <checkbox-b-config-property> <line-end>
<checkbox-b-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<checkbox-b-comments> ::= <indent> "comments" <ws> "{" <line-end> { <checkbox-b-comments-property-line> } <indent> "}" <line-end>
<checkbox-b-comments-property-line> ::= <indent> <checkbox-b-comments-property> <line-end>
<checkbox-b-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* layer *)
(* direct properties use default group: identification *)
<layer> ::= "layer" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <layer-body-line> } <indent> ")" <line-end>
<layer-body-line> ::= <layer-direct-property-line>
  | <layer-group-block>
  | <layer-child-component>
<layer-direct-property-line> ::= <indent> <layer-direct-property> <line-end>
<layer-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "layerType" ":" <ws> ( "points" | "lines" | "polygons" | "heatMap" | "extrudedPolygons" ) (* required; type: SELECT LIST *)
<layer-group-block> ::= <layer-label>
  | <layer-layout>
  | <layer-source>
  | <layer-data-profile>
  | <layer-rest-synchronization>
  | <layer-external-filter-and-order-by>
  | <layer-local-post-processing>
  | <layer-remote-cache>
  | <layer-row-assignment>
  | <layer-column-mapping>
  | <layer-point-objects>
  | <layer-appearance>
  | <layer-point-clustering>
  | <layer-tooltip>
  | <layer-link>
  | <layer-info-window>
  | <layer-zoom-levels>
  | <layer-legend>
  | <layer-messages>
  | <layer-performance>
  | <layer-advanced>
  | <layer-server-side-condition>
  | <layer-security>
  | <layer-config>
  | <layer-comments>
<layer-label> ::= <indent> "label" <ws> "{" <line-end> { <layer-label-property-line> } <indent> "}" <line-end>
<layer-label-property-line> ::= <indent> <layer-label-property> <line-end>
<layer-label-property> ::= "label" ":" <ws> <string-like-value> (* type: TEXT *)
<layer-layout> ::= <indent> "layout" <ws> "{" <line-end> { <layer-layout-property-line> } <indent> "}" <line-end>
<layer-layout-property-line> ::= <indent> <layer-layout-property> <line-end>
<layer-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<layer-source> ::= <indent> "source" <ws> "{" <line-end> { <layer-source-property-line> } <indent> "}" <line-end>
<layer-source-property-line> ::= <indent> <layer-source-property> <line-end>
<layer-source-property> ::= "location" ":" <ws> ( "localDatabase" | "restEnabledSql" | "restSource" | "jsonDualityView" | "jsonSource" | "regionSource" | "sampleData" ) (* required; type: SELECT LIST *)
  | "remoteServer" ":" <ws> <reference> (* required; applies when location = REMOTE; type: COMPONENT *)
  | "sampleData" ":" <ws> ( "employees" | "tasks" | "products" | "projects" ) (* required; applies when location = SAMPLE_DATA; type: SELECT LIST *)
  | "type" ":" <ws> <string-like-value> (* required; applies when location in (LOCAL, REMOTE); type: SELECT LIST *)
  | "tableOwner" ":" <ws> <string-like-value> (* applies when type = TABLE; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type = TABLE; type: TABLE *)
  | "includeRowidColumn" ":" <ws> <boolean> (* required; applies when type = TABLE and remoteServer supports IS_ORACLE or not set; type: YES NO *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = TABLE; type: WHERE CLAUSE *)
  | "graphOwner" ":" <ws> <string-like-value> (* applies when type = GRAPH; type: OWNER *)
  | "graphName" ":" <ws> <string-like-value> (* required; applies when type = GRAPH; type: GRAPH *)
  | "matchClause" ":" <ws> <multiline-string> (* required; applies when type = GRAPH; type: TEXT EDITOR *)
  | "columnsClause" ":" <ws> <multiline-string> (* required; applies when type = GRAPH; type: TEXT EDITOR *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = GRAPH; type: WHERE CLAUSE *)
  | "orderByClause" ":" <ws> <multiline-string> (* applies when type = TABLE; type: ORDER BY CLAUSE *)
  | "orderByClause" ":" <ws> <multiline-string> (* applies when type = GRAPH; type: ORDER BY CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "restSource" ":" <ws> <reference> (* required; applies when location = WEB_SOURCE; type: COMPONENT *)
  | "jsonDualityView" ":" <ws> <reference> (* required; applies when location = DUALITY_VIEW; type: COMPONENT *)
  | "jsonSource" ":" <ws> <reference> (* required; applies when location = JSON_COLLECTION; type: COMPONENT *)
  | "pageItemsToSubmit" ":" <ws> <array-of-string-like-value> (* applies when location != REGION_SOURCE; type: ITEM *)
  | "optimizerHint" ":" <ws> <string-like-value> (* applies when location in (LOCAL, REMOTE, WEB_SOURCE, DUALITY_VIEW, JSON_COLLECTION); type: TEXT *)
  | "useSpatialIndex" ":" <ws> <boolean> (* required; applies when location in (LOCAL, REMOTE, REGION_SOURCE); type: YES NO *)
  | "useVectorTiles" ":" <ws> <boolean> (* required; applies when location = LOCAL and type in (TABLE, SQL) and lazyLoading = Y; type: YES NO *)
<layer-data-profile> ::= <indent> "dataProfile" <ws> "{" <line-end> { <layer-data-profile-property-line> } <indent> "}" <line-end>
<layer-data-profile-property-line> ::= <indent> <layer-data-profile-property> <line-end>
<layer-data-profile-property> ::= "nestedRows" ":" <ws> <reference> (* applies when restSource supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
  | "nestedRows" ":" <ws> <reference> (* applies when jsonDualityView supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
  | "nestedRows" ":" <ws> <reference> (* applies when jsonSource supports HAS_ARRAY_COLUMNS; type: COMPONENT *)
<layer-rest-synchronization> ::= <indent> "restSynchronization" <ws> "{" <line-end> { <layer-rest-synchronization-property-line> } <indent> "}" <line-end>
<layer-rest-synchronization-property-line> ::= <indent> <layer-rest-synchronization-property> <line-end>
<layer-rest-synchronization-property> ::= "useLocalTable" ":" <ws> <boolean> (* required; applies when restSource supports HAS_SYNC_HAS_NO_ARRAY_COLUMNS or property matches or nestedRows supports IS_SYNCED; type: YES NO *)
<layer-external-filter-and-order-by> ::= <indent> "externalFilterAndOrderBy" <ws> "{" <line-end> { <layer-external-filter-and-order-by-property-line> } <indent> "}" <line-end>
<layer-external-filter-and-order-by-property-line> ::= <indent> <layer-external-filter-and-order-by-property> <line-end>
<layer-external-filter-and-order-by-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when restSource is set and useLocalTable in (N, $NULL$) or not set; type: YES NO *)
  | "filter" ":" <ws> <multiline-string> (* applies when enabled = Y; type: TEXT EDITOR *)
  | "orderBy" ":" <ws> <multiline-string> (* applies when enabled = Y; type: TEXT EDITOR *)
<layer-local-post-processing> ::= <indent> "localPostProcessing" <ws> "{" <line-end> { <layer-local-post-processing-property-line> } <indent> "}" <line-end>
<layer-local-post-processing-property-line> ::= <indent> <layer-local-post-processing-property> <line-end>
<layer-local-post-processing-property> ::= "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when restSource is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "orderByClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: ORDER BY CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when jsonDualityView is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "orderByClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: ORDER BY CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
  | "type" ":" <ws> ( "whereOrderByClause" | "sqlQuery" | "plsqlFunctionBody" ) (* applies when jsonSource is set; type: SELECT LIST *)
  | "whereClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: WHERE CLAUSE *)
  | "orderByClause" ":" <ws> <multiline-string> (* applies when type = WHERE_ORDER_BY_CLAUSE; type: ORDER BY CLAUSE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNC_BODY_RETURNING_SQL; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY SQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY SQL *)
<layer-remote-cache> ::= <indent> "remoteCache" <ws> "{" <line-end> { <layer-remote-cache-property-line> } <indent> "}" <line-end>
<layer-remote-cache-property-line> ::= <indent> <layer-remote-cache-property> <line-end>
<layer-remote-cache-property> ::= "caching" ":" <ws> ( "allUsers" | "user" | "session" ) (* applies when location = REMOTE; type: SELECT LIST *)
  | "timeout" ":" <ws> <multiline-string> (* required; applies when caching is set; type: TEXT EDITOR *)
<layer-row-assignment> ::= <indent> "rowAssignment" <ws> "{" <line-end> { <layer-row-assignment-property-line> } <indent> "}" <line-end>
<layer-row-assignment-property-line> ::= <indent> <layer-row-assignment-property> <line-end>
<layer-row-assignment-property> ::= "column" ":" <ws> <string-like-value> (* applies when location = REGION_SOURCE; type: COLUMN *)
  | "valueForThisLayer" ":" <ws> <string-like-value> (* required; applies when column is set; type: TEXT *)
<layer-column-mapping> ::= <indent> "columnMapping" <ws> "{" <line-end> { <layer-column-mapping-property-line> } <indent> "}" <line-end>
<layer-column-mapping-property-line> ::= <indent> <layer-column-mapping-property> <line-end>
<layer-column-mapping-property> ::= "geometryColumnDataType" ":" <ws> <string-like-value> (* required; applies when location != REMOTE; type: SELECT LIST *)
  | "geometryColumnDataType" ":" <ws> ( "geojson" | "longitudeLatitude" ) (* required; applies when location = REMOTE; type: SELECT LIST *)
  | "geometryColumn" ":" <ws> <string-like-value> (* required; applies when geometryColumnDataType = SDO_GEOMETRY; type: COLUMN *)
  | "geojsonColumn" ":" <ws> <string-like-value> (* required; applies when geometryColumnDataType = GEOJSON or not set and geometryColumnDataType = GEOJSON or not set; type: COLUMN *)
  | "longitudeColumn" ":" <ws> <string-like-value> (* required; applies when geometryColumnDataType = LONLAT_COLUMNS or not set and geometryColumnDataType = LONLAT_COLUMNS or not set; type: COLUMN *)
  | "latitudeColumn" ":" <ws> <string-like-value> (* required; applies when geometryColumnDataType = LONLAT_COLUMNS or not set and geometryColumnDataType = LONLAT_COLUMNS or not set; type: COLUMN *)
  | "primaryKeyColumn" ":" <ws> <string-like-value> (* applies when location is set; type: COLUMN *)
<layer-point-objects> ::= <indent> "pointObjects" <ws> "{" <line-end> { <layer-point-objects-property-line> } <indent> "}" <line-end>
<layer-point-objects-property-line> ::= <indent> <layer-point-objects-property> <line-end>
<layer-point-objects-property> ::= "style" ":" <ws> ( "svg" | "icon" ) (* required; applies when layerType = POINT; type: SELECT LIST *)
  | "iconSource" ":" <ws> <string-like-value> (* required; applies when style = ICON; type: SELECT LIST *)
  | "iconColumn" ":" <ws> <string-like-value> (* required; applies when iconSource = DYNAMIC_CLASS; type: COLUMN *)
  | "imageUrl" ":" <ws> <string-like-value> (* required; applies when iconSource = URL; type: TEXT *)
  | "iconCssClasses" ":" <ws> <string-like-value> (* required; applies when iconSource = STATIC_CLASS; type: ICON *)
  | "shape" ":" <ws> <string-like-value> (* required; applies when style = SVG; type: COMBOBOX *)
  | "shapeScale" ":" <ws> <string-like-value> (* applies when style = SVG; type: TEXT *)
<layer-appearance> ::= <indent> "appearance" <ws> "{" <line-end> { <layer-appearance-property-line> } <indent> "}" <line-end>
<layer-appearance-property-line> ::= <indent> <layer-appearance-property> <line-end>
<layer-appearance-property> ::= "useColorScheme" ":" <ws> <boolean> (* required; type: YES NO *)
  | "colorScheme" ":" <ws> ( "sequential" | "diverging" | "qualitative" ) (* applies when useColorScheme = Y; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "burgundy" | "burgundyToYellow" | "redToOrange" | "orangeToYellow" | "peach" | "pinkToYellow" | "mint" | "blueToGreen" | "darkMint" | "emerald" | "blueToYellow" | "teal" | "tealToGreen" | "purple" | "purpleToOrange" | "sunset" | "magenta" | "darkSunset" | "brownToYellow" ) (* required; applies when colorScheme = SEQUENTIAL; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "armyToRose" | "fallColors" | "geyser" | "temps" | "tealToRose" | "tropicColors" | "earthColors" ) (* required; applies when colorScheme = DIVERGING; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "antique" | "bold" | "pastel" | "prism" | "safe" | "vivid" ) (* required; applies when colorScheme = QUALITATIVE; type: SELECT LIST *)
  | "colorScheme" ":" <ws> ( "sequential" | "diverging" | "qualitative" ) (* applies when layerType = HEATMAP; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "burgundy" | "burgundyToYellow" | "redToOrange" | "orangeToYellow" | "peach" | "pinkToYellow" | "mint" | "blueToGreen" | "darkMint" | "emerald" | "blueToYellow" | "teal" | "tealToGreen" | "purple" | "purpleToOrange" | "sunset" | "magenta" | "darkSunset" | "brownToYellow" ) (* required; applies when colorScheme = SEQUENTIAL; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "armyToRose" | "fallColors" | "geyser" | "temps" | "tealToRose" | "tropicColors" | "earthColors" ) (* required; applies when colorScheme = DIVERGING; type: SELECT LIST *)
  | "schemeName" ":" <ws> ( "antique" | "bold" | "pastel" | "prism" | "safe" | "vivid" ) (* required; applies when colorScheme = QUALITATIVE; type: SELECT LIST *)
  | "customColorList" ":" <ws> <multiline-string> (* required; applies when layerType = HEATMAP and colorScheme is not set; type: TEXT EDITOR *)
  | "fillColor" ":" <ws> <string-like-value> (* type: COLOR *)
  | "customColorList" ":" <ws> <multiline-string> (* required; applies when useColorScheme = Y and colorScheme is not set; type: TEXT EDITOR *)
  | "valueColumn" ":" <ws> <string-like-value> (* applies when layerType = HEATMAP; type: COLUMN *)
  | "colorValueColumn" ":" <ws> <string-like-value> (* required; type: COLUMN *)
  | "extrusionValueColumn" ":" <ws> <string-like-value> (* required; type: COLUMN *)
  | "unit" ":" <ws> ( "meter" | "kilometer" | "foot" | "mile" ) (* required; applies when extrusionValueColumn is set; type: SELECT LIST *)
  | "fillOpacity" ":" <ws> <string-like-value> (* type: TEXT *)
  | "strokeStyle" ":" <ws> <string-like-value> (* required; applies when layerType = LINE; type: COMBOBOX *)
  | "strokeColor" ":" <ws> <string-like-value> (* applies when layerType in (POLYGON, LINE); type: COLOR *)
  | "strokeWidth" ":" <ws> <string-like-value> (* applies when layerType in (POLYGON, LINE); type: TEXT *)
  | "fillColor" ":" <ws> <string-like-value> (* applies when layerType = POINT and iconSource in ($NULL$, STATIC_CLASS, DYNAMIC_CLASS) or not set; type: COLOR *)
  | "fillOpacity" ":" <ws> <string-like-value> (* applies when layerType = POINT and iconSource in ($NULL$, STATIC_CLASS, DYNAMIC_CLASS) or not set; type: TEXT *)
  | "strokeColor" ":" <ws> <string-like-value> (* applies when style = SVG and useColorScheme in (N, $NULL$) or not set; type: COLOR *)
  | "strokeWidth" ":" <ws> <string-like-value> (* applies when style = SVG and useColorScheme in (N, $NULL$) or not set; type: TEXT *)
<layer-point-clustering> ::= <indent> "pointClustering" <ws> "{" <line-end> { <layer-point-clustering-property-line> } <indent> "}" <line-end>
<layer-point-clustering-property-line> ::= <indent> <layer-point-clustering-property> <line-end>
<layer-point-clustering-property> ::= "enable" ":" <ws> <boolean> (* required; applies when layerType = POINT and useVectorTiles in (N, $NULL$) or not set; type: YES NO *)
  | "clusteringRadius" ":" <ws> <number> (* required; applies when enable = Y; type: INTEGER *)
  | "iconUrl" ":" <ws> <string-like-value> (* required; applies when iconSource = URL and enable = Y; type: TEXT *)
  | "iconCssClasses" ":" <ws> <string-like-value> (* required; applies when iconSource in (STATIC_CLASS, DYNAMIC_CLASS) and enable = Y; type: ICON *)
  | "shape" ":" <ws> <string-like-value> (* required; applies when style = SVG and enable = Y; type: COMBOBOX *)
  | "fillColor" ":" <ws> <string-like-value> (* applies when iconSource in ($NULL$, STATIC_CLASS, DYNAMIC_CLASS) or not set and enable = Y; type: COLOR *)
  | "shapeScale" ":" <ws> <string-like-value> (* applies when style = SVG and enable = Y; type: TEXT *)
  | "tooltip" ":" <ws> <multiline-string> (* applies when enable = Y; type: HTML *)
<layer-tooltip> ::= <indent> "tooltip" <ws> "{" <line-end> { <layer-tooltip-property-line> } <indent> "}" <line-end>
<layer-tooltip-property-line> ::= <indent> <layer-tooltip-property> <line-end>
<layer-tooltip-property> ::= "advancedFormatting" ":" <ws> <boolean> (* required; applies when layerType != HEATMAP; type: YES NO *)
  | "column" ":" <ws> <string-like-value> (* applies when advancedFormatting = N; type: COLUMN *)
  | "htmlExpression" ":" <ws> <multiline-string> (* applies when advancedFormatting = Y; type: HTML *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when advancedFormatting = Y; type: COMBOBOX *)
<layer-link> ::= <indent> "link" <ws> "{" <line-end> { <layer-link-property-line> } <indent> "}" <line-end>
<layer-link-property-line> ::= <indent> <layer-link-property> <line-end>
<layer-link-property> ::= "type" ":" <ws> <string-like-value> (* applies when layerType != HEATMAP; type: SELECT LIST *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_PAGE; type: LINK_IN_APP *)
  | "target" ":" <ws> <value> (* required; applies when type = REDIRECT_APP; type: LINK_IN_DIFF_APP *)
  | "targetUrl" ":" <ws> <string-like-value> (* required; applies when type = REDIRECT_URL; type: TEXT *)
<layer-info-window> ::= <indent> "infoWindow" <ws> "{" <line-end> { <layer-info-window-property-line> } <indent> "}" <line-end>
<layer-info-window-property-line> ::= <indent> <layer-info-window-property> <line-end>
<layer-info-window-property> ::= "advancedFormatting" ":" <ws> <boolean> (* required; applies when layerType != HEATMAP and type is not set; type: YES NO *)
  | "titleColumn" ":" <ws> <string-like-value> (* applies when advancedFormatting = N and type is not set; type: COLUMN *)
  | "bodyColumn" ":" <ws> <string-like-value> (* applies when advancedFormatting = N and type is not set; type: COLUMN *)
  | "htmlExpression" ":" <ws> <multiline-string> (* applies when advancedFormatting = Y; type: HTML *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when advancedFormatting = Y; type: COMBOBOX *)
<layer-zoom-levels> ::= <indent> "zoomLevels" <ws> "{" <line-end> { <layer-zoom-levels-property-line> } <indent> "}" <line-end>
<layer-zoom-levels-property-line> ::= <indent> <layer-zoom-levels-property> <line-end>
<layer-zoom-levels-property> ::= "min" ":" <ws> <string-like-value> (* type: TEXT *)
  | "max" ":" <ws> <string-like-value> (* type: TEXT *)
<layer-legend> ::= <indent> "legend" <ws> "{" <line-end> { <layer-legend-property-line> } <indent> "}" <line-end>
<layer-legend-property-line> ::= <indent> <layer-legend-property> <line-end>
<layer-legend-property> ::= "show" ":" <ws> <boolean> (* required; type: YES NO *)
  | "advancedFormatting" ":" <ws> <boolean> (* required; applies when show = Y; type: YES NO *)
  | "htmlExpression" ":" <ws> <multiline-string> (* required; applies when advancedFormatting = Y; type: HTML *)
  | "enableToHide" ":" <ws> <boolean> (* required; applies when advancedFormatting = N; type: YES NO *)
  | "iconCssClasses" ":" <ws> <string-like-value> (* applies when advancedFormatting = N; type: ICON *)
<layer-messages> ::= <indent> "messages" <ws> "{" <line-end> { <layer-messages-property-line> } <indent> "}" <line-end>
<layer-messages-property-line> ::= <indent> <layer-messages-property> <line-end>
<layer-messages-property> ::= "whenNoDataFound" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
  | "noDataFoundIcon" ":" <ws> <string-like-value> (* applies when whenNoDataFound is set; type: ICON *)
  | "whenMoreDataFound" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<layer-performance> ::= <indent> "performance" <ws> "{" <line-end> { <layer-performance-property-line> } <indent> "}" <line-end>
<layer-performance-property-line> ::= <indent> <layer-performance-property> <line-end>
<layer-performance-property> ::= "maxRowsToProcess" ":" <ws> <number> (* applies when useVectorTiles in (N, $NULL$); type: INTEGER *)
<layer-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <layer-advanced-property-line> } <indent> "}" <line-end>
<layer-advanced-property-line> ::= <indent> <layer-advanced-property> <line-end>
<layer-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "maxObjectsPerTile" ":" <ws> <number> (* applies when useVectorTiles = Y; type: INTEGER *)
<layer-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <layer-server-side-condition-property-line> } <indent> "}" <line-end>
<layer-server-side-condition-property-line> ::= <indent> <layer-server-side-condition-property> <line-end>
<layer-server-side-condition-property> ::= "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when type is set and type != NEVER; type: SELECT LIST *)
<layer-security> ::= <indent> "security" <ws> "{" <line-end> { <layer-security-property-line> } <indent> "}" <line-end>
<layer-security-property-line> ::= <indent> <layer-security-property> <line-end>
<layer-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<layer-config> ::= <indent> "config" <ws> "{" <line-end> { <layer-config-property-line> } <indent> "}" <line-end>
<layer-config-property-line> ::= <indent> <layer-config-property> <line-end>
<layer-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<layer-comments> ::= <indent> "comments" <ws> "{" <line-end> { <layer-comments-property-line> } <indent> "}" <line-end>
<layer-comments-property-line> ::= <indent> <layer-comments-property> <line-end>
<layer-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<layer-child-component> ::= <parameter-m>

(* parameter *)
(* direct properties use default group: identification *)
<parameter-m> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-m-body-line> } <indent> ")" <line-end>
<parameter-m-body-line> ::= <parameter-m-direct-property-line>
  | <parameter-m-group-block>
<parameter-m-direct-property-line> ::= <indent> <parameter-m-direct-property> <line-end>
<parameter-m-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-m-group-block> ::= <parameter-m-parameter>
  | <parameter-m-value>
<parameter-m-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-m-parameter-property-line> } <indent> "}" <line-end>
<parameter-m-parameter-property-line> ::= <indent> <parameter-m-parameter-property> <line-end>
<parameter-m-parameter-property> ::= "ignoreOutput" ":" <ws> <boolean> (* required; applies when name supports IN_OUT_PARAMETER and name NOT_FEATURES FETCH_COLLECTION_OPERATION_PRM; type: YES NO *)
<parameter-m-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-m-value-property-line> } <indent> "}" <line-end>
<parameter-m-value-property-line> ::= <indent> <parameter-m-value-property> <line-end>
<parameter-m-value-property> ::= "type" ":" <ws> ( "staticValue" | "restSourceDefault" | "item" | "sqlQuery" | "expression" | "functionBody" | "collectionClob" | "preference" | "parentColumn" | "null" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = COLLECTION; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, DATE_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ_PARAMETER and type in (STATIC, ITEM, PREFERENCE); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "column" ":" <ws> <reference> (* required; applies when type = PARENT_COLUMN; type: COMPONENT *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-l> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-l-body-line> } <indent> ")" <line-end>
<parameter-l-body-line> ::= <parameter-l-direct-property-line>
  | <parameter-l-group-block>
<parameter-l-direct-property-line> ::= <indent> <parameter-l-direct-property> <line-end>
<parameter-l-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-l-group-block> ::= <parameter-l-parameter>
  | <parameter-l-value>
<parameter-l-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-l-parameter-property-line> } <indent> "}" <line-end>
<parameter-l-parameter-property-line> ::= <indent> <parameter-l-parameter-property> <line-end>
<parameter-l-parameter-property> ::= "ignoreOutput" ":" <ws> <boolean> (* required; applies when name supports IN_OUT_PARAMETER, OUT_PARAMETER and name NOT_FEATURES FETCH_COLLECTION_OPERATION_PRM and property matches; type: YES NO *)
<parameter-l-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-l-value-property-line> } <indent> "}" <line-end>
<parameter-l-value-property-line> ::= <indent> <parameter-l-value-property> <line-end>
<parameter-l-value-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when name supports IN_PARAMETER, IN_OUT_PARAMETER or ignoreOutput = N; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = COLLECTION; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, DATE_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ_PARAMETER and type in (STATIC, ITEM, PREFERENCE); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "column" ":" <ws> <reference> (* required; applies when type = PARENT_COLUMN; type: COMPONENT *)

(* savedReport *)
(* direct properties use default group: identification *)
<saved-report-a> ::= "savedReport" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <saved-report-a-body-line> } <indent> ")" <line-end>
<saved-report-a-body-line> ::= <saved-report-a-direct-property-line>
  | <saved-report-a-group-block>
  | <saved-report-a-child-component>
<saved-report-a-direct-property-line> ::= <indent> <saved-report-a-direct-property> <line-end>
<saved-report-a-direct-property> ::= "visibility" ":" <ws> ( "primaryDefault" | "alternativeDefault" | "public" | "private" ) (* required; type: SELECT LIST *)
  | "name" ":" <ws> <string-like-value> (* required; applies when visibility != PRIMARY_DEFAULT; type: TEXT *)
  | "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<saved-report-a-group-block> ::= <saved-report-a-chart>
  | <saved-report-a-axis-title>
  | <saved-report-a-description>
  | <saved-report-a-settings>
  | <saved-report-a-sort>
  | <saved-report-a-view>
  | <saved-report-a-chart-appearance>
  | <saved-report-a-flashback>
<saved-report-a-chart> ::= <indent> "chart" <ws> "{" <line-end> { <saved-report-a-chart-property-line> } <indent> "}" <line-end>
<saved-report-a-chart-property-line> ::= <indent> <saved-report-a-chart-property> <line-end>
<saved-report-a-chart-property> ::= "type" ":" <ws> ( "bar" | "lineWithArea" | "pie" | "line" ) (* required; type: SELECT LIST *)
  | "label" ":" <ws> <string-like-value> (* required; type: COLUMN *)
  | "value" ":" <ws> <string-like-value> (* required; type: COLUMN *)
  | "valueAggregation" ":" <ws> ( "sum" | "average" | "min" | "max" | "count" ) (* type: SELECT LIST *)
<saved-report-a-axis-title> ::= <indent> "axisTitle" <ws> "{" <line-end> { <saved-report-a-axis-title-property-line> } <indent> "}" <line-end>
<saved-report-a-axis-title-property-line> ::= <indent> <saved-report-a-axis-title-property> <line-end>
<saved-report-a-axis-title-property> ::= "label" ":" <ws> <string-like-value> (* applies when type != pie; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* applies when type != pie; type: TEXT *)
