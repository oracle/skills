<page-item-help-property> ::= "inlineHelpText" ":" <ws> <multiline-string> (* type: HTML *)
  | "helpText" ":" <ws> <multiline-string> (* type: HTML *)
<page-item-config> ::= <indent> "config" <ws> "{" <line-end> { <page-item-config-property-line> } <indent> "}" <line-end>
<page-item-config-property-line> ::= <indent> <page-item-config-property> <line-end>
<page-item-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<page-item-comments> ::= <indent> "comments" <ws> "{" <line-end> { <page-item-comments-property-line> } <indent> "}" <line-end>
<page-item-comments-property-line> ::= <indent> <page-item-comments-property> <line-end>
<page-item-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* process *)
(* direct properties use default group: identification *)
<process> ::= "process" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <process-body-line> } <indent> ")" <line-end>
<process-body-line> ::= <process-direct-property-line>
  | <process-group-block>
  | <process-child-component>
<process-direct-property-line> ::= <indent> <process-direct-property> <line-end>
<process-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
  | "executionChain" ":" <ws> <string-like-value> (* type: SELECT LIST *)
  | "formRegion" ":" <ws> <reference> (* required; applies when type supports FORM; type: COMPONENT *)
  | "editableRegion" ":" <ws> <reference> (* required; applies when type supports REGION and property matches; type: COMPONENT *)
<process-group-block> ::= <process-gen-ai>
  | <process-source>
  | <process-execution>
  | <process-success-message>
  | <process-error>
  | <process-advanced>
  | <process-server-side-condition>
  | <process-security>
  | <process-config>
  | <process-comments>
<process-gen-ai> ::= <indent> "genAI" <ws> "{" <line-end> { <process-gen-ai-property-line> } <indent> "}" <line-end>
<process-gen-ai-property-line> ::= <indent> <process-gen-ai-property> <line-end>
<process-gen-ai-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when type supports AI_ENABLED; type: YES NO *)
  | "agent" ":" <ws> <reference> (* applies when type supports AI_ENABLED_ALWAYS, AI_ENABLED and enabled = Y or not set; type: COMPONENT *)
  | "service" ":" <ws> <reference> (* applies when agent is not set; type: COMPONENT *)
  | "systemPrompt" ":" <ws> <multiline-string> (* applies when type supports AI_SYSTEM_PROMPT and agent is not set; type: TEXT EDITOR *)
<process-source> ::= <indent> "source" <ws> "{" <line-end> { <process-source-property-line> } <indent> "}" <line-end>
<process-source-property-line> ::= <indent> <process-source-property> <line-end>
<process-source-property> ::= "location" ":" <ws> ( "localDatabase" | "restEnabledSql" ) (* required; applies when type = NATIVE_PLSQL; type: SELECT LIST *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when location = LOCAL; type: CODE LANGUAGE *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL *)
  | "javaScriptCode" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT *)
  | "remoteServer" ":" <ws> <reference> (* required; applies when location = REMOTE; type: COMPONENT *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when location = REMOTE; type: PLSQL *)
<process-execution> ::= <indent> "execution" <ws> "{" <line-end> { <process-execution-property-line> } <indent> "}" <line-end>
<process-execution-property-line> ::= <indent> <process-execution-property> <line-end>
<process-execution-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
  | "point" ":" <ws> <string-like-value> (* required; applies when executionChain is not set; type: SELECT LIST *)
  | "runProcess" ":" <ws> ( "oncePerSessionOrWhenReset" | "oncePerPageVisitDefault" ) (* required; applies when executionChain is not set; type: SELECT LIST *)
<process-success-message> ::= <indent> "successMessage" <ws> "{" <line-end> { <process-success-message-property-line> } <indent> "}" <line-end>
<process-success-message-property-line> ::= <indent> <process-success-message-property> <line-end>
<process-success-message-property> ::= "successMessage" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<process-error> ::= <indent> "error" <ws> "{" <line-end> { <process-error-property-line> } <indent> "}" <line-end>
<process-error-property-line> ::= <indent> <process-error-property> <line-end>
<process-error-property> ::= "errorMessage" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
  | "displayLocation" ":" <ws> ( "inlineInNotification" | "onErrorPage" ) (* required; applies when point in (ON_SUBMIT_BEFORE_COMPUTATION, AFTER_SUBMIT); type: SELECT LIST *)
<process-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <process-advanced-property-line> } <indent> "}" <line-end>
<process-advanced-property-line> ::= <indent> <process-advanced-property> <line-end>
<process-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "executionMappingIdentifier" ":" <ws> <string-like-value> (* type: HIDDEN *)
<process-server-side-condition> ::= <indent> "serverSideCondition" <ws> "{" <line-end> { <process-server-side-condition-property-line> } <indent> "}" <line-end>
<process-server-side-condition-property-line> ::= <indent> <process-server-side-condition-property> <line-end>
<process-server-side-condition-property> ::= "whenButtonPressed" ":" <ws> <reference> (* type: COMPONENT *)
  | "executionScope" ":" <ws> ( "forCreatedAndModifiedRows" | "allSubmittedRows" ) (* required; applies when editableRegion is set; type: SELECT LIST *)
  | "type" ":" <ws> <string-like-value> (* type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when type in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when type in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when type in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when type in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
  | "executeCondition" ":" <ws> ( "forEachRow" | "once" ) (* required; applies when editableRegion is set and type is set and type != NEVER; type: SELECT LIST *)
<process-security> ::= <indent> "security" <ws> "{" <line-end> { <process-security-property-line> } <indent> "}" <line-end>
<process-security-property-line> ::= <indent> <process-security-property> <line-end>
<process-security-property> ::= "authorizationScheme" ":" <ws> <reference> (* type: COMPONENT *)
<process-config> ::= <indent> "config" <ws> "{" <line-end> { <process-config-property-line> } <indent> "}" <line-end>
<process-config-property-line> ::= <indent> <process-config-property> <line-end>
<process-config-property> ::= "buildOption" ":" <ws> <reference> (* type: COMPONENT *)
<process-comments> ::= <indent> "comments" <ws> "{" <line-end> { <process-comments-property-line> } <indent> "}" <line-end>
<process-comments-property-line> ::= <indent> <process-comments-property> <line-end>
<process-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<process-child-component> ::= <basic-authentication-parameter>
  | <in-parameter>
  | <out-parameter>
  | <parameter-i>
  | <parameter-j>
  | <parameter-n>
  | <parameter-p>

(* basicAuthenticationParameter *)
(* direct properties use default group: identification *)
<basic-authentication-parameter> ::= "basicAuthenticationParameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <basic-authentication-parameter-body-line> } <indent> ")" <line-end>
<basic-authentication-parameter-body-line> ::= <basic-authentication-parameter-direct-property-line>
  | <basic-authentication-parameter-group-block>
<basic-authentication-parameter-direct-property-line> ::= <indent> <basic-authentication-parameter-direct-property> <line-end>
<basic-authentication-parameter-direct-property> ::= "parameterId" ":" <ws> <string-like-value> (* required; type: HIDDEN *)
  | "name" ":" <ws> <string-like-value> (* type: TEXT *)
<basic-authentication-parameter-group-block> ::= <basic-authentication-parameter-parameter>
<basic-authentication-parameter-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <basic-authentication-parameter-parameter-property-line> } <indent> "}" <line-end>
<basic-authentication-parameter-parameter-property-line> ::= <indent> <basic-authentication-parameter-parameter-property> <line-end>
<basic-authentication-parameter-parameter-property> ::= "source" ":" <ws> ( "item" | "staticValue" | "plsqlFunctionBody" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <string-like-value> (* applies when source = STATIC; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; applies when source = ITEM; type: ITEM *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when source = FUNCTION *)

(* inParameter *)
(* direct properties use default group: identification *)
<in-parameter> ::= "inParameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <in-parameter-body-line> } <indent> ")" <line-end>
<in-parameter-body-line> ::= <in-parameter-direct-property-line>
  | <in-parameter-group-block>
<in-parameter-direct-property-line> ::= <indent> <in-parameter-direct-property> <line-end>
<in-parameter-direct-property> ::= "parameterId" ":" <ws> <string-like-value> (* required; type: HIDDEN *)
  | "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<in-parameter-group-block> ::= <in-parameter-parameter>
<in-parameter-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <in-parameter-parameter-property-line> } <indent> "}" <line-end>
<in-parameter-parameter-property-line> ::= <indent> <in-parameter-parameter-property> <line-end>
<in-parameter-parameter-property> ::= "source" ":" <ws> ( "item" | "staticValue" | "plsqlFunctionBody" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <string-like-value> (* applies when source = STATIC; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; applies when source = ITEM; type: ITEM *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when source = FUNCTION *)

(* outParameter *)
(* direct properties use default group: identification *)
<out-parameter> ::= "outParameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <out-parameter-body-line> } <indent> ")" <line-end>
<out-parameter-body-line> ::= <out-parameter-direct-property-line>
  | <out-parameter-group-block>
<out-parameter-direct-property-line> ::= <indent> <out-parameter-direct-property> <line-end>
<out-parameter-direct-property> ::= "parameterId" ":" <ws> <string-like-value> (* required; type: HIDDEN *)
  | "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<out-parameter-group-block> ::= <out-parameter-parameter>
<out-parameter-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <out-parameter-parameter-property-line> } <indent> "}" <line-end>
<out-parameter-parameter-property-line> ::= <indent> <out-parameter-parameter-property> <line-end>
<out-parameter-parameter-property> ::= "items" ":" <ws> <array-of-string-like-value> (* type: ITEM *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-i> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-i-body-line> } <indent> ")" <line-end>
<parameter-i-body-line> ::= <parameter-i-direct-property-line>
  | <parameter-i-group-block>
<parameter-i-direct-property-line> ::= <indent> <parameter-i-direct-property> <line-end>
<parameter-i-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-i-group-block> ::= <parameter-i-parameter>
  | <parameter-i-value>
<parameter-i-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-i-parameter-property-line> } <indent> "}" <line-end>
<parameter-i-parameter-property-line> ::= <indent> <parameter-i-parameter-property> <line-end>
<parameter-i-parameter-property> ::= "ignoreOutput" ":" <ws> <boolean> (* required; applies when name supports IN_OUT_PARAMETER, OUT_PARAMETER; type: YES NO *)
<parameter-i-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-i-value-property-line> } <indent> "}" <line-end>
<parameter-i-value-property-line> ::= <indent> <parameter-i-value-property> <line-end>
<parameter-i-value-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when name supports IN_PARAMETER, IN_OUT_PARAMETER or ignoreOutput = N; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = COLLECTION; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, DATE_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ_PARAMETER and type in (STATIC, ITEM, PREFERENCE); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when name supports BOOLEAN_PARAMETER and type in (ITEM, PREFERENCE); type: TEXT *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-j> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-j-body-line> } <indent> ")" <line-end>
<parameter-j-body-line> ::= <parameter-j-direct-property-line>
  | <parameter-j-group-block>
<parameter-j-direct-property-line> ::= <indent> <parameter-j-direct-property> <line-end>
<parameter-j-direct-property> ::= "type" ":" <ws> ( "parameter" | "functionResult" ) (* required; type: SELECT LIST *)
  | "name" ":" <ws> <string-like-value> (* required; applies when type = PARAMETER; type: TEXT *)
<parameter-j-group-block> ::= <parameter-j-parameter>
  | <parameter-j-value>
  | <parameter-j-advanced>
  | <parameter-j-comments>
<parameter-j-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-j-parameter-property-line> } <indent> "}" <line-end>
<parameter-j-parameter-property-line> ::= <indent> <parameter-j-parameter-property> <line-end>
<parameter-j-parameter-property> ::= "direction" ":" <ws> ( "in" | "out" | "inOut" ) (* required; applies when type = PARAMETER; type: SELECT LIST *)
  | "dataType" ":" <ws> ( "varchar2" | "clob" | "number" | "plsqlInteger" | "boolean" | "date" | "timestamp" | "timestampWithLocalTimeZone" | "timestampWithTimeZone" | "intervalYearToMonth" | "intervalDayToSecond" | "blob" | "char" | "rowid" | "custom" ) (* required; type: SELECT LIST *)
  | "dataTypeName" ":" <ws> <string-like-value> (* required; applies when dataType = CUSTOM; type: TEXT *)
  | "hasDefault" ":" <ws> <boolean> (* required; applies when direction = IN; type: YES NO *)
  | "ignoreOutput" ":" <ws> <boolean> (* required; applies when direction in (IN_OUT, OUT) or not set and dataType not in (CUSTOM, BLOB); type: YES NO *)
<parameter-j-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-j-value-property-line> } <indent> "}" <line-end>
<parameter-j-value-property-line> ::= <indent> <parameter-j-value-property> <line-end>
<parameter-j-value-property> ::= "type" ":" <ws> <string-like-value> (* required; applies when direction in (IN, IN_OUT) and ignoreOutput = Y or not set; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and dataType != BOOLEAN; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and dataType = BOOLEAN; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM or ignoreOutput = N; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION and dataType != CUSTOM; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY and dataType != CUSTOM; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when type = EXPRESSION and dataType = CUSTOM; type: PLSQL EXPRESSION CUSTOM *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when type = FUNCTION_BODY and dataType = CUSTOM; type: PLSQL FUNCTION BODY CUSTOM *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when dataType in (NUMBER, DATE, TIMESTAMP, TIMESTAMP WITH TIME ZONE, TIMESTAMP WITH LOCAL TIME ZONE) and property matches; type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN and property matches; type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN and property matches; type: TEXT *)
<parameter-j-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <parameter-j-advanced-property-line> } <indent> "}" <line-end>
<parameter-j-advanced-property-line> ::= <indent> <parameter-j-advanced-property> <line-end>
<parameter-j-advanced-property> ::= "displaySequence" ":" <ws> <number> (* required; type: INTEGER *)
<parameter-j-comments> ::= <indent> "comments" <ws> "{" <line-end> { <parameter-j-comments-property-line> } <indent> "}" <line-end>
<parameter-j-comments-property-line> ::= <indent> <parameter-j-comments-property> <line-end>
<parameter-j-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-n> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-n-body-line> } <indent> ")" <line-end>
<parameter-n-body-line> ::= <parameter-n-direct-property-line>
  | <parameter-n-group-block>
<parameter-n-direct-property-line> ::= <indent> <parameter-n-direct-property> <line-end>
<parameter-n-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-n-group-block> ::= <parameter-n-value>
<parameter-n-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-n-value-property-line> } <indent> "}" <line-end>
<parameter-n-value-property-line> ::= <indent> <parameter-n-value-property> <line-end>
<parameter-n-value-property> ::= "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "preference" | "null" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC; type: TEXT EDITOR *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT *)
  | "preference" ":" <ws> <string-like-value> (* required; applies when type = PREFERENCE; type: TEXT *)

(* parameter *)
(* direct properties use default group: identification *)
<parameter-p> ::= "parameter" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <parameter-p-body-line> } <indent> ")" <line-end>
<parameter-p-body-line> ::= <parameter-p-direct-property-line>
  | <parameter-p-group-block>
<parameter-p-direct-property-line> ::= <indent> <parameter-p-direct-property> <line-end>
<parameter-p-direct-property> ::= "name" ":" <ws> <reference> (* required; type: COMPONENT *)
<parameter-p-group-block> ::= <parameter-p-value>
<parameter-p-value> ::= <indent> "value" <ws> "{" <line-end> { <parameter-p-value-property-line> } <indent> "}" <line-end>
<parameter-p-value-property-line> ::= <indent> <parameter-p-value-property> <line-end>
<parameter-p-value-property> ::= "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "preference" | "default" | "null" ) (* required; applies when name supports IN_PARAMETER, IN_OUT_PARAMETER; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and name NOT_FEATURES BOOLEAN_PARAMETER; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and name supports BOOLEAN_PARAMETER; type: SELECT LIST *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "formatMask" ":" <ws> <string-like-value> (* applies when name supports NUMBER_PARAMETER, TIMESTAMP_PARAMETER, TIMESTAMP_TZ__PARAMETER, TIMESTAMP_LTZ__PARAMETER and type in (STATIC, ITEM); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when type in (ITEM, PREFERENCE) and name supports BOOLEAN_PARAMETER; type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when type in (ITEM, PREFERENCE) and name supports BOOLEAN_PARAMETER; type: TEXT *)

(* region *)
(* direct properties use default group: identification *)
<region> ::= "region" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <region-body-line> } <indent> ")" <line-end>
<region-body-line> ::= <region-direct-property-line>
  | <region-group-block>
  | <region-child-component>
<region-direct-property-line> ::= <indent> <region-direct-property> <line-end>
<region-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "title" ":" <ws> <string-like-value> (* type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<region-group-block> ::= <region-chart>
  | <region-component-appearance>
  | <region-edit>
  | <region-link>
  | <region-map>
  | <region-output>
  | <region-page>
  | <region-report-layout>
  | <region-title>
  | <region-chart-appearance>
  | <region-card>
  | <region-source>
  | <region-controls>
  | <region-edit-authorization>
  | <region-page-header>
  | <region-chart-layout>
  | <region-initial-position-and-zoom>
  | <region-performance>
  | <region-pagination>
  | <region-gauge>
  | <region-column-headings>
  | <region-messages>
  | <region-subtitle>
  | <region-toolbar>
  | <region-break-formatting>
  | <region-data-cursor>
  | <region-columns>
  | <region-body>
  | <region-enable-users-to>
  | <region-multi-series-chart-data>
  | <region-bounding-box>
  | <region-page-footer>
  | <region-secondary-body>
  | <region-settings>
  | <region-download>
  | <region-component-advanced>
  | <region-single-row-view>
  | <region-icon-and-badge>
  | <region-heading>
  | <region-icon-view>
  | <region-overview>
  | <region-legend>
  | <region-printing>
  | <region-value>
  | <region-external-processing>
  | <region-gen-ai>
  | <region-media>
  | <region-attributes>
  | <region-search-bar>
  | <region-order-by>
  | <region-detail-view>
  | <region-actions-menu>
  | <region-animation>
  | <region-data-profile>
  | <region-blob-attributes>
  | <region-tooltip>
  | <region-rest-synchronization>
  | <region-external-filter-and-order-by>
  | <region-advanced>
  | <region-help>
  | <region-local-post-processing>
  | <region-auto-refresh>
  | <region-remote-cache>
  | <region-layout>
  | <region-description>
  | <region-appearance>
  | <region-accessibility>
  | <region-image>
  | <region-master-detail>
  | <region-header-and-footer>
  | <region-server-side-condition>
  | <region-read-only>
  | <region-security>
  | <region-server-cache>
  | <region-customization>
  | <region-config>
  | <region-comments>
  | <region-row-selection>
  | <region-entity-title>
<region-chart> ::= <indent> "chart" <ws> "{" <line-end> { <region-chart-property-line> } <indent> "}" <line-end>
<region-chart-property-line> ::= <indent> <region-chart-property> <line-end>
<region-chart-property> ::= "type" ":" <ws> ( "area" | "bar" | "boxPlot" | "bubble" | "combination" | "statusMeterGauge" | "donut" | "funnel" | "gantt" | "line" | "lineWithArea" | "pie" | "polar" | "pyramid" | "radar" | "range" | "scatter" | "stock" ) (* required; type: SELECT LIST *)
<region-component-appearance> ::= <indent> "componentAppearance" <ws> "{" <line-end> { <region-component-appearance-property-line> } <indent> "}" <line-end>
<region-component-appearance-property-line> ::= <indent> <region-component-appearance-property> <line-end>
<region-component-appearance-property> ::= "display" ":" <ws> <string-like-value> (* required; applies when type starts with TMPL_; type: SELECT LIST *)
  | "layout" ":" <ws> ( "grid" | "float" | "horizontal" ) (* required; type: SELECT LIST *)
  | "gridColumns" ":" <ws> ( "2" | "3" | "4" | "5" ) (* applies when layout = GRID; type: SELECT LIST *)
  | "listTemplate" ":" <ws> <reference> (* required; applies when type = NATIVE_LIST; type: COMPONENT *)
  | "breadcrumbTemplate" ":" <ws> <reference> (* required; applies when type = NATIVE_BREADCRUMB; type: COMPONENT *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* type: COMBOBOX *)
  | "templateOptions" ":" <ws> <array-of-string-like-value> (* applies when breadcrumbTemplate is set or listTemplate is set; type: TEMPLATE OPTIONS *)
  | "templateType" ":" <ws> ( "theme" | "predefined" ) (* required; type: SELECT LIST *)
  | "templateType" ":" <ws> ( "theme" | "predefined" ) (* required; type: SELECT LIST *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when type starts with NATIVE_BREADCRUMB, NATIVE_LIST, TMPL_; type: COMBOBOX *)
  | "template" ":" <ws> <reference> (* required; applies when templateType = THEME; type: COMPONENT *)
  | "template" ":" <ws> <reference> (* required; applies when templateType = THEME; type: COMPONENT *)
  | "template" ":" <ws> ( "html" | "verticalReport" | "csv" | "xml" ) (* required; applies when templateType = PREDEFINED; type: SELECT LIST *)
  | "template" ":" <ws> ( "html" | "verticalReport" | "csv" | "xml" ) (* required; applies when templateType = PREDEFINED; type: SELECT LIST *)
  | "templateOptions" ":" <ws> <array-of-string-like-value> (* applies when template is set; type: TEMPLATE OPTIONS *)
  | "templateOptions" ":" <ws> <array-of-string-like-value> (* applies when template is set; type: TEMPLATE OPTIONS *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when templateType = THEME; type: COMBOBOX *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when templateType = THEME; type: COMBOBOX *)
  | "customAttributes" ":" <ws> <string-like-value> (* type: COMBOBOX *)
  | "customAttributes" ":" <ws> <string-like-value> (* type: COMBOBOX *)
  | "showNullValuesAs" ":" <ws> <string-like-value> (* type: TEXT *)
  | "showNullValuesAs" ":" <ws> <string-like-value> (* type: TEXT *)
  | "showNullValuesAs" ":" <ws> <string-like-value> (* type: TEXT *)
  | "selectFirstRow" ":" <ws> <boolean> (* required; type: YES NO *)
  | "fixedRowHeight" ":" <ws> <boolean> (* required; type: YES NO *)
  | "showNullValuesAs" ":" <ws> <string-like-value> (* type: TEXT *)
<region-edit> ::= <indent> "edit" <ws> "{" <line-end> { <region-edit-property-line> } <indent> "}" <line-end>
<region-edit-property-line> ::= <indent> <region-edit-property> <line-end>
<region-edit-property> ::= "enabled" ":" <ws> <boolean> (* required; type: YES NO *)
  | "allowedOperations" ":" <ws> <array-of-string-like-value> (* applies when enabled = Y; type: CHECKBOXES *)
  | "allowedRowOperationsColumn" ":" <ws> <string-like-value> (* applies when allowedOperations in (u, d); type: REGION COLUMN *)
  | "lostUpdateType" ":" <ws> ( "rowValues" | "rowVersionColumn" ) (* required; applies when enabled = Y; type: SELECT LIST *)
  | "rowVersionColumn" ":" <ws> <string-like-value> (* required; applies when lostUpdateType = COLUMN; type: REGION COLUMN *)
  | "addRowIfEmpty" ":" <ws> <boolean> (* required; applies when allowedOperations = i; type: YES NO *)
  | "enabled" ":" <ws> <boolean> (* required; applies when type supports EDITABLE; type: YES NO *)
  | "allowedOperations" ":" <ws> <array-of-string-like-value> (* applies when enabled = Y; type: CHECKBOXES *)
  | "allowedRowOperationsColumn" ":" <ws> <string-like-value> (* applies when allowedOperations in (u, d); type: REGION COLUMN *)
  | "lostUpdateType" ":" <ws> ( "rowValues" | "rowVersionColumn" ) (* required; applies when enabled = Y; type: SELECT LIST *)
  | "rowVersionColumn" ":" <ws> <string-like-value> (* required; applies when lostUpdateType = COLUMN; type: REGION COLUMN *)
<region-link> ::= <indent> "link" <ws> "{" <line-end> { <region-link-property-line> } <indent> "}" <line-end>
<region-link-property-line> ::= <indent> <region-link-property> <line-end>
<region-link-property> ::= "linkColumn" ":" <ws> ( "singleRowView" | "customTarget" | "exclude" ) (* required; type: SELECT LIST *)
  | "uniquelyIdentifyRowsBy" ":" <ws> ( "rowid" | "uniqueColumn" ) (* required; applies when linkColumn = Y; type: SELECT LIST *)
  | "uniqueColumn" ":" <ws> <string-like-value> (* required; applies when uniquelyIdentifyRowsBy = COLUMN; type: COLUMN *)
  | "target" ":" <ws> <value> (* required; applies when linkColumn = C; type: LINK *)
  | "linkIcon" ":" <ws> <multiline-string> (* applies when linkColumn in (Y, C); type: TEXT EDITOR *)
  | "linkAttributes" ":" <ws> <string-like-value> (* applies when linkColumn in (Y, C); type: TEXT *)
  | "authorizationScheme" ":" <ws> <reference> (* applies when linkColumn in (Y, C); type: COMPONENT *)
  | "conditionType" ":" <ws> <string-like-value> (* applies when linkColumn in (Y, C); type: SELECT LIST; large enum list omitted *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when conditionType in (EXISTS, NOT_EXISTS); type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when conditionType = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION BOOLEAN *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION BOOLEAN *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION BOOLEAN *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when conditionType = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY BOOLEAN *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY BOOLEAN *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "preference" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "page" ":" <ws> <number> (* required; applies when conditionType in (CURRENT_PAGE_EQUALS_CONDITION, CURRENT_PAGE_NOT_EQUAL_CONDITION); type: PAGE *)
  | "pages" ":" <ws> <array-of-number> (* required; applies when conditionType in (CURRENT_PAGE_IN_CONDITION, CURRENT_PAGE_NOT_IN_CONDITION); type: PAGE *)
  | "text" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "value" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "list" ":" <ws> <array-of-string-like-value> (* required; applies when conditionType in (VALUE_OF_ITEM_IN_CONDITION_IN_COLON_DELIMITED_LIST, VALUE_OF_ITEM_IN_CONDITION_NOT_IN_COLON_DELIMITED_LIST); type: TEXT *)
  | "item" ":" <ws> <string-like-value> (* required; type: ITEM *)
  | "value" ":" <ws> <string-like-value> (* required; applies when conditionType in (DISPLAY_COND_IN_COND_TEXT, DISPLAY_COND_NOT_IN_COND_TEXT, DISPLAY_COND_EQUAL_COND_TEXT, DISP_COND_NOT_EQUAL_COND_TEXT); type: TEXT *)
<region-map> ::= <indent> "map" <ws> "{" <line-end> { <region-map-property-line> } <indent> "}" <line-end>
<region-map-property-line> ::= <indent> <region-map-property> <line-end>
<region-map-property> ::= "background" ":" <ws> ( "default" | "builtIn" | "sharedComponent" ) (* required; type: SELECT LIST *)
  | "standard" ":" <ws> ( "openstreetmapPositron" | "openstreetmapDark" | "openstreetmapBright" | "oracleWorldMap" | "oracleBiWorldMap" ) (* required; applies when background = CUSTOM; type: SELECT LIST *)
  | "darkMode" ":" <ws> ( "openstreetmapDark" | "openstreetmapPositron" | "openstreetmapBright" | "oracleWorldMap" | "oracleBiWorldMap" ) (* applies when background = CUSTOM; type: SELECT LIST *)
  | "standard" ":" <ws> <string-like-value> (* required; applies when background = SHARED; type: SELECT LIST *)
  | "darkMode" ":" <ws> <string-like-value> (* applies when background = SHARED; type: SELECT LIST *)
  | "height" ":" <ws> <number> (* required; type: NUMBER *)
<region-output> ::= <indent> "output" <ws> "{" <line-end> { <region-output-property-line> } <indent> "}" <line-end>
<region-output-property-line> ::= <indent> <region-output-property> <line-end>
<region-output-property> ::= "layout" ":" <ws> <reference> (* type: COMPONENT *)
  | "linkText" ":" <ws> <string-like-value> (* type: TEXT *)
  | "linkText" ":" <ws> <string-like-value> (* type: TEXT *)
  | "format" ":" <ws> ( "pdf" | "word" | "excel" | "html" | "xml" ) (* type: SELECT LIST *)
  | "format" ":" <ws> ( "pdf" | "word" | "excel" | "html" | "xml" ) (* type: SELECT LIST *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; type: SELECT LIST *)
  | "formatItem" ":" <ws> <string-like-value> (* required; applies when format is not set; type: ITEM *)
  | "formatItem" ":" <ws> <string-like-value> (* required; applies when format is not set; type: ITEM *)
  | "layout" ":" <ws> <reference> (* type: COMPONENT *)
  | "layout" ":" <ws> <reference> (* type: COMPONENT *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; type: SELECT LIST *)
  | "viewFileAs" ":" <ws> ( "attachment" | "inline" ) (* required; type: SELECT LIST *)
  | "fileName" ":" <ws> <string-like-value> (* type: TEXT *)
  | "fileName" ":" <ws> <string-like-value> (* type: TEXT *)
<region-page> ::= <indent> "page" <ws> "{" <line-end> { <region-page-property-line> } <indent> "}" <line-end>
<region-page-property-line> ::= <indent> <region-page-property> <line-end>
<region-page-property> ::= "size" ":" <ws> ( "letter" | "legal" | "tabloid" | "a4" | "a3" | "custom" ) (* required; type: SELECT LIST *)
  | "orientation" ":" <ws> ( "portrait" | "landscape" ) (* required; type: SELECT LIST *)
  | "size" ":" <ws> ( "letter" | "legal" | "tabloid" | "a4" | "a3" | "custom" ) (* required; type: SELECT LIST *)
  | "units" ":" <ws> ( "inches" | "millimeters" | "centimeters" | "points" ) (* required; type: SELECT LIST *)
  | "orientation" ":" <ws> ( "portrait" | "landscape" ) (* required; type: SELECT LIST *)
  | "width" ":" <ws> <number> (* required; type: NUMBER *)
  | "height" ":" <ws> <number> (* required; type: NUMBER *)
  | "units" ":" <ws> ( "inches" | "millimeters" | "centimeters" | "points" ) (* required; type: SELECT LIST *)
  | "borderWidth" ":" <ws> <number> (* type: NUMBER *)
  | "width" ":" <ws> <number> (* required; type: NUMBER *)
  | "borderColor" ":" <ws> <string-like-value> (* type: COLOR *)
  | "height" ":" <ws> <number> (* required; type: NUMBER *)
  | "borderWidth" ":" <ws> <number> (* type: NUMBER *)
  | "size" ":" <ws> ( "letter" | "legal" | "tabloid" | "a4" | "a3" | "custom" ) (* required; type: SELECT LIST *)
  | "size" ":" <ws> ( "letter" | "legal" | "tabloid" | "a4" | "a3" | "custom" ) (* required; type: SELECT LIST *)
  | "borderColor" ":" <ws> <string-like-value> (* type: COLOR *)
  | "orientation" ":" <ws> ( "portrait" | "landscape" ) (* required; type: SELECT LIST *)
  | "orientation" ":" <ws> ( "portrait" | "landscape" ) (* required; type: SELECT LIST *)
  | "units" ":" <ws> ( "inches" | "millimeters" | "centimeters" | "points" ) (* required; type: SELECT LIST *)
  | "units" ":" <ws> ( "inches" | "millimeters" | "centimeters" | "points" ) (* required; type: SELECT LIST *)
  | "width" ":" <ws> <number> (* required; type: NUMBER *)
  | "width" ":" <ws> <number> (* required; type: NUMBER *)
  | "height" ":" <ws> <number> (* required; type: NUMBER *)
  | "height" ":" <ws> <number> (* required; type: NUMBER *)
  | "borderWidth" ":" <ws> <number> (* type: NUMBER *)
  | "borderWidth" ":" <ws> <number> (* type: NUMBER *)
  | "borderColor" ":" <ws> <string-like-value> (* type: COLOR *)
  | "borderColor" ":" <ws> <string-like-value> (* type: COLOR *)
<region-report-layout> ::= <indent> "reportLayout" <ws> "{" <line-end> { <region-report-layout-property-line> } <indent> "}" <line-end>
<region-report-layout-property-line> ::= <indent> <region-report-layout-property> <line-end>
<region-report-layout-property> ::= "numberOfRowsType" ":" <ws> ( "staticValue" | "itemValue" ) (* required; type: SELECT LIST *)
  | "numberOfRowsType" ":" <ws> ( "staticValue" | "itemValue" ) (* required; type: SELECT LIST *)
  | "numberOfRows" ":" <ws> <number> (* required; applies when numberOfRowsType = STATIC; type: INTEGER *)
  | "numberOfRows" ":" <ws> <number> (* required; applies when numberOfRowsType = STATIC; type: INTEGER *)
  | "item" ":" <ws> <string-like-value> (* required; applies when numberOfRowsType = ITEM; type: ITEM *)
  | "item" ":" <ws> <string-like-value> (* required; applies when numberOfRowsType = ITEM; type: ITEM *)
  | "numberOfRowsType" ":" <ws> ( "staticValue" | "itemValue" ) (* required; applies when type supports FETCHED_ROWS; type: SELECT LIST *)
  | "numberOfRows" ":" <ws> <number> (* required; applies when numberOfRowsType = STATIC; type: INTEGER *)
  | "item" ":" <ws> <string-like-value> (* required; applies when numberOfRowsType = ITEM; type: ITEM *)
<region-title> ::= <indent> "title" <ws> "{" <line-end> { <region-title-property-line> } <indent> "}" <line-end>
<region-title-property-line> ::= <indent> <region-title-property> <line-end>
<region-title-property> ::= "title" ":" <ws> <string-like-value> (* type: TEXT *)
  | "advancedFormatting" ":" <ws> <boolean> (* required; type: YES NO *)
  | "column" ":" <ws> <string-like-value> (* applies when advancedFormatting = N; type: COLUMN *)
  | "htmlExpression" ":" <ws> <multiline-string> (* required; applies when advancedFormatting = Y; type: HTML *)
  | "cssClasses" ":" <ws> <array-of-string-like-value> (* applies when advancedFormatting = N; type: COMBOBOX *)
<region-chart-appearance> ::= <indent> "chartAppearance" <ws> "{" <line-end> { <region-chart-appearance-property-line> } <indent> "}" <line-end>
<region-chart-appearance-property-line> ::= <indent> <region-chart-appearance-property> <line-end>
<region-chart-appearance-property> ::= "orientation" ":" <ws> ( "vertical" | "horizontal" ) (* required; applies when type in (area, bar, combo, funnel, line, lineWithArea, boxPlot, range); type: SELECT LIST *)
  | "stack" ":" <ws> <boolean> (* required; applies when type in (area, bar, line, lineWithArea, combo, polar, radar); type: YES NO *)
  | "stackLabel" ":" <ws> <boolean> (* required; applies when type = bar and stack = on; type: YES NO *)
  | "fontFamily" ":" <ws> ( "arial" | "arialBlack" | "bookman" | "comicSansMs" | "courier" | "courierNew" | "garamond" | "georgia" | "helvetica" | "impact" | "palatino" | "times" | "timesNewRoman" | "trebuchetMs" | "verdana" ) (* applies when stackLabel = on; type: SELECT LIST *)
  | "fontStyle" ":" <ws> ( "normal" | "italic" | "oblique" ) (* applies when stackLabel = on; type: SELECT LIST *)
  | "fontSize" ":" <ws> ( "8" | "10" | "12" | "14" | "16" | "18" | "20" | "22" ) (* applies when stackLabel = on; type: SELECT LIST *)
  | "fontColor" ":" <ws> <string-like-value> (* applies when stackLabel = on; type: COLOR *)
<region-card> ::= <indent> "card" <ws> "{" <line-end> { <region-card-property-line> } <indent> "}" <line-end>
