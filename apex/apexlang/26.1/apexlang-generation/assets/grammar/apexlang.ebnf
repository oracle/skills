<parameter-o-group-block> ::= <parameter-o-label>
  | <parameter-o-parameter>
  | <parameter-o-validation>
  | <parameter-o-default>
  | <parameter-o-display-format-masks>
  | <parameter-o-comments>
<parameter-o-label> ::= <indent> "label" <ws> "{" <line-end> { <parameter-o-label-property-line> } <indent> "}" <line-end>
<parameter-o-label-property-line> ::= <indent> <parameter-o-label-property> <line-end>
<parameter-o-label-property> ::= "label" ":" <ws> <string-like-value> (* required; type: TEXT *)
<parameter-o-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <parameter-o-parameter-property-line> } <indent> "}" <line-end>
<parameter-o-parameter-property-line> ::= <indent> <parameter-o-parameter-property> <line-end>
<parameter-o-parameter-property> ::= "dataType" ":" <ws> ( "varchar2" | "timestamp" | "timestampWithLocalTimeZone" | "timestampWithTimeZone" | "number" | "boolean" | "clob" ) (* required; type: SELECT LIST *)
  | "direction" ":" <ws> ( "in" | "out" | "inOut" ) (* required; type: SELECT LIST *)
<parameter-o-validation> ::= <indent> "validation" <ws> "{" <line-end> { <parameter-o-validation-property-line> } <indent> "}" <line-end>
<parameter-o-validation-property-line> ::= <indent> <parameter-o-validation-property> <line-end>
<parameter-o-validation-property> ::= "required" ":" <ws> <boolean> (* required; applies when direction in (IN, IN_OUT); type: YES NO *)
<parameter-o-default> ::= <indent> "default" <ws> "{" <line-end> { <parameter-o-default-property-line> } <indent> "}" <line-end>
<parameter-o-default-property-line> ::= <indent> <parameter-o-default-property> <line-end>
<parameter-o-default-property> ::= "value" ":" <ws> <multiline-string> (* applies when direction in (IN, IN_OUT); type: TEXT EDITOR *)
<parameter-o-display-format-masks> ::= <indent> "displayFormatMasks" <ws> "{" <line-end> { <parameter-o-display-format-masks-property-line> } <indent> "}" <line-end>
<parameter-o-display-format-masks-property-line> ::= <indent> <parameter-o-display-format-masks-property> <line-end>
<parameter-o-display-format-masks-property> ::= "sessionStateFormatMask" ":" <ws> <string-like-value> (* applies when dataType in (NUMBER, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN; type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN; type: TEXT *)
<parameter-o-comments> ::= <indent> "comments" <ws> "{" <line-end> { <parameter-o-comments-property-line> } <indent> "}" <line-end>
<parameter-o-comments-property-line> ::= <indent> <parameter-o-comments-property> <line-end>
<parameter-o-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* version *)
(* direct properties use default group: identification *)
<version> ::= "version" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <version-body-line> } <indent> ")" <line-end>
<version-body-line> ::= <version-direct-property-line>
  | <version-group-block>
  | <version-child-component>
<version-direct-property-line> ::= <indent> <version-direct-property> <line-end>
<version-direct-property> ::= "workflowVersion" ":" <ws> <string-like-value> (* required; type: TEXT *)
<version-group-block> ::= <version-settings>
  | <version-additional-data>
  | <version-column-mapping>
  | <version-advanced>
  | <version-comments>
<version-settings> ::= <indent> "settings" <ws> "{" <line-end> { <version-settings-property-line> } <indent> "}" <line-end>
<version-settings-property-line> ::= <indent> <version-settings-property> <line-end>
<version-settings-property> ::= "state" ":" <ws> ( "inDevelopment" | "active" | "inactive" ) (* required; type: SWITCH BUTTON *)
<version-additional-data> ::= <indent> "additionalData" <ws> "{" <line-end> { <version-additional-data-property-line> } <indent> "}" <line-end>
<version-additional-data-property-line> ::= <indent> <version-additional-data-property> <line-end>
<version-additional-data-property> ::= "type" ":" <ws> ( "tableView" | "sqlQuery" ) (* type: SELECT LIST *)
  | "tableOwner" ":" <ws> <string-like-value> (* applies when type = TABLE; type: OWNER *)
  | "tableName" ":" <ws> <string-like-value> (* required; applies when type = TABLE; type: TABLE *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL; type: SQL *)
<version-column-mapping> ::= <indent> "columnMapping" <ws> "{" <line-end> { <version-column-mapping-property-line> } <indent> "}" <line-end>
<version-column-mapping-property-line> ::= <indent> <version-column-mapping-property> <line-end>
<version-column-mapping-property> ::= "primaryKeyColumn" ":" <ws> <string-like-value> (* required; applies when type = TABLE; type: COLUMN *)
<version-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <version-advanced-property-line> } <indent> "}" <line-end>
<version-advanced-property-line> ::= <indent> <version-advanced-property> <line-end>
<version-advanced-property> ::= "debugLevel" ":" <ws> ( "info" | "warning" | "error" | "trace" ) (* type: SELECT LIST *)
  | "diagram" ":" <ws> <string-like-value> (* type: HIDDEN *)
<version-comments> ::= <indent> "comments" <ws> "{" <line-end> { <version-comments-property-line> } <indent> "}" <line-end>
<version-comments-property-line> ::= <indent> <version-comments-property> <line-end>
<version-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<version-child-component> ::= <activity>
  | <participant-b>
  | <variable>

(* activity *)
(* direct properties use default group: identification *)
<activity> ::= "activity" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <activity-body-line> } <indent> ")" <line-end>
<activity-body-line> ::= <activity-direct-property-line>
  | <activity-group-block>
  | <activity-child-component>
<activity-direct-property-line> ::= <indent> <activity-direct-property> <line-end>
<activity-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<activity-group-block> ::= <activity-gen-ai>
  | <activity-source>
  | <activity-additional-data>
  | <activity-deadline>
  | <activity-layout>
  | <activity-parallel-flow>
  | <activity-advanced>
  | <activity-comments>
<activity-gen-ai> ::= <indent> "genAI" <ws> "{" <line-end> { <activity-gen-ai-property-line> } <indent> "}" <line-end>
<activity-gen-ai-property-line> ::= <indent> <activity-gen-ai-property> <line-end>
<activity-gen-ai-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when type supports AI_ENABLED; type: YES NO *)
  | "agent" ":" <ws> <reference> (* applies when type supports AI_ENABLED_ALWAYS, AI_ENABLED and enabled = Y or not set; type: COMPONENT *)
  | "service" ":" <ws> <reference> (* applies when agent is not set; type: COMPONENT *)
  | "systemPrompt" ":" <ws> <multiline-string> (* applies when type supports AI_SYSTEM_PROMPT and agent is not set; type: TEXT EDITOR *)
<activity-source> ::= <indent> "source" <ws> "{" <line-end> { <activity-source-property-line> } <indent> "}" <line-end>
<activity-source-property-line> ::= <indent> <activity-source-property> <line-end>
<activity-source-property> ::= "location" ":" <ws> ( "localDatabase" | "restEnabledSql" ) (* required; applies when type = NATIVE_PLSQL; type: SELECT LIST *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when location = LOCAL; type: CODE LANGUAGE *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL *)
  | "javaScriptCode" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT *)
  | "remoteServer" ":" <ws> <reference> (* required; applies when location = REMOTE; type: COMPONENT *)
  | "plsqlCode" ":" <ws> <multiline-string> (* required; applies when location = REMOTE; type: PLSQL *)
<activity-additional-data> ::= <indent> "additionalData" <ws> "{" <line-end> { <activity-additional-data-property-line> } <indent> "}" <line-end>
<activity-additional-data-property-line> ::= <indent> <activity-additional-data-property> <line-end>
<activity-additional-data-property> ::= "sqlQuery" ":" <ws> <multiline-string> (* type: SQL *)
<activity-deadline> ::= <indent> "deadline" <ws> "{" <line-end> { <activity-deadline-property-line> } <indent> "}" <line-end>
<activity-deadline-property-line> ::= <indent> <activity-deadline-property> <line-end>
<activity-deadline-property> ::= "dueOnType" ":" <ws> ( "interval" | "sqlQuery" | "expression" | "functionBody" | "schedulerExpression" ) (* applies when type != NATIVE_WORKFLOW_WAIT; type: SELECT LIST *)
  | "interval" ":" <ws> <string-like-value> (* required; applies when dueOnType = INTERVAL; type: TEXT *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when dueOnType = SQL_QUERY; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when dueOnType = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when dueOnType = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
  | "schedulerExpression" ":" <ws> <multiline-string> (* required; applies when dueOnType = SCHEDULER_EXPRESSION; type: TEXT EDITOR *)
<activity-layout> ::= <indent> "layout" <ws> "{" <line-end> { <activity-layout-property-line> } <indent> "}" <line-end>
<activity-layout-property-line> ::= <indent> <activity-layout-property> <line-end>
<activity-layout-property> ::= "sequence" ":" <ws> <number> (* required; type: NUMBER *)
<activity-parallel-flow> ::= <indent> "parallelFlow" <ws> "{" <line-end> { <activity-parallel-flow-property-line> } <indent> "}" <line-end>
<activity-parallel-flow-property-line> ::= <indent> <activity-parallel-flow-property> <line-end>
<activity-parallel-flow-property> ::= "branch" ":" <ws> <reference> (* applies when type not in (NATIVE_PARALLEL_WF, NATIVE_WORKFLOW_START, NATIVE_WORKFLOW_END); type: COMPONENT *)
<activity-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <activity-advanced-property-line> } <indent> "}" <line-end>
<activity-advanced-property-line> ::= <indent> <activity-advanced-property> <line-end>
<activity-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "label" ":" <ws> <string-like-value> (* type: TEXT *)
  | "diagram" ":" <ws> <string-like-value> (* type: HIDDEN *)
<activity-comments> ::= <indent> "comments" <ws> "{" <line-end> { <activity-comments-property-line> } <indent> "}" <line-end>
<activity-comments-property-line> ::= <indent> <activity-comments-property> <line-end>
<activity-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
<activity-child-component> ::= <activity-variable>
  | <branch-b>
  | <connection-a>
  | <connection-b>
  | <parameter-q>
  | <parameter-r>
  | <parameter-s>
  | <parameter-t>

(* activityVariable *)
(* direct properties use default group: identification *)
<activity-variable> ::= "activityVariable" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <activity-variable-body-line> } <indent> ")" <line-end>
<activity-variable-body-line> ::= <activity-variable-direct-property-line>
  | <activity-variable-group-block>
<activity-variable-direct-property-line> ::= <indent> <activity-variable-direct-property> <line-end>
<activity-variable-direct-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
<activity-variable-group-block> ::= <activity-variable-label>
  | <activity-variable-parameter>
  | <activity-variable-value>
  | <activity-variable-display-format-masks>
  | <activity-variable-comments>
<activity-variable-label> ::= <indent> "label" <ws> "{" <line-end> { <activity-variable-label-property-line> } <indent> "}" <line-end>
<activity-variable-label-property-line> ::= <indent> <activity-variable-label-property> <line-end>
<activity-variable-label-property> ::= "label" ":" <ws> <string-like-value> (* required; type: TEXT *)
<activity-variable-parameter> ::= <indent> "parameter" <ws> "{" <line-end> { <activity-variable-parameter-property-line> } <indent> "}" <line-end>
<activity-variable-parameter-property-line> ::= <indent> <activity-variable-parameter-property> <line-end>
<activity-variable-parameter-property> ::= "dataType" ":" <ws> ( "varchar2" | "timestamp" | "timestampWithLocalTimeZone" | "timestampWithTimeZone" | "number" | "boolean" | "clob" ) (* required; type: SELECT LIST *)
<activity-variable-value> ::= <indent> "value" <ws> "{" <line-end> { <activity-variable-value-property-line> } <indent> "}" <line-end>
<activity-variable-value-property-line> ::= <indent> <activity-variable-value-property> <line-end>
<activity-variable-value-property> ::= "type" ":" <ws> ( "staticValue" | "item" | "sqlQuery" | "expression" | "functionBody" | "null" ) (* required; type: SELECT LIST *)
  | "staticValue" ":" <ws> <multiline-string> (* required; applies when type = STATIC and dataType != BOOLEAN; type: TEXT EDITOR *)
  | "staticValue" ":" <ws> ( "true" | "false" ) (* required; applies when type = STATIC and dataType = BOOLEAN; type: SELECT LIST *)
  | "item" ":" <ws> <string-like-value> (* required; applies when type = ITEM; type: ITEM *)
  | "sqlQuery" ":" <ws> <multiline-string> (* required; applies when type = SQL_QUERY; type: SQL *)
  | "language" ":" <ws> ( "sql" | "plsql" | "javaScript-mle" ) (* required; applies when type = EXPRESSION; type: CODE LANGUAGE *)
  | "sqlExpression" ":" <ws> <multiline-string> (* required; applies when language = SQL; type: SQL EXPRESSION CUSTOM *)
  | "plsqlExpression" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL EXPRESSION CUSTOM *)
  | "javaScriptExpression" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT EXPRESSION CUSTOM *)
  | "language" ":" <ws> ( "plsql" | "javaScript-mle" ) (* required; applies when type = FUNCTION_BODY; type: CODE LANGUAGE *)
  | "plsqlFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = PLSQL; type: PLSQL FUNCTION BODY CUSTOM *)
  | "javaScriptFunctionBody" ":" <ws> <multiline-string> (* required; applies when language = JAVASCRIPT; type: MLE JAVASCRIPT FUNCTION BODY CUSTOM *)
<activity-variable-display-format-masks> ::= <indent> "displayFormatMasks" <ws> "{" <line-end> { <activity-variable-display-format-masks-property-line> } <indent> "}" <line-end>
<activity-variable-display-format-masks-property-line> ::= <indent> <activity-variable-display-format-masks-property> <line-end>
<activity-variable-display-format-masks-property> ::= "sessionStateFormatMask" ":" <ws> <string-like-value> (* applies when dataType in (NUMBER, TIMESTAMP, TIMESTAMP_TZ, TIMESTAMP_LTZ); type: COMBOBOX *)
  | "trueValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN and type not in (STATIC); type: TEXT *)
  | "falseValue" ":" <ws> <string-like-value> (* applies when dataType = BOOLEAN and type not in (STATIC); type: TEXT *)
<activity-variable-comments> ::= <indent> "comments" <ws> "{" <line-end> { <activity-variable-comments-property-line> } <indent> "}" <line-end>
<activity-variable-comments-property-line> ::= <indent> <activity-variable-comments-property> <line-end>
<activity-variable-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* branch *)
(* direct properties use default group: identification *)
