  | <parameter-i>
  | <parameter-j>
  | <parameter-n>
  | <parameter-p>
  | <region>
  | <action-d>
  | <trigger-action-d>
  | <action-e>
  | <menu-a>
  | <trigger-action-a>
  | <trigger-action-b>
  | <axis>
  | <column-b>
  | <action-f>
  | <menu-b>
  | <trigger-action-g>
  | <trigger-action-f>
  | <column-c>
  | <column-d>
  | <column-e>
  | <column-f>
  | <column-g>
  | <column-group-a>
  | <column-group-b>
