  | "jsonDualityView" ":" <ws> <reference> (* required; applies when type = DUALITY_VIEW; type: COMPONENT *)
  | "jsonSource" ":" <ws> <reference> (* required; applies when type = JSON_SOURCE; type: COMPONENT *)
  | "restDataSource" ":" <ws> <reference> (* required; applies when type = WEB_SOURCE; type: COMPONENT *)
