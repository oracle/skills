  | <lov-group-block>
  | <lov-child-component>
<lov-direct-property-line> ::= <indent> <lov-direct-property> <line-end>
<lov-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<lov-group-block> ::= <lov-source>
  | <lov-data-profile>
  | <lov-rest-synchronization>
  | <lov-external-filter-and-order-by>
  | <lov-local-post-processing>
  | <lov-remote-cache>
  | <lov-column-mapping>
  | <lov-advanced>
  | <lov-subscription>
  | <lov-comments>
