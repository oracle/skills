<branch-b-comments-property-line> ::= <indent> <branch-b-comments-property> <line-end>
<branch-b-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

(* connection *)
(* direct properties use default group: identification *)
<connection-a> ::= "connection" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <connection-a-body-line> } <indent> ")" <line-end>
