(* triggerAction *)
(* direct properties use default group: identification *)
<trigger-action-a> ::= "triggerAction" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <trigger-action-a-body-line> } <indent> ")" <line-end>
<trigger-action-a-body-line> ::= <trigger-action-a-direct-property-line>
  | <trigger-action-a-group-block>
<trigger-action-a-direct-property-line> ::= <indent> <trigger-action-a-direct-property> <line-end>
<trigger-action-a-direct-property> ::= "name" ":" <ws> <string-like-value> (* type: TEXT *)
  | "action" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<trigger-action-a-group-block> ::= <trigger-action-a-gen-ai>
  | <trigger-action-a-affected-elements>
  | <trigger-action-a-execution>
  | <trigger-action-a-client-side-condition>
  | <trigger-action-a-server-side-condition>
  | <trigger-action-a-security>
  | <trigger-action-a-config>
  | <trigger-action-a-advanced>
  | <trigger-action-a-comments>
<trigger-action-a-gen-ai> ::= <indent> "genAI" <ws> "{" <line-end> { <trigger-action-a-gen-ai-property-line> } <indent> "}" <line-end>
<trigger-action-a-gen-ai-property-line> ::= <indent> <trigger-action-a-gen-ai-property> <line-end>
<trigger-action-a-gen-ai-property> ::= "enabled" ":" <ws> <boolean> (* required; applies when action supports AI_ENABLED; type: YES NO *)
  | "agent" ":" <ws> <reference> (* applies when action supports AI_ENABLED_ALWAYS, AI_ENABLED and enabled = Y or not set; type: COMPONENT *)
  | "service" ":" <ws> <reference> (* applies when agent is not set; type: COMPONENT *)
