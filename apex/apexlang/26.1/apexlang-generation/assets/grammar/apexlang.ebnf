  | "type" ":" <ws> ( "xslGeneric" | "rtf" | "xsl" | "docx" | "xlsx" | "pptx" | "html" | "markdown" | "csv" | "txt" | "odt" | "ods" | "odp" ) (* required; type: SELECT LIST *)
