<style-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
<style-group-block> ::= <style-css>
  | <style-theme-roller-attributes>
  | <style-advanced>
  | <style-subscription>
  | <style-comments>
<style-css> ::= <indent> "css" <ws> "{" <line-end> { <style-css-property-line> } <indent> "}" <line-end>
<style-css-property-line> ::= <indent> <style-css-property> <line-end>
<style-css-property> ::= "fileUrls" ":" <ws> <array-of-string-like-value> (* type: FILE URLS CSS *)
  | "cssClasses" ":" <ws> <string-like-value> (* type: TEXT *)
<style-theme-roller-attributes> ::= <indent> "themeRollerAttributes" <ws> "{" <line-end> { <style-theme-roller-attributes-property-line> } <indent> "}" <line-end>
<style-theme-roller-attributes-property-line> ::= <indent> <style-theme-roller-attributes-property> <line-end>
<style-theme-roller-attributes-property> ::= "readOnly" ":" <ws> <boolean> (* required; type: YES NO *)
  | "inputParameterFileUrls" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)
  | "outputCssFileUrl" ":" <ws> <string-like-value> (* type: TEXT *)
  | "jsonConfig" ":" <ws> <multiline-string> (* type: JSON *)
<style-advanced> ::= <indent> "advanced" <ws> "{" <line-end> { <style-advanced-property-line> } <indent> "}" <line-end>
<style-advanced-property-line> ::= <indent> <style-advanced-property> <line-end>
<style-advanced-property> ::= "staticId" ":" <ws> <string-like-value> (* required; type: STATIC ID *)
  | "endUserCanPick" ":" <ws> <boolean> (* required; type: YES NO *)
  | "accessibilityTested" ":" <ws> <boolean> (* required; type: YES NO *)
<style-subscription> ::= <indent> "subscription" <ws> "{" <line-end> { <style-subscription-property-line> } <indent> "}" <line-end>
<style-subscription-property-line> ::= <indent> <style-subscription-property> <line-end>
<style-subscription-property> ::= "master" ":" <ws> <string-like-value> (* applies when property supports IS_SUBSCRIBED; type: SUBSCRIPTION *)
  | "master" ":" <ws> <string-like-value> (* applies when property NOT_FEATURES IS_SUBSCRIBED; type: SUBSCRIPTION *)
<style-comments> ::= <indent> "comments" <ws> "{" <line-end> { <style-comments-property-line> } <indent> "}" <line-end>
<style-comments-property-line> ::= <indent> <style-comments-property> <line-end>
<style-comments-property> ::= "comments" ":" <ws> <multiline-string> (* type: TEXT EDITOR *)

