(* pageItem *)
(* direct properties use default group: identification *)
<page-item> ::= "pageItem" [ <required-ws> <component-id> ] <ws> "(" <line-end> { <page-item-body-line> } <indent> ")" <line-end>
<page-item-body-line> ::= <page-item-direct-property-line>
  | <page-item-group-block>
<page-item-direct-property-line> ::= <indent> <page-item-direct-property> <line-end>
<page-item-direct-property> ::= "name" ":" <ws> <string-like-value> (* required; type: TEXT *)
  | "type" ":" <ws> <string-like-value> (* required; type: SUPPORTED UI *)
<page-item-group-block> ::= <page-item-label>
  | <page-item-lov>
  | <page-item-cascading-lov>
  | <page-item-gen-ai>
  | <page-item-multiple-values>
